---

import BaseLayout from "../../layouts/BaseLayout.astro";

import AboutHero from "../../components/about/AboutHero.astro";
import Gallery from "../../components/about/Gallery.astro";

import es from "../../i18n/es";

const t = es;

---


<BaseLayout title="About" content={t}>

  <div class="about-page">

    <AboutHero content={t.about.hero} />

    <Gallery />

  </div>

</BaseLayout>


<style>

.about-page {

  display: grid;

  grid-template-columns: minmax(0, 1fr) minmax(360px, 42%);

  gap: var(--space-2xl);

  align-items: start;

  padding-top: var(--space-2xl);

  max-width: 1100px;

}


.about-page .gallery {

  position: sticky;

  top: var(--space-xl);

  align-self: start;

}


@media (max-width: 768px) {

  .about-page {

    grid-template-columns: 1fr;

    gap: var(--space-xl);

  }


  .about-page .gallery {

    position: static;

  }

}

</style>