---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import es from "../../../i18n/es";
import { calculateReadingTime } from "../../../utils/readingTime";
import Hero from "../../../components/case-studies/shared/CaseStudyHero.astro";
import Challenge from "../../../components/case-studies/credential-platform/Challenge.astro";
import MyContribution from "../../../components/case-studies/shared/MyContribution.astro";
import Intro from "../../../components/case-studies/credential-platform/Intro.astro";
import MTArchitecture from "../../../components/case-studies/credential-platform/MTArchitecture.astro";
import RoleHierarchy from "../../../components/case-studies/credential-platform/RoleHierarchy.astro";
import Lifecycle from "../../../components/case-studies/credential-platform/Lifecycle.astro";
import IA from "../../../components/case-studies/credential-platform/IA.astro";
import Report from "../../../components/case-studies/credential-platform/Report.astro";
import Constraints from "../../../components/case-studies/shared/Constraints.astro";
import Quote from "../../../components/case-studies/credential-platform/Quote.astro";
import Impact from "../../../components/case-studies/shared/Impact.astro";

const t = es;

const readingTime = calculateReadingTime(
  t.credentialPlatform
);
---

<BaseLayout
  title="Credential Platform"
  content={t}
>

  <Hero
    content={t.b2bCommercePlatform.hero}
    readingTime={readingTime}
    nda
  />

  <Challenge
    eyebrow={t.credentialPlatform.challenge.eyebrow}
    title={t.credentialPlatform.challenge.title}
    business={t.credentialPlatform.challenge.business}
    product={t.credentialPlatform.challenge.product}
    role={t.credentialPlatform.challenge.role}
  />

  <MyContribution
    eyebrow={t.credentialPlatform.contribution.eyebrow}
    title={t.credentialPlatform.contribution.title}
    items={t.credentialPlatform.contribution.items}
  />

  <Intro
    title={t.credentialPlatform.understandingSystem.title}
    description={t.credentialPlatform.understandingSystem.description}
  />

  <MTArchitecture
    title={t.credentialPlatform.multiTenantArchitecture.title}
  />

  <RoleHierarchy
    title={t.credentialPlatform.roleHierarchy.title}
    roles={t.credentialPlatform.roleHierarchy.roles}
    insight={t.credentialPlatform.roleHierarchy.insight}
  />

  <Lifecycle
    title={t.credentialPlatform.credentialLifecycle.title}
    image="/images/case-studies/credential-platform/credential-lifecycle.png"
    alt={t.credentialPlatform.credentialLifecycle.alt}
  />

  <IA
    title={t.credentialPlatform.informationArchitecture.title}
    description={t.credentialPlatform.informationArchitecture.description}
    principleTitle={t.credentialPlatform.informationArchitecture.principleTitle}
    principleHeadline={t.credentialPlatform.informationArchitecture.principleHeadline}
    principleDescription={t.credentialPlatform.informationArchitecture.principleDescription}
  />

  <Report
    title={t.credentialPlatform.reportingComplexity.title}
    columns={t.credentialPlatform.reportingComplexity.columns}
    rows={t.credentialPlatform.reportingComplexity.rows}
    insight={t.credentialPlatform.reportingComplexity.insight}
  />

  <Constraints
    title={t.credentialPlatform.constraints.title}
    items={t.credentialPlatform.constraints.items}
  />

  <Quote
    quote={t.credentialPlatform.quote}
  />

  <Impact
    title={t.credentialPlatform.impact.title}
    impact={t.credentialPlatform.impact.impact}
    highlights={t.credentialPlatform.impact.highlights}
    reflection={t.credentialPlatform.impact.reflection}
  />

</BaseLayout>