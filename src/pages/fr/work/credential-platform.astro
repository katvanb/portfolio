---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import fr from "../../../i18n/fr";
import Index from "../../../components/case-studies/shared/Index.astro";
import { calculateReadingTime } from "../../../utils/readingTime";
import Hero from "../../../components/case-studies/shared/CaseStudyHero.astro";
import Challenge from "../../../components/case-studies/credential-platform/Challenge.astro";
import RoleModel from "../../../components/case-studies/credential-platform/RoleModel.astro";
import KeyDecision from "../../../components/case-studies/credential-platform/KeyDecision.astro";
import SystemThinking from "../../../components/case-studies/credential-platform/SystemThinking.astro";
import StakeholderAlignment from "../../../components/case-studies/credential-platform/StakeholderAlignment.astro";
import Tradeoffs from "../../../components/case-studies/credential-platform/Tradeoffs.astro";
import Impact from "../../../components/case-studies/shared/Impact.astro";
import Reflections from "../../../components/case-studies/shared/Reflections.astro";

const t = fr;

const c = t.credentialPlatform;

const readingTime = calculateReadingTime(c, t.caseStudy.readingTimeSuffix);
---

<BaseLayout
  title="Credential Platform"
  content={t}
  lang="fr"
>

  <Index
    ariaLabel={t.caseStudy.sectionsAriaLabel}
    sections={[
      { id: "challenge", label: "Le défi" },
      { id: "impact", label: "Impact" },
      { id: "vision", label: "Décision clé 1" },
      { id: "shared-catalog", label: "Décision clé 2" },
      { id: "credit-distribution", label: "Décision clé 3" },
      { id: "systems", label: "Rôles et permissions" },
      { id: "leadership", label: "Parties prenantes" },
      { id: "tradeoffs", label: "Arbitrages" },
      { id: "reflections", label: "Contribution" },
    ]}
  />

  <div class="case-study">

    <Hero
      content={c.hero}
      readingTime={readingTime}
      labels={t.caseStudy}
      nda
    />

    <Challenge
      eyebrow={c.challenge.eyebrow}
      title={c.challenge.title}
      paragraphs={c.challenge.paragraphs}
      painsTitle={c.challenge.painsTitle}
      pains={c.challenge.pains}
      latentTitle={c.challenge.latentTitle}
      latent={c.challenge.latent}
      contextTitle={c.challenge.contextTitle}
      contextLead={c.challenge.contextLead}
      context={c.challenge.context}
      pivotLabel={c.challenge.pivotLabel}
      pivot={c.challenge.pivot}
      mandateLabel={c.challenge.mandateLabel}
      mandate={c.challenge.mandate}
    />

    <Impact
      eyebrow={c.impact.eyebrow}
      title={c.impact.title}
      limitationTitle={c.impact.limitationTitle}
      limitation={c.impact.limitation}
      columns={c.impact.columns}
      rows={c.impact.rows}
      tableNote={c.impact.tableNote}
      evolutionTitle={c.impact.evolutionTitle}
      evolution={c.impact.evolution}
      pendingTitle={c.impact.pendingTitle}
      pending={c.impact.pending}
      quoteLabel={c.impact.quoteLabel}
      quote={c.impact.quote}
    />

    <RoleModel
      eyebrow={c.vision.eyebrow}
      title={c.vision.title}
      paragraphs={c.vision.paragraphs}
      beforeTitle={c.vision.beforeTitle}
      beforeRoles={c.vision.beforeRoles}
      afterTitle={c.vision.afterTitle}
      afterRoles={c.vision.afterRoles}
      multiTitle={c.vision.multiTitle}
      multiIntro={c.vision.multiIntro}
      orgAdmin={c.vision.orgAdmin}
      subLabel={c.vision.subLabel}
      subRoles={c.vision.subRoles}
      decisionTitle={c.vision.decisionTitle}
      decisionText={c.vision.decisionText}
      futureTitle={c.vision.futureTitle}
      future={c.vision.future}
      screenshot={c.vision.screenshot}
    />

    <KeyDecision
      id="shared-catalog"
      eyebrow={c.sharedCatalog.eyebrow}
      title={c.sharedCatalog.title}
      questionLabel={c.sharedCatalog.questionLabel}
      question={c.sharedCatalog.question}
      rejectedLabel={c.sharedCatalog.rejectedLabel}
      rejected={c.sharedCatalog.rejected}
      decisionLabel={c.sharedCatalog.decisionLabel}
      decision={c.sharedCatalog.decision}
      whyTitle={c.sharedCatalog.whyTitle}
      why={c.sharedCatalog.why}
      uiTitle={c.sharedCatalog.uiTitle}
      ui={c.sharedCatalog.ui}
      typesTitle={c.sharedCatalog.typesTitle}
      types={c.sharedCatalog.types}
      screenshots={c.sharedCatalog.screenshots}
      screenshotsLayout="pairs"
    />

    <KeyDecision
      id="credit-distribution"
      eyebrow={c.creditDistribution.eyebrow}
      title={c.creditDistribution.title}
      questionLabel={c.creditDistribution.questionLabel}
      question={c.creditDistribution.question}
      rejectedLabel={c.creditDistribution.rejectedLabel}
      rejected={c.creditDistribution.rejected}
      decisionLabel={c.creditDistribution.decisionLabel}
      decision={c.creditDistribution.decision}
      whyTitle={c.creditDistribution.whyTitle}
      why={c.creditDistribution.why}
      uiTitle={c.creditDistribution.uiTitle}
      ui={c.creditDistribution.ui}
      align={c.creditDistribution.align}
      screenshots={c.creditDistribution.screenshots}
    />

    <SystemThinking
      eyebrow={c.systems.eyebrow}
      title={c.systems.title}
      paragraphs={c.systems.paragraphs}
      matrixTitle={c.systems.matrixTitle}
      matrixColumns={c.systems.matrixColumns}
      matrixRows={c.systems.matrixRows}
      matrixCaption={c.systems.matrixCaption}
      uxDecision={c.systems.uxDecision}
      statesTitle={c.systems.statesTitle}
      statesIntro={c.systems.statesIntro}
      states={c.systems.states}
      eventsTitle={c.systems.eventsTitle}
      events={c.systems.events}
      eventsNote={c.systems.eventsNote}
      docsTitle={c.systems.docsTitle}
      docs={c.systems.docs}
      docsClosing={c.systems.docsClosing}
      screenshots={c.systems.screenshots}
    />

    <StakeholderAlignment
      eyebrow={c.leadership.eyebrow}
      title={c.leadership.title}
      contextTitle={c.leadership.contextTitle}
      context={c.leadership.context}
      resistanceTitle={c.leadership.resistanceTitle}
      resistance={c.leadership.resistance}
      approachTitle={c.leadership.approachTitle}
      approach={c.leadership.approach}
      processTitle={c.leadership.processTitle}
      process={c.leadership.process}
      debtTitle={c.leadership.debtTitle}
      debt={c.leadership.debt}
      closing={c.leadership.closing}
    />

    <Tradeoffs
      eyebrow={c.tradeoffs.eyebrow}
      title={c.tradeoffs.title}
      intro={c.tradeoffs.intro}
      columns={c.tradeoffs.columns}
      rows={c.tradeoffs.rows}
      closing={c.tradeoffs.closing}
    />

    <Reflections
      eyebrow={c.reflections.eyebrow}
      title={c.reflections.title}
      contribution={c.reflections.contribution}
    />

  </div>

</BaseLayout>

<style>

  .case-study {
    width: 100%;
  }

  .case-study {
    --section-spacing: var(--gap-blocks);
  }

  @media (min-width: 1201px) {

    .case-study {
      padding-right: 180px;
    }

  }

</style>
