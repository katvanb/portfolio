---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import fr from "../../../i18n/fr";
import Index from "../../../components/case-studies/shared/Index.astro";
import { calculateReadingTime } from "../../../utils/readingTime";
import Hero from "../../../components/case-studies/shared/CaseStudyHero.astro";
import Asset from "../../../components/case-studies/shared/Asset.astro";
import Challenge from "../../../components/case-studies/credential-platform-v2/Challenge.astro";
import BusinessModel from "../../../components/case-studies/credential-platform-v2/BusinessModel.astro";
import Evolution from "../../../components/case-studies/credential-platform-v2/Evolution.astro";
import SelfService from "../../../components/case-studies/credential-platform-v2/SelfService.astro";
import Workflow from "../../../components/case-studies/credential-platform-v2/Workflow.astro";
import AccreditedUX from "../../../components/case-studies/credential-platform-v2/AccreditedUX.astro";
import Permissions from "../../../components/case-studies/credential-platform-v2/Permissions.astro";
import Reporting from "../../../components/case-studies/credential-platform-v2/Reporting.astro";
import Expansion from "../../../components/case-studies/credential-platform-v2/Expansion.astro";
import WhatChanged from "../../../components/case-studies/credential-platform-v2/WhatChanged.astro";
import Outcome from "../../../components/case-studies/credential-platform-v2/Outcome.astro";
import Lessons from "../../../components/case-studies/credential-platform-v2/Lessons.astro";

const t = fr;

const readingTime = calculateReadingTime(t.credentialPlatformV2);

const heroImage = `${import.meta.env.BASE_URL}images/case-studies/credential-platform-v2/asset-01.png`;
---

<BaseLayout
  title="Plateforme de credentials"
  content={t}
>

  <Index
    sections={[
      { id: "challenge", label: "Le défi" },
      { id: "business-model", label: "Modèle business → produit" },
      { id: "evolution", label: "Le premier lancement" },
      { id: "self-service", label: "Libre-service" },
      { id: "workflow", label: "Parcours credentials" },
      { id: "accredited-ux", label: "UX de l'accrédité" },
      { id: "permissions", label: "Permissions et AI" },
      { id: "reporting", label: "Rapports" },
      { id: "expansion", label: "Expansion" },
      { id: "what-changed", label: "Ce qui a changé" },
      { id: "outcome", label: "Résultat" },
      { id: "lessons", label: "Ce que j'ai appris" },
    ]}
  />

  <div class="case-study">

    <Hero
      content={t.credentialPlatformV2.hero}
      readingTime={readingTime}
      nda
    />

    <Asset
      id="ASSET 01"
      label="Visuel du hero"
      image={heroImage}
    />

    <Challenge
      eyebrow={t.credentialPlatformV2.challenge.eyebrow}
      title={t.credentialPlatformV2.challenge.title}
      paragraphs={t.credentialPlatformV2.challenge.paragraphs}
      listTitle={t.credentialPlatformV2.challenge.listTitle}
      items={t.credentialPlatformV2.challenge.items}
      closing={t.credentialPlatformV2.challenge.closing}
      asset={t.credentialPlatformV2.challenge.asset}
    />

    <BusinessModel
      number={t.credentialPlatformV2.businessModel.number}
      title={t.credentialPlatformV2.businessModel.title}
      paragraphs={t.credentialPlatformV2.businessModel.paragraphs}
      layersTitle={t.credentialPlatformV2.businessModel.layersTitle}
      layers={t.credentialPlatformV2.businessModel.layers}
      layersNote={t.credentialPlatformV2.businessModel.layersNote}
      roleTitle={t.credentialPlatformV2.businessModel.roleTitle}
      roleIntro={t.credentialPlatformV2.businessModel.roleIntro}
      roleFrom={t.credentialPlatformV2.businessModel.roleFrom}
      roleParagraphs={t.credentialPlatformV2.businessModel.roleParagraphs}
      roleGoal={t.credentialPlatformV2.businessModel.roleGoal}
      matrixTitle={t.credentialPlatformV2.businessModel.matrixTitle}
      matrixColumns={t.credentialPlatformV2.businessModel.matrixColumns}
      matrixRows={t.credentialPlatformV2.businessModel.matrixRows}
      asset={t.credentialPlatformV2.businessModel.asset}
    />

    <Evolution
      number={t.credentialPlatformV2.evolution.number}
      title={t.credentialPlatformV2.evolution.title}
      paragraphs={t.credentialPlatformV2.evolution.paragraphs}
      gapsTitle={t.credentialPlatformV2.evolution.gapsTitle}
      gaps={t.credentialPlatformV2.evolution.gaps}
      closing={t.credentialPlatformV2.evolution.closing}
      shift={t.credentialPlatformV2.evolution.shift}
      timeline={t.credentialPlatformV2.evolution.timeline}
      asset={t.credentialPlatformV2.evolution.asset}
    />

    <SelfService
      number={t.credentialPlatformV2.selfService.number}
      title={t.credentialPlatformV2.selfService.title}
      paragraphs={t.credentialPlatformV2.selfService.paragraphs}
      items={t.credentialPlatformV2.selfService.items}
      transition={t.credentialPlatformV2.selfService.transition}
      resultTitle={t.credentialPlatformV2.selfService.resultTitle}
      resultText={t.credentialPlatformV2.selfService.resultText}
      beforeTitle={t.credentialPlatformV2.selfService.beforeTitle}
      beforeFlow={t.credentialPlatformV2.selfService.beforeFlow}
      afterTitle={t.credentialPlatformV2.selfService.afterTitle}
      afterFlow={t.credentialPlatformV2.selfService.afterFlow}
      contributionTitle={t.credentialPlatformV2.selfService.contributionTitle}
      contribution={t.credentialPlatformV2.selfService.contribution}
      callouts={t.credentialPlatformV2.selfService.callouts}
      assetFlow={t.credentialPlatformV2.selfService.assetFlow}
      assetUi={t.credentialPlatformV2.selfService.assetUi}
    />

    <Workflow
      number={t.credentialPlatformV2.workflow.number}
      title={t.credentialPlatformV2.workflow.title}
      paragraphs={t.credentialPlatformV2.workflow.paragraphs}
      approachTitle={t.credentialPlatformV2.workflow.approachTitle}
      approachText={t.credentialPlatformV2.workflow.approachText}
      approachSteps={t.credentialPlatformV2.workflow.approachSteps}
      templateTitle={t.credentialPlatformV2.workflow.templateTitle}
      templateText={t.credentialPlatformV2.workflow.templateText}
      bulkTitle={t.credentialPlatformV2.workflow.bulkTitle}
      bulkText={t.credentialPlatformV2.workflow.bulkText}
      beforeTitle={t.credentialPlatformV2.workflow.beforeTitle}
      beforeFlow={t.credentialPlatformV2.workflow.beforeFlow}
      afterTitle={t.credentialPlatformV2.workflow.afterTitle}
      afterFlow={t.credentialPlatformV2.workflow.afterFlow}
      stat={t.credentialPlatformV2.workflow.stat}
      uiTitle={t.credentialPlatformV2.workflow.uiTitle}
      ui={t.credentialPlatformV2.workflow.ui}
      assetA={t.credentialPlatformV2.workflow.assetA}
      assetB={t.credentialPlatformV2.workflow.assetB}
    />

    <AccreditedUX
      number={t.credentialPlatformV2.accreditedUX.number}
      title={t.credentialPlatformV2.accreditedUX.title}
      paragraphs={t.credentialPlatformV2.accreditedUX.paragraphs}
      issues={t.credentialPlatformV2.accreditedUX.issues}
      mentalTitle={t.credentialPlatformV2.accreditedUX.mentalTitle}
      mentalBold={t.credentialPlatformV2.accreditedUX.mentalBold}
      mentalText={t.credentialPlatformV2.accreditedUX.mentalText}
      beforeTitle={t.credentialPlatformV2.accreditedUX.beforeTitle}
      beforeFlow={t.credentialPlatformV2.accreditedUX.beforeFlow}
      afterTitle={t.credentialPlatformV2.accreditedUX.afterTitle}
      afterFlow={t.credentialPlatformV2.accreditedUX.afterFlow}
      annotations={t.credentialPlatformV2.accreditedUX.annotations}
      asset={t.credentialPlatformV2.accreditedUX.asset}
    />

    <Permissions
      number={t.credentialPlatformV2.permissions.number}
      title={t.credentialPlatformV2.permissions.title}
      paragraphs={t.credentialPlatformV2.permissions.paragraphs}
      wrongQIntro={t.credentialPlatformV2.permissions.wrongQIntro}
      wrongQuestion={t.credentialPlatformV2.permissions.wrongQuestion}
      rightQIntro={t.credentialPlatformV2.permissions.rightQIntro}
      rightQuestion={t.credentialPlatformV2.permissions.rightQuestion}
      modelText={t.credentialPlatformV2.permissions.modelText}
      modelTitle={t.credentialPlatformV2.permissions.modelTitle}
      model={t.credentialPlatformV2.permissions.model}
      navTitle={t.credentialPlatformV2.permissions.navTitle}
      navParagraphs={t.credentialPlatformV2.permissions.navParagraphs}
      navFormulaText={t.credentialPlatformV2.permissions.navFormulaText}
      navFormula={t.credentialPlatformV2.permissions.navFormula}
      navExampleTitle={t.credentialPlatformV2.permissions.navExampleTitle}
      navExample={t.credentialPlatformV2.permissions.navExample}
      navCaptionBefore={t.credentialPlatformV2.permissions.navCaptionBefore}
      navCaptionAfter={t.credentialPlatformV2.permissions.navCaptionAfter}
      asset={t.credentialPlatformV2.permissions.asset}
    />

    <Reporting
      number={t.credentialPlatformV2.reporting.number}
      title={t.credentialPlatformV2.reporting.title}
      paragraphs={t.credentialPlatformV2.reporting.paragraphs}
      approachTitle={t.credentialPlatformV2.reporting.approachTitle}
      approachText={t.credentialPlatformV2.reporting.approachText}
      modelTitle={t.credentialPlatformV2.reporting.modelTitle}
      modelSubtitle={t.credentialPlatformV2.reporting.modelSubtitle}
      screens={t.credentialPlatformV2.reporting.screens}
      annotation={t.credentialPlatformV2.reporting.annotation}
      asset={t.credentialPlatformV2.reporting.asset}
    />

    <Expansion
      number={t.credentialPlatformV2.expansion.number}
      title={t.credentialPlatformV2.expansion.title}
      paragraphs={t.credentialPlatformV2.expansion.paragraphs}
      considerations={t.credentialPlatformV2.expansion.considerations}
      noteTitle={t.credentialPlatformV2.expansion.noteTitle}
      noteText={t.credentialPlatformV2.expansion.noteText}
      conclusion={t.credentialPlatformV2.expansion.conclusion}
      diagramTitle={t.credentialPlatformV2.expansion.diagramTitle}
      diagram={t.credentialPlatformV2.expansion.diagram}
      asset={t.credentialPlatformV2.expansion.asset}
    />

    <WhatChanged
      title={t.credentialPlatformV2.whatChanged.title}
      columns={t.credentialPlatformV2.whatChanged.columns}
      rows={t.credentialPlatformV2.whatChanged.rows}
      metrics={t.credentialPlatformV2.whatChanged.metrics}
    />

    <Outcome
      title={t.credentialPlatformV2.outcome.title}
      paragraphs={t.credentialPlatformV2.outcome.paragraphs}
      closing={t.credentialPlatformV2.outcome.closing}
      montageTitle={t.credentialPlatformV2.outcome.montageTitle}
      montage={t.credentialPlatformV2.outcome.montage}
      asset={t.credentialPlatformV2.outcome.asset}
    />

    <Lessons
      title={t.credentialPlatformV2.lessons.title}
      heading={t.credentialPlatformV2.lessons.heading}
      paragraphs={t.credentialPlatformV2.lessons.paragraphs}
      quote={t.credentialPlatformV2.lessons.quote}
    />

  </div>

</BaseLayout>

<style>

  .case-study {
    width: 100%;
  }

  @media (min-width: 1201px) {

    .case-study {
      padding-right: 180px;
    }

  }

</style>