---
import BaseLayout from "../../layouts/BaseLayout.astro";
import fr from "../../i18n/fr";
import Hero from "../../components/home/Hero.astro";
import Work from "../../components/home/Work.astro";
import Options from "../../components/home/Options.astro";
import Closing from "../../components/home/Closing.astro";

const t = fr;
---

<BaseLayout title="Katherine Gaspare | Product Designer" content={t} lang="fr">
  
  <Hero content={t.home.hero} />

  <Options items={Object.values(t.home.options)} />

  <Work content={t.home.work} />

  <Closing content={t.home.closing} />

</BaseLayout>
