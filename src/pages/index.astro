---
import BaseLayout from "../layouts/BaseLayout.astro";
import en from "../i18n/en";

import Hero from "../components/home/Hero.astro";
import Work from "../components/home/Work.astro";
import Experience from "../components/home/Experience.astro";
import Closing from "../components/home/Closing.astro";

const t = en;
---

<BaseLayout 
  title="Katherine Gaspare"
  content={t}
  narrow
>

  <Hero content={t.home.hero} />

  <Work content={t.home.work} />

  <Experience content={t.home.experience} />

  <Closing content={t.home.closing} />

</BaseLayout>
