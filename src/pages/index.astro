---
import BaseLayout from "../layouts/BaseLayout.astro";
import en from "../i18n/en";

import Hero from "../components/home/Hero.astro";
import Work from "../components/home/Work.astro";
import Options from "../components/home/Options.astro";
import Closing from "../components/home/Closing.astro";

const t = en;
---

<BaseLayout 
  title="Katherine Gaspare"
  content={t}
>

  <Hero content={t.home.hero} />

  <Options items={Object.values(t.home.options)} />

  <Work content={t.home.work} />

  <Closing content={t.home.closing} />

</BaseLayout>
