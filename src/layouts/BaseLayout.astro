---
import "../styles/global.css";
import Sidebar from "../components/layout/Sidebar.astro";
import Footer from "../components/layout/Footer.astro";
import { Eye } from "lucide-astro";

interface Props {
  title: string;
  description?: string;
  content: any;
  lang?: string;
}

const { title, description = "Product Designer portfolio", content, lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>

    <div class="cursor" id="cursor" aria-hidden="true">
      <Eye class="cursor-eye" size={14} />
      <span class="cursor-chip-text" id="cursor-chip-text"></span>
    </div>

    <div class="layout">

        <Sidebar />

        <main>
          <slot />
          <Footer content={content.footer} />
        </main>
    </div>

  </body>
</html>

<style>

.layout {

  display: grid;

  grid-template-columns: var(--sidebar-width) 1fr;

  transition: grid-template-columns .3s ease;

}


main {

  grid-column: 2;
  
  padding: 0 var(--space-xl);

  min-width: 0;
}


.layout.collapsed {

  grid-template-columns: var(--sidebar-collapsed) 1fr;

}


@media (max-width: 768px) {

  .layout,
  .layout.collapsed {

    display: block;

    transition: none;

  }


  main {

    padding: 0 var(--space-md);

  }

}


/* ========================================
   Custom cursor
======================================== */

.cursor {

  position: fixed;

  top: 0;

  left: 0;

  width: 10px;

  height: 10px;

  border-radius: 50%;

  background: var(--color-accent);

  transform: translate(-50%, -50%);

  pointer-events: none;

  z-index: 9999;

  opacity: 0;

  transition:
    width .2s ease,
    height .2s ease,
    background .2s ease,
    border-color .2s ease,
    opacity .3s ease;

}


.cursor.cursor-visible {

  opacity: 1;

}


.cursor.cursor-active {

  width: 24px;

  height: 24px;

  background: var(--color-accent-soft);

  border: 1.5px solid var(--color-accent);

}


/* ========================================
   Cursor chip (hover on case study cards)
======================================== */

.cursor-eye,
.cursor-chip-text {
  display: none;
}


#cursor.cursor-chip {

  width: auto;
  height: auto;

  padding: 7px 14px;

  border-radius: 999px;

  border: none;

  background: var(--color-accent);

  color: #fff;

  display: flex;
  align-items: center;
  gap: 7px;

  font-size: 12px;
  font-weight: 500;

  white-space: nowrap;

  line-height: 1;
}

#cursor.cursor-chip .cursor-eye {
  display: block;
}

#cursor.cursor-chip .cursor-chip-text {
  display: block;
}

</style>


<script>

const cursor = document.getElementById("cursor");

const finePointer =
  window.matchMedia("(pointer: fine)").matches;

const reducedMotion =
  window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

if (
  cursor &&
  finePointer &&
  !reducedMotion
) {

  let x = 0;
  let y = 0;

  let targetX = 0;
  let targetY = 0;

  let raf: number | null = null;


  const loop = () => {

    x += (targetX - x) * 0.14;
    y += (targetY - y) * 0.14;

    cursor!.style.transform =
      `translate(${x}px, ${y}px) translate(-50%, -50%)`;


    if (
      Math.abs(targetX - x) < 0.2 &&
      Math.abs(targetY - y) < 0.2
    ) {

      x = targetX;
      y = targetY;

      raf = null;

      return;

    }

    raf = requestAnimationFrame(loop);

  };


  const schedule = () => {

    if (raf === null) {

      raf = requestAnimationFrame(loop);

    }

  };


  window.addEventListener("mousemove", (event) => {

    targetX = event.clientX;
    targetY = event.clientY;

    cursor!.classList.add("cursor-visible");

    schedule();

  });


  document.addEventListener("mouseleave", () => {

    cursor!.classList.remove("cursor-visible");

  });


  const interactiveSelector =
    "a, button, input, textarea, select, label, summary, [role='button']";


  document.addEventListener("mouseover", (event) => {

    const target = event.target as HTMLElement | null;

    if (target?.closest(interactiveSelector)) {

      cursor!.classList.add("cursor-active");

    }

  });


  document.addEventListener("mouseout", (event) => {

    const from = event.target as HTMLElement | null;
    const to = event.relatedTarget as HTMLElement | null;

    if (
      from?.closest(interactiveSelector) &&
      !to?.closest(interactiveSelector)
    ) {

      cursor!.classList.remove("cursor-active");

    }

  });


  // ========================================
  // Cursor chip (case study cards)
  // ========================================

  const cursorChipText =
    document.getElementById("cursor-chip-text");

  document.addEventListener("mouseover", (event) => {

    const target = event.target as HTMLElement | null;

    const chipEl =
      target?.closest<HTMLElement>(
        "[data-cursor-text]"
      );

    if (chipEl && cursorChipText) {

      cursorChipText.textContent =
        chipEl.dataset.cursorText || "";

      cursor!.classList.add("cursor-chip");

    }

  });

  document.addEventListener("mouseout", (event) => {

    const from = event.target as HTMLElement | null;
    const to = event.relatedTarget as HTMLElement | null;

    if (
      from?.closest("[data-cursor-text]") &&
      !to?.closest("[data-cursor-text]")
    ) {

      cursor!.classList.remove("cursor-chip");

    }

  });

}

</script>