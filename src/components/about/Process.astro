---
interface Step {
  number: string;
  title: string;
  description: string;
}

interface Props {
  content: {
    eyebrow: string;
    title: string;
    intro: string;
    steps: Step[];
  };
}

const { content } = Astro.props;
---


<section class="process">

  <div class="section-header">

    <span class="eyebrow">
      {content.eyebrow}
    </span>


    <h2>
      {content.title}
    </h2>

  </div>


  <div class="intro">

    <p>
      {content.intro}
    </p>

  </div>


  <div class="steps">

    {
      content.steps.map((step) => (

        <article class="step">

          <span class="number">
            {step.number}
          </span>


          <h3>
            {step.title}
          </h3>


          <p>
            {step.description}
          </p>

        </article>

      ))
    }

  </div>

</section>


<style>

.process {

  display: flex;

  flex-direction: column;

  gap: var(--space-xl);

}


.section-header {

  max-width: 600px;

}


.eyebrow {

  display: block;

  margin-bottom: var(--space-md);

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


.section-header h2 {

  margin: 0;

  font-size: var(--font-size-h2);

  line-height: 1.2;

}


.intro {

  max-width: 650px;

}


.intro p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-large);

  line-height: 1.7;

}


.steps {

  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: var(--space-lg);

}


.step {

  padding: var(--space-lg);

  border: 1px solid var(--color-border);

  border-radius: var(--radius-md);

}


.number {

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

}


.step h3 {

  margin: var(--space-md) 0 var(--space-sm);

}


.step p {

  margin: 0;

  color: var(--color-text-secondary);

  line-height: 1.6;

}


@media(max-width:768px){

  .steps {

    grid-template-columns: 1fr;

  }

}

</style>