---
import { Languages } from "lucide-astro";

interface Props {
  labels: {
    language: string;
  };
}

const { labels } = Astro.props;

const currentPath = Astro.url.pathname;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const currentLanguage =
  currentPath.startsWith(`${base}/es`)
    ? "ES"
    : currentPath.startsWith(`${base}/fr`)
      ? "FR"
      : "EN";
---


<div class="language-selector" id="language-selector">

  <button 
    class="language-trigger"
    aria-label={`${labels.language} (${currentLanguage})`}
    id="language-trigger"
  >

    <Languages size={17} />

  </button>


  <div class="language-menu" id="language-menu">

    <button
      data-language="en"
      class:list={{ active: currentLanguage === "EN" }}
    >
      EN
    </button>

    <button
      data-language="es"
      class:list={{ active: currentLanguage === "ES" }}
    >
      ES
    </button>

    <button
      data-language="fr"
      class:list={{ active: currentLanguage === "FR" }}
    >
      FR
    </button>

  </div>

</div>


<style>

.language-selector {

  position: relative;

}


.language-trigger {

  width: 32px;
  height: 32px;

  display: grid;

  place-items: center;

  background: transparent;

  border: 1px solid var(--color-border);

  border-radius: 8px;

  color: var(--color-text-secondary);

  padding: 0;

  cursor: pointer;

  transition:
    background .2s ease,
    color .2s ease;

}


.language-trigger:hover {

  background: var(--color-bg-primary);

  color: var(--color-text-primary);

}


.language-menu {

  position: absolute;

  top: calc(100% + 8px);

  right: 0;

  min-width: 84px;

  background: var(--color-bg-primary);

  border: 1px solid var(--color-border);

  border-radius: var(--radius-sm);

  box-shadow: 0 12px 30px rgba(0, 0, 0, .12);

  padding: 6px;

  display: none;

  z-index: 400;

}


.language-menu button {

  width: 100%;

  padding: 8px 12px;

  background: transparent;

  border: none;

  color: var(--color-text-primary);

  text-align: left;

  border-radius: var(--radius-sm);

  cursor: pointer;

}


.language-menu button:hover {

  background: var(--color-border);

}


.language-menu button.active {

  color: var(--color-accent);

  font-weight: 600;

}


.language-selector.open .language-menu {

  display: flex;

  flex-direction: column;

}

</style>


<script>

const selector = document.getElementById("language-selector");
const trigger = document.getElementById("language-trigger");

const languageButtons =
  document.querySelectorAll("[data-language]");

languageButtons.forEach((button) => {
  button.addEventListener("click", () => {
    sessionStorage.setItem(
      "language-scroll-position",
      window.scrollY.toString()
    );
  });
});

window.addEventListener("load", () => {
  const savedScroll =
    sessionStorage.getItem("language-scroll-position");

  if (!savedScroll) return;

  sessionStorage.removeItem("language-scroll-position");

  window.scrollTo({
    top: Number(savedScroll),
    behavior: "instant"
  });
});

trigger?.addEventListener("click", () => {

  selector?.classList.toggle("open");

});


languageButtons.forEach((button) => {

  button.addEventListener("click", () => {

    const language =
      button.getAttribute("data-language");

    if (!language) return;


    const base =
      import.meta.env.BASE_URL.replace(/\/$/, "");


    const pathname =
      window.location.pathname;


    // Remove the GitHub Pages base path
    let path =
      pathname.startsWith(base)
        ? pathname.slice(base.length)
        : pathname;


    // Remove current language prefix
    path =
      path.replace(/^\/(es|fr)(?=\/|$)/, "");


    // Normalize
    path =
      path.replace(/^\/+|\/+$/g, "");


    // Build destination
    let destination =
      `${base}/`;


    if (language === "es") {

      destination += "es/";

    }

    else if (language === "fr") {

      destination += "fr/";

    }


    if (path) {

      destination += `${path}/`;

    }


    window.location.href = destination;

  });

});


document.addEventListener("click", (event) => {

  if(
    selector &&
    !selector.contains(event.target as Node)
  ){

    selector.classList.remove("open");

  }

});

</script>