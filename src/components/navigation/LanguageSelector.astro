---
const currentPath = Astro.url.pathname;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const currentLanguage =
  currentPath.startsWith(`${base}/es`)
    ? "ES"
    : currentPath.startsWith(`${base}/fr`)
      ? "FR"
      : "EN";
---


<div class="language-selector" id="language-selector">

  <button 
    class="language-trigger"
    aria-label="Change language"
    id="language-trigger"
  >

    <span>
      {currentLanguage}
    </span>

    <svg 
      class="chevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>

  </button>


  <div class="language-menu" id="language-menu">

    <button data-language="en">
      EN
    </button>

    <button data-language="es">
      ES
    </button>

    <button data-language="fr">
      FR
    </button>

  </div>

</div>


<style>

.language-selector {

  position: relative;

}


.language-trigger {

  height: 36px;

  display: flex;

  align-items: center;

  gap: 8px;

  background: transparent;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-sm);

  color: var(--color-text-primary);

  padding: 0 12px;

  cursor: pointer;

  font-family: inherit;

}


.chevron {

  transition: transform .2s ease;

}


.language-menu {

  position: absolute;

  top: calc(100% + 8px);

  left: 0;

  min-width: 100%;

  background: var(--color-bg-secondary);

  border: 1px solid var(--color-border);

  border-radius: var(--radius-sm);

  padding: 6px;

  display: none;

  z-index: 10;

}


.language-menu button {

  width: 100%;

  padding: 8px 12px;

  background: transparent;

  border: none;

  color: var(--color-text-primary);

  text-align: left;

  border-radius: var(--radius-sm);

  cursor: pointer;

}


.language-menu button:hover {

  background: var(--color-border);

}


.language-selector.open .language-menu {

  display: flex;

  flex-direction: column;

}


.language-selector.open .chevron {

  transform: rotate(180deg);

}


/* Sidebar collapsed */

.sidebar.collapsed .language-trigger {

  width: 36px;

  padding: 0;

  justify-content: center;

}


.sidebar.collapsed .language-trigger span {

  font-size: 12px;

}


:global(.sidebar.collapsed) .chevron {

  display: none;

}


:global(.sidebar.collapsed) .language-trigger {

  width: 36px;

  height: 36px;

  padding: 0;

  justify-content: center;

}


</style>


<script>

const selector = document.getElementById("language-selector");
const trigger = document.getElementById("language-trigger");

const languageButtons =
  document.querySelectorAll("[data-language]");

languageButtons.forEach((button) => {
  button.addEventListener("click", () => {
    sessionStorage.setItem(
      "language-scroll-position",
      window.scrollY.toString()
    );
  });
});

window.addEventListener("load", () => {
  const savedScroll =
    sessionStorage.getItem("language-scroll-position");

  if (!savedScroll) return;

  sessionStorage.removeItem("language-scroll-position");

  window.scrollTo({
    top: Number(savedScroll),
    behavior: "instant"
  });
});

trigger?.addEventListener("click", () => {

  selector?.classList.toggle("open");

});


languageButtons.forEach((button) => {

  button.addEventListener("click", () => {

    const language =
      button.getAttribute("data-language");

    if (!language) return;


    const base =
      import.meta.env.BASE_URL.replace(/\/$/, "");


    const pathname =
      window.location.pathname;


    // Remove the GitHub Pages base path
    let path =
      pathname.startsWith(base)
        ? pathname.slice(base.length)
        : pathname;


    // Remove current language prefix
    path =
      path.replace(/^\/(es|fr)(?=\/|$)/, "");


    // Normalize
    path =
      path.replace(/^\/+|\/+$/g, "");


    // Build destination
    let destination =
      `${base}/`;


    if (language === "es") {

      destination += "es/";

    }

    else if (language === "fr") {

      destination += "fr/";

    }


    if (path) {

      destination += `${path}/`;

    }


    window.location.href = destination;

  });

});


document.addEventListener("click", (event) => {

  if(
    selector &&
    !selector.contains(event.target as Node)
  ){

    selector.classList.remove("open");

  }

});

</script>