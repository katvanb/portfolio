---
import SectionHeading from "../shared/SectionHeading.astro";
import OrganizationManagement from "./OrganizationManagement.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  items: string[];
  transition: string[];
  resultTitle: string;
  resultText: string;
  beforeTitle: string;
  beforeFlow: string[];
  afterTitle: string;
  afterFlow: string[];
  contributionTitle: string;
  contribution: string[];
  mgmtUi: {
    id: string;
    label: string;
    title: string;
    newMember: string;
    orgName: string;
    orgMeta: string;
    membersTitle: string;
    searchPlaceholder: string;
    filterLabel: string;
    columns: string[];
    rows: { name: string; role: string; status: string }[];
    detailLabel: string;
    detailName: string;
    roleLabel: string;
    roleValue: string;
    orgLabel: string;
    orgValue: string;
    credsLabel: string;
    credsValue: string;
    cancel: string;
    save: string;
    callouts: { number: string; title: string; text: string }[];
  };
}

const {
  number, title, paragraphs, items, transition, resultTitle, resultText,
  beforeTitle, beforeFlow, afterTitle, afterFlow,
  contributionTitle, contribution, mgmtUi
} = Astro.props;
---

<section class="self-service" id="self-service">

  <SectionHeading number={number} title={title} />

  <div class="body">

    <div class="paragraphs">

      {
        paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }

    </div>

    <div class="items-quote">

      <div class="quote">

        {
          transition.map((line) => (
            <p>{line}</p>
          ))
        }

      </div>

      <ul class="bullet-list">
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

    </div>

    <p class="result-title">{resultTitle}</p>

    <p>{resultText}</p>

    <div class="comparison">

      <div class="flow-card">

        <span class="flow-label">{beforeTitle}</span>

        <div class="flow-list">

          {
            beforeFlow.map((step, index) => (
              <div class="flow-step">

                <span class="flow-arrow">→</span>

                <span>{step}</span>

              </div>
            ))
          }

        </div>

      </div>


      <div class="flow-card after">

        <span class="flow-label">{afterTitle}</span>

        <div class="flow-list">

          {
            afterFlow.map((step, index) => (
              <div class="flow-step">

                <span class="flow-arrow">→</span>

                <span>{step}</span>

              </div>
            ))
          }

        </div>

      </div>

    </div>

    <h3>{contributionTitle}</h3>

    <div class="contribution">

      {
        contribution.map((item) => (
          <span class="contribution-tag">{item}</span>
        ))
      }

    </div>

  </div>

  <OrganizationManagement
    id={mgmtUi.id}
    label={mgmtUi.label}
    title={mgmtUi.title}
    newMember={mgmtUi.newMember}
    orgName={mgmtUi.orgName}
    orgMeta={mgmtUi.orgMeta}
    membersTitle={mgmtUi.membersTitle}
    searchPlaceholder={mgmtUi.searchPlaceholder}
    filterLabel={mgmtUi.filterLabel}
    columns={mgmtUi.columns}
    rows={mgmtUi.rows}
    detailLabel={mgmtUi.detailLabel}
    detailName={mgmtUi.detailName}
    roleLabel={mgmtUi.roleLabel}
    roleValue={mgmtUi.roleValue}
    orgLabel={mgmtUi.orgLabel}
    orgValue={mgmtUi.orgValue}
    credsLabel={mgmtUi.credsLabel}
    credsValue={mgmtUi.credsValue}
    cancel={mgmtUi.cancel}
    save={mgmtUi.save}
    callouts={mgmtUi.callouts}
  />

</section>


<style>

.self-service {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.paragraphs {

  display: flex;

  flex-direction: column;

  gap: 0;

}


.items-quote {

  display: grid;

  grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);

  align-items: center;

  gap: var(--space-lg);

  margin: var(--space-sm) 0;

}


.quote {

  border-left: 3px solid var(--color-accent);

  padding-left: var(--space-md);

}


.quote p {

  margin: 0;

  color: var(--color-text-primary) !important;

  font-size: var(--font-size-body-lg) !important;

  line-height: var(--line-height-body-lg) !important;

  font-weight: 500;

}


.bullet-list {

  margin: 0;

  padding-left: 1.25rem;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: 1.9;

}


.bullet-list li::marker {

  color: var(--color-accent);

}


@media (max-width: 700px) {

  .items-quote {

    grid-template-columns: 1fr;

    gap: var(--space-md);

  }

}


.result-title {

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  font-weight: 600;

  color: var(--color-text-primary) !important;

}


.comparison {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--space-md);

  margin: var(--space-md) 0;

}


.flow-card {

  padding: var(--space-lg);

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

}


.flow-card.after {

  border-color: var(--color-accent);

}


.flow-label {

  display: block;

  margin-bottom: var(--space-md);

  color: var(--color-text-secondary);

  font-size: var(--font-size-label);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


.flow-card.after .flow-label {

  color: var(--color-accent);

}


.flow-list {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

}


.flow-step {

  display: flex;

  align-items: center;

  gap: var(--space-sm);

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}


.flow-arrow {

  color: var(--color-accent);

}


h3 {

  margin: var(--space-lg) 0 0;

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: 600;

}


.contribution {

  display: flex;

  flex-wrap: wrap;

  gap: var(--space-sm);

}


.contribution-tag {

  padding: var(--space-xs) var(--space-md);

  border: none;

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: var(--font-family-primary);

  font-size: var(--font-size-small);

  color: var(--color-text-primary);

}

</style>