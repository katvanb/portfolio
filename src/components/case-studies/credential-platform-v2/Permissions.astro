---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  wrongQIntro: string;
  wrongQuestion: string;
  rightQIntro: string;
  rightQuestion: string;
  modelText: string;
  modelTitle: string;
  model: string[];
  navTitle: string;
  navParagraphs: string[];
  navFormulaText: string;
  navFormula: string;
  navExampleTitle: string;
  navExample: string[];
  navCaptionBefore: string;
  navCaptionAfter: string;
}

const {
  number, title, paragraphs,
  wrongQIntro, wrongQuestion, rightQIntro, rightQuestion,
  modelText, modelTitle, model,
  navTitle, navParagraphs, navFormulaText, navFormula,
  navExampleTitle, navExample, navCaptionBefore, navCaptionAfter
} = Astro.props;

const formulaParts = navFormula.split(" + ");
---

<section class="permissions" id="permissions">

  <SectionHeading number={number} title={title} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <div class="question-pair">

      <article class="question-card wrong">

        <p class="q-intro">{wrongQIntro}</p>

        <p class="question muted">{wrongQuestion}</p>

      </article>

      <article class="question-card right">

        <p class="q-intro">{rightQIntro}</p>

        <p class="question">{rightQuestion}</p>

      </article>

    </div>

    <p>{modelText}</p>

    <p class="model-title">{modelTitle}</p>

    <ul class="model-list">

      {
        model.map((item) => (
          <li>{item}</li>
        ))
      }

    </ul>

    <h3>{navTitle}</h3>

    {
      navParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p>{navFormulaText}</p>

    <div class="nav-formula">

      {
        formulaParts.map((part, index) => (
          <span class="nav-wrap">

            <span class="nav-chip">{part}</span>

            {
              index < formulaParts.length - 1 && (
                <span class="nav-arrow">→</span>
              )
            }

          </span>
        ))
      }

    </div>

    <div class="nav-demo">

      <article class="nav-panel">

        <span class="nav-label">{navCaptionBefore}</span>

        <div class="nav-card admin">

          <span class="nav-role">{navExampleTitle}</span>

          <ul>
            {navExample.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

        </div>

      </article>


      <article class="nav-panel">

        <span class="nav-label">{navCaptionAfter}</span>

        <div class="nav-card">

          <span class="nav-role">{navExampleTitle}</span>

          <ul>
            {navExample.map((item, index) => (
              <li class={index > 0 ? "dim" : ""}>{item}</li>
            ))}
          </ul>

        </div>

      </article>

    </div>

  </div>

</section>


<style>

.permissions {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.q-intro {

  margin: 0 0 var(--space-xs) !important;

  font-size: var(--font-size-body) !important;

  color: var(--color-text-secondary) !important;

}


.question-pair {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--space-md);

  margin: var(--space-md) 0;

}


.question-card {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

}


.question-card.wrong {

  opacity: 0.7;

}


.question-card .question {

  margin: 0 !important;

}


.question {

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  font-weight: 600;

  color: var(--color-text-primary) !important;

}


.question.muted {

  color: var(--color-text-secondary) !important;

  text-decoration: line-through;

  text-decoration-color: var(--color-accent);

}


.model-title {

  font-weight: 500;

  color: var(--color-text-primary) !important;

}


.model-list {

  margin: 0;

  padding-left: 1.25rem;

  columns: 2;

  column-gap: var(--space-lg);

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: 1.9;

}


.model-list li {

  break-inside: avoid;

}


.model-list li::marker {

  color: var(--color-accent);

}


h3 {

  margin: var(--space-lg) 0 0;

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: 600;

}


.nav-formula {

  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: var(--space-sm);

  width: fit-content;

  padding: var(--space-lg);

  border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);

  border-radius: var(--radius-sm);

  background: var(--color-accent-soft);

}


.nav-wrap {

  display: inline-flex;

  align-items: center;

  gap: var(--space-sm);

}


.nav-chip {

  padding: var(--space-xs) var(--space-md);

  border: none;

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: var(--font-family-primary);

  font-size: var(--font-size-small);

  color: var(--color-text-primary);

  white-space: nowrap;

}


.nav-arrow {

  color: var(--color-accent);

  font-size: var(--font-size-h3);

}


.nav-demo {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--space-md);

  margin: var(--space-md) 0;
}


.nav-label {

  display: block;

  margin-bottom: var(--space-sm);

  color: var(--color-text-secondary);

  font-size: var(--font-size-label);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


.nav-card {

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

  padding: var(--space-lg);

}


.nav-card.admin {

  border-color: var(--color-accent);

}


.nav-role {

  display: block;

  margin-bottom: var(--space-md);

  color: var(--color-accent);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  letter-spacing: 0.08em;

}


.nav-card ul {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

  margin: 0;

  padding: 0;

  list-style: none;

}


.nav-card li {

  padding: var(--space-xs) var(--space-sm);

  border: 1px solid var(--color-border);

  background: var(--color-bg-primary);

  font-size: var(--font-size-small);

  color: var(--color-text-secondary);

}


.nav-card.admin li:first-child {

  border-color: var(--color-accent);

  color: var(--color-accent);

}


.nav-card li.dim {

  opacity: 0.35;

}


@media (max-width: 640px) {

  .question-pair {

    grid-template-columns: 1fr;

  }

  .model-list {

    columns: 1;

  }

}

</style>