---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  gapsTitle: string;
  gaps: string[];
  shift: string;
}

const { number, title, paragraphs, gapsTitle, gaps, shift } = Astro.props;
---

<section class="evolution" id="evolution">

  <SectionHeading number={number} title={title} />

  <div class="body">

    <div class="paragraphs">

      {
        paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }

    </div>

    <p class="gaps-title">{gapsTitle}</p>

    <div class="gaps">

      {
        gaps.map((gap) => (
          <span class="gap-tag">{gap}</span>
        ))
      }

    </div>

    <p class="shift">{shift}</p>

  </div>

</section>


<style>

.evolution {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.paragraphs {

  display: flex;

  flex-direction: column;

  gap: 0;

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.gaps-title {

  font-weight: 500;

  color: var(--color-text-primary) !important;

}


.gaps {

  display: flex;

  flex-wrap: wrap;

  margin-top: calc(var(--space-xs) - var(--space-md));

  gap: var(--space-sm);

}


.gap-tag {

  padding: var(--space-xs) var(--space-md);

  border: none;

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: var(--font-family-primary);

  font-size: var(--font-size-small);

  color: var(--color-text-primary);

}


.shift {

  padding: var(--space-md);

  border-left: 3px solid var(--color-accent);

  background: var(--color-bg-secondary);

  color: var(--color-text-primary) !important;

}

</style>