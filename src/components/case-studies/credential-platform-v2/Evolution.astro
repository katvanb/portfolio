---
import SectionHeading from "../shared/SectionHeading.astro";
import Asset from "../shared/Asset.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  gapsTitle: string;
  gaps: string[];
  closing: string;
  shift: string;
  timeline: string[];
  asset: { id: string; label: string };
}

const { number, title, paragraphs, gapsTitle, gaps, closing, shift, timeline, asset } = Astro.props;

const assetImage = `${import.meta.env.BASE_URL}images/case-studies/credential-platform-v2/asset-04.png`;
---

<section class="evolution" id="evolution">

  <SectionHeading number={number} title={title} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p class="gaps-title">{gapsTitle}</p>

    <div class="gaps">

      {
        gaps.map((gap) => (
          <span class="gap-tag">{gap}</span>
        ))
      }

    </div>

    <p>{closing}</p>

    <p class="shift">{shift}</p>

    <div class="timeline">

      {
        timeline.map((step, index) => (
          <div class="timeline-item">

            <span class="timeline-dot"></span>

            <span class="timeline-step">{step}</span>

            {
              index < timeline.length - 1 && (
                <span class="timeline-line"></span>
              )
            }

          </div>
        ))
      }

    </div>

  </div>

  <Asset id={asset.id} label={asset.label} image={assetImage} />

</section>


<style>

.evolution {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.gaps-title {

  font-weight: 500;

  color: var(--color-text-primary) !important;

}


.gaps {

  display: flex;

  flex-wrap: wrap;

  gap: var(--space-sm);

}


.gap-tag {

  padding: var(--space-xs) var(--space-md);

  border: 1px solid var(--color-border);

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  color: var(--color-text-secondary);

}


.shift {

  padding: var(--space-md);

  border-left: 3px solid var(--color-accent);

  background: var(--color-bg-secondary);

  color: var(--color-text-primary) !important;

}


.timeline {

  display: flex;

  flex-direction: column;

  gap: 0;

  margin-top: var(--space-md);

}


.timeline-item {

  display: grid;

  grid-template-columns: 12px 1fr;

  align-items: center;

  gap: var(--space-md);

}


.timeline-dot {

  width: 12px;

  height: 12px;

  border-radius: 50%;

  background: var(--color-accent);

}


.timeline-line {

  grid-column: 1;

  width: 2px;

  height: 28px;

  margin: 0 auto;

  background: var(--color-border);

}


.timeline-step {

  grid-column: 2;

  padding: var(--space-xs) 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}


.timeline-item:last-child .timeline-step {

  color: var(--color-text-primary);

  font-weight: 600;

}

</style>