---
import SectionHeading from "../shared/SectionHeading.astro";
import Asset from "../shared/Asset.astro";

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  listTitle: string;
  items: string[];
  closing: string;
  asset: { id: string; label: string };
}

const { eyebrow, title, paragraphs, listTitle, items, closing, asset } = Astro.props;

const assetImage = `${import.meta.env.BASE_URL}images/case-studies/credential-platform-v2/asset-02.png`;
---

<section class="challenge" id="challenge">

  <SectionHeading number="00" title={title} eyebrow={eyebrow} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p class="list-title">
      {listTitle}
    </p>

    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <p class="closing">
      {closing}
    </p>

  </div>

  <Asset id={asset.id} label={asset.label} image={assetImage} />

</section>


<style>

.challenge {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


ul {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

  margin: 0;

  padding-left: 1.25rem;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: 1.7;

}


ul li::marker {

  color: var(--color-accent);

}


.list-title {

  color: var(--color-text-primary) !important;

  font-weight: 500;

}


.closing {

  padding-top: var(--space-md);

  border-top: 1px solid var(--color-border);

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  color: var(--color-text-primary) !important;

}

</style>