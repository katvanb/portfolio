---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  listTitle: string;
  items: string[];
  closing: string;
}

const { eyebrow, title, paragraphs, listTitle, items, closing } = Astro.props;
---

<section class="challenge" id="challenge">

  <SectionHeading number="00" title={title} eyebrow={eyebrow} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p class="list-title">
      {listTitle}
    </p>

    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <p class="closing">
      {closing}
    </p>

  </div>

</section>


<style>

.challenge {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


ul {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: 1.7;

}


ul li {

  padding: var(--space-sm) var(--space-md);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

}


@media (max-width: 600px) {

  ul {

    grid-template-columns: 1fr;

  }

}


.list-title {

  color: var(--color-text-primary) !important;

  font-weight: 500;

}


.closing {

  padding-top: var(--space-md);

  border-top: 1px solid var(--color-border);

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  color: var(--color-text-primary) !important;

}

</style>