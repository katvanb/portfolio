---
interface Role {
  title: string;
  items: string[];
}

interface Branch {
  name: string;
  children: string[];
}

interface Props {
  id: string;
  label: string;
  heading: string;
  roles: Role[];
  hierarchyLabel: string;
  hierarchyRoot: string;
  hierarchyBranches: Branch[];
  footer: string;
}

const {
  id,
  label,
  heading,
  roles,
  hierarchyLabel,
  hierarchyRoot,
  hierarchyBranches,
  footer
} = Astro.props;

const treeLines = buildTreeLines(hierarchyRoot, hierarchyBranches);

function buildTreeLines(root: string, branches: Branch[]): string[] {
  const lines: string[] = [root];

  branches.forEach((branch, i) => {
    const lastBranch = i === branches.length - 1;
    lines.push(`${lastBranch ? "└── " : "├── "}${branch.name}`);

    branch.children.forEach((child, j) => {
      const lastChild = j === branch.children.length - 1;
      const prefix = lastBranch ? "    " : "│   ";
      lines.push(`${prefix}${lastChild ? "└── " : "├── "}${child}`);
    });
  });

  return lines;
}
---

<figure class="responsibility-map">

  <figure class="map-stage">

    <div class="map-header">
      <span>{heading}</span>
    </div>

    <div class="map-grid">

      <div class="roles-col">

        {
          roles.map((role, index) => (
            <div class:list={["role-item", index === 0 && "first"]}>

              <span class="role-name">{role.title}</span>

              <span class="role-rail"></span>

              <ul class="role-list">
                {
                  role.items.map((item, itemIndex) => (
                    <li>
                      <span class="glyph">
                        {itemIndex === role.items.length - 1 ? "└── " : "├── "}
                      </span>
                      <span class="role-task">{item}</span>
                    </li>
                  ))
                }
              </ul>

            </div>
          ))
        }

      </div>

      <aside class="hierarchy-col">

        <span class="hierarchy-label">{hierarchyLabel}</span>

        <div class="tree-wrap">

          <pre class="tree">{treeLines.join("\n")}</pre>

        </div>

      </aside>

    </div>

    <div class="map-footer">
      <span>{footer}</span>
    </div>

  </figure>

  <figcaption class="map-caption">

    <span class="map-id">
      {id}
    </span>

    <span class="map-label">
      {label}
    </span>

  </figcaption>

</figure>


<style>

.responsibility-map {
  margin: var(--space-lg) 0;
}

/* =========================
   Stage
========================= */

.map-stage {
  border: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
  padding: var(--space-xl) var(--space-lg);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
  margin: 0;
}

/* =========================
   Header
========================= */

.map-header {
  display: flex;
  justify-content: center;
  margin-bottom: var(--space-xl);
  padding-bottom: var(--space-lg);
  border-bottom: 1px solid var(--color-border);
}

.map-header span {
  color: var(--color-text-primary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-body);
  font-weight: 600;
  letter-spacing: 0.16em;
  text-align: center;
  white-space: nowrap;
}

@media (max-width: 600px) {
  .map-header span {
    white-space: normal;
    line-height: 1.6;
  }
}

/* =========================
   Grid
========================= */

.map-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 0.55fr);
  gap: var(--space-xl);
  max-width: 860px;
  margin: 0 auto;
}

/* =========================
   Roles
========================= */

.roles-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-lg);
}

.role-item {
  padding: var(--space-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-primary);
}

.role-name {
  display: block;
  color: var(--color-accent);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  font-weight: 600;
  letter-spacing: 0.1em;
  white-space: nowrap;
}

.role-rail {
  display: block;
  width: 2px;
  height: 24px;
  margin: 6px 0;
  background: var(--color-accent);
  opacity: 0.6;
}

.role-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.role-item.first .role-rail {
  background: var(--color-accent);
  opacity: 1;
}

.role-list li {
  display: flex;
  align-items: baseline;
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  line-height: 1.2;
  padding-top: 6px;
}

.glyph {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  opacity: 0.75;
}

.role-item.first .glyph {
  color: var(--color-accent);
  opacity: 1;
}

.role-item.first .role-list li {
  color: var(--color-text-primary);
}

/* =========================
   Hierarchy
========================= */

.hierarchy-col {
  min-width: 0;
}

.hierarchy-label {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.1em;
}

.tree-wrap {
  border: 1px solid var(--color-border);
  background: var(--color-bg-primary);
  padding: var(--space-md) var(--space-lg);
}

.tree {
  margin: 0;
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-small);
  line-height: 1.8;
  white-space: pre;
}

.tree::first-line {
  color: var(--color-accent);
  font-weight: 600;
}

/* =========================
   Footer
========================= */

.map-footer {
  display: flex;
  justify-content: center;
  margin-top: var(--space-xl);
  padding-top: var(--space-lg);
  border-top: 1px solid var(--color-border);
}

.map-footer span {
  max-width: 420px;
  color: var(--color-text-primary);
  font-size: var(--font-size-small);
  font-weight: 500;
  text-align: center;
  line-height: 1.6;
}

/* =========================
   Caption
========================= */

.map-caption {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.map-id {
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-small);
  color: var(--color-accent);
  letter-spacing: 0.05em;
}

.map-label {
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
}

/* =========================
   Responsive
========================= */

@media (max-width: 700px) {

  .map-stage {
    padding: var(--space-lg) var(--space-md);
  }

  .map-grid {
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .roles-col {
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

}

</style>