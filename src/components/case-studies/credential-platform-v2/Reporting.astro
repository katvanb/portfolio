---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  approachTitle: string;
  approachText: string;
  modelTitle: string;
  modelSubtitle: string;
  screens: string[];
  annotation: string;
}

const { number, title, paragraphs, approachTitle, approachText, modelTitle, modelSubtitle, screens, annotation } = Astro.props;
---

<section class="reporting" id="reporting">

  <SectionHeading number={number} title={title} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p class="approach">{approachTitle}</p>

    <p>{approachText}</p>

    <div class="model">

      <span class="model-stage">{modelTitle}</span>

      <span class="model-arrow">↓</span>

      <span class="model-stage">{modelSubtitle}</span>

    </div>

    <div class="screens">

      {
        screens.map((screen) => (
          <div class="screen-tile">{screen}</div>
        ))
      }

    </div>

    <p class="annotation">{annotation}</p>

  </div>

</section>


<style>

.reporting {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.approach {

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  font-weight: 600;

  color: var(--color-text-primary) !important;

  padding-bottom: var(--space-md);

  border-bottom: 1px solid var(--color-border);

}


.model {

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: var(--space-xs);

  padding: var(--space-xl);

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

}


.model-stage {

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: 600;

  color: var(--color-text-primary);

}


.model-arrow {

  color: var(--color-accent);

  font-size: var(--font-size-h3);

}


.screens {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: var(--space-md);
}


.screen-tile {

  aspect-ratio: 3 / 4;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: var(--space-sm);

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

  color: var(--color-text-secondary);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  text-align: center;

}


.annotation {

  padding: var(--space-md) var(--space-lg);

  border-left: 3px solid var(--color-accent);

  background: var(--color-bg-secondary);

  color: var(--color-text-primary) !important;

  font-size: var(--font-size-body) !important;

}

</style>