---
import SectionHeading from "../shared/SectionHeading.astro";
import BulkAssignmentPrototype from "./BulkAssignmentPrototype.astro";

interface Step {
  number: string;
  name: string;
  prompt?: string;
  templates?: string[];
  drop?: string;
  or?: string;
  choose?: string;
  found?: string;
  foundLabel?: string;
  valid?: string;
  validLabel?: string;
  attention?: string;
  attentionLabel?: string;
  colName?: string;
  colStatus?: string;
  rows?: { name: string; attention?: boolean }[];
  more?: string;
  ready?: string;
  stats?: { value: string; label: string }[];
  button?: string;
}

interface Prototype {
  id: string;
  label: string;
  title: string;
  beforeTitle: string;
  beforeItems: string[];
  afterTitle: string;
  afterSteps: string[];
  stepPrefix: string;
  back: string;
  next: string;
  selected: string;
  dropTitle: string;
  csvBadge: string;
  steps: Step[];
  successTitle: string;
  successDone: string;
  startOver: string;
}

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  approachTitle: string;
  approachText: string;
  approachSteps: string[];
  templateTitle: string;
  templateText: string;
  bulkTitle: string;
  bulkText: string;
  stat: { value: string; label: string };
  prototype: Prototype;
}

const {
  number, title, paragraphs, approachTitle, approachText, approachSteps,
  templateTitle, templateText, bulkTitle, bulkText, stat, prototype
} = Astro.props;
---

<section class="workflow" id="workflow">

  <SectionHeading number={number} title={title} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p class="result-title">{approachTitle}</p>

    <p>{approachText}</p>

    <div class="approach-steps">

      {
        approachSteps.map((step, index) => (
          <span class="approach-wrap">

            <span class="approach-chip">{step}</span>

            {
              index < approachSteps.length - 1 && (
                <span class="approach-arrow">→</span>
              )
            }

          </span>
        ))
      }

    </div>

    <div class="tiles">

      <div class="tile">

        <h4>{templateTitle}</h4>

        <p>{templateText}</p>

      </div>


      <div class="tile">

        <h4>{bulkTitle}</h4>

        <p>{bulkText}</p>

      </div>

    </div>

    <div class="stat">

      <span class="stat-value">{stat.value}</span>

      <span class="stat-label">{stat.label}</span>

    </div>

  </div>

  <BulkAssignmentPrototype
    id={prototype.id}
    label={prototype.label}
    title={prototype.title}
    beforeTitle={prototype.beforeTitle}
    beforeItems={prototype.beforeItems}
    afterTitle={prototype.afterTitle}
    afterSteps={prototype.afterSteps}
    stepPrefix={prototype.stepPrefix}
    steps={prototype.steps}
    back={prototype.back}
    next={prototype.next}
    selected={prototype.selected}
    dropTitle={prototype.dropTitle}
    csvBadge={prototype.csvBadge}
    successTitle={prototype.successTitle}
    successDone={prototype.successDone}
    startOver={prototype.startOver}
  />

</section>


<style>

.workflow {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.result-title {

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  font-weight: 600;

  color: var(--color-text-primary) !important;

}


.approach-steps {

  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: var(--space-sm);

}


.approach-wrap {

  display: inline-flex;

  align-items: center;

  gap: var(--space-sm);

}


.approach-chip {

  padding: var(--space-xs) var(--space-md);

  border: 1px solid var(--color-accent);

  color: var(--color-accent);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  letter-spacing: 0.03em;

  white-space: nowrap;

}


.approach-arrow {

  color: var(--color-accent);

  font-size: var(--font-size-h3);

}


.tiles {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--space-md);

}


.tile {

  padding: var(--space-lg);

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

}


.tile h4 {

  margin: 0 0 var(--space-sm);

  font-size: var(--font-size-body);

  font-weight: 600;

  color: var(--color-text-primary);

}


.tile p {

  font-size: var(--font-size-body) !important;

}


.stat {

  display: flex;

  align-items: baseline;

  gap: var(--space-md);

  padding: var(--space-xl);

  border: 1px solid var(--color-accent);

  background: var(--color-bg-secondary);

}


.stat-value {

  font-size: var(--font-size-display);

  line-height: 1;

  font-weight: 600;

  color: var(--color-accent);

  letter-spacing: -0.02em;

}


.stat-label {

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}

</style>