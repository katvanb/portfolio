---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  approachTitle: string;
  approachSteps: string[];
  templateTitle: string;
  templateText: string;
  bulkTitle: string;
  bulkText: string;
  stat: { value: string; label: string };
}

const {
  number, title, paragraphs, approachTitle, approachSteps,
  templateTitle, templateText, bulkTitle, bulkText, stat
} = Astro.props;
---

<section class="workflow" id="workflow">

  <SectionHeading number={number} title={title} />

  <div class="body">

    <div class="paragraphs">

      {
        paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }

    </div>

    <p class="result-title">{approachTitle}</p>

    <figure class="workflow-diagram">

      <div class="diagram-steps">

        {
          approachSteps.map((step, index) => (
            <span class="diagram-wrap">

              <span class="diagram-chip">{step}</span>

              {
                index < approachSteps.length - 1 && (
                  <span class="diagram-arrow">→</span>
                )
              }

            </span>
          ))
        }

      </div>

      <div class="diagram-notes">

        <div class="note-card">

          <h4>{templateTitle}</h4>

          <p>{templateText}</p>

        </div>

        <div class="note-card">

          <h4>{bulkTitle}</h4>

          <p>{bulkText}</p>

        </div>

      </div>

    </figure>

    <div class="stat">

      <span class="stat-value">{stat.value}</span>

      <span class="stat-label">{stat.label}</span>

    </div>

  </div>

</section>


<style>

.workflow {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.paragraphs {

  display: flex;

  flex-direction: column;

  gap: 0;

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.result-title {

  font-size: var(--font-size-h3) !important;

  line-height: var(--line-height-h3) !important;

  font-weight: 600;

  color: var(--color-text-primary) !important;

}


/* =========================
   Diagram
========================= */

.workflow-diagram {

  margin: 0;

  border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);

  border-radius: var(--radius-sm);

  background: var(--color-accent-soft);

  padding: var(--space-lg);

}


.diagram-steps {

  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: var(--space-sm);

}


.diagram-wrap {

  display: inline-flex;

  align-items: center;

  gap: var(--space-sm);

}


.diagram-chip {

  padding: var(--space-xs) var(--space-md);

  border: none;

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: var(--font-family-primary);

  font-size: var(--font-size-small);

  color: var(--color-text-primary);

  white-space: nowrap;

}


.diagram-arrow {

  color: var(--color-accent);

  font-size: var(--font-size-h3);

}


.diagram-notes {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--space-md);

  margin-top: var(--space-lg);

}


.note-card {

  padding: var(--space-md);

  border-left: 3px solid var(--color-accent);

  background: var(--color-bg-primary);

}


.note-card h4 {

  margin: 0 0 var(--space-xs);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-label);

  font-weight: 600;

  letter-spacing: 0.08em;

  text-transform: uppercase;

  color: var(--color-accent);

}


.note-card p {

  color: var(--color-text-secondary) !important;

  font-size: var(--font-size-body) !important;

  line-height: var(--line-height-body) !important;

}


/* =========================
   Stat
========================= */

.stat {

  display: flex;

  align-items: baseline;

  gap: var(--space-md);

}


.stat-value {

  font-size: var(--font-size-display);

  line-height: 1;

  font-weight: 600;

  color: var(--color-accent);

  letter-spacing: -0.02em;

}


.stat-label {

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}


@media (max-width: 640px) {

  .diagram-notes {

    grid-template-columns: 1fr;

  }

}

</style>