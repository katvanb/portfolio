---
import SectionHeading from "../shared/SectionHeading.astro";
import Asset from "../shared/Asset.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  issues: string[];
  mentalTitle: string;
  mentalBold: string;
  mentalText: string;
  beforeTitle: string;
  beforeFlow: string[];
  afterTitle: string;
  afterFlow: string[];
  annotations: string[];
  asset: { id: string; label: string };
}

const {
  number, title, paragraphs, issues, mentalTitle, mentalBold, mentalText,
  beforeTitle, beforeFlow, afterTitle, afterFlow, annotations, asset
} = Astro.props;

const assetImage = `${import.meta.env.BASE_URL}images/case-studies/credential-platform-v2/asset-09.png`;
---

<section class="accredited-ux" id="accredited-ux">

  <SectionHeading number={number} title={title} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <div class="issues">

      {
        issues.map((issue) => (
          <span class="issue-tag">{issue}</span>
        ))
      }

    </div>

    <p>{mentalTitle}</p>

    <p class="mental-bold">{mentalBold}</p>

    <p>{mentalText}</p>

    <div class="comparison">

      <div class="flow-card">

        <span class="flow-label">{beforeTitle}</span>

        <div class="flow-list">

          {
            beforeFlow.map((step, index) => (
              <div class="flow-step">

                <span class="flow-arrow">→</span>

                <span>{step}</span>

              </div>
            ))
          }

        </div>

      </div>


      <div class="flow-card after">

        <span class="flow-label">{afterTitle}</span>

        <div class="flow-list">

          {
            afterFlow.map((step, index) => (
              <div class="flow-step">

                <span class="flow-arrow">→</span>

                <span>{step}</span>

              </div>
            ))
          }

        </div>

      </div>

    </div>

    <div class="annotations">

      {
        annotations.map((annotation) => (
          <div class="annotation">

            <span class="annotation-mark">✓</span>

            <span>{annotation}</span>

          </div>
        ))
      }

    </div>

  </div>

  <Asset id={asset.id} label={asset.label} image={assetImage} />

</section>


<style>

.accredited-ux {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.issues {

  display: flex;

  flex-wrap: wrap;

  gap: var(--space-sm);

}


.issue-tag {

  padding: var(--space-xs) var(--space-md);

  border: 1px solid var(--color-border);

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  color: var(--color-text-secondary);

}


.mental-bold {

  padding: var(--space-md) var(--space-lg);

  border: 1px solid var(--color-accent);

  color: var(--color-accent) !important;

  font-family: "Courier New", Courier, monospace;

  font-weight: 600 !important;

  letter-spacing: 0.02em;

  width: fit-content;

}


.comparison {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--space-md);

  margin: var(--space-md) 0;

}


.flow-card {

  padding: var(--space-lg);

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

}


.flow-card.after {

  border-color: var(--color-accent);

}


.flow-label {

  display: block;

  margin-bottom: var(--space-md);

  color: var(--color-text-secondary);

  font-size: var(--font-size-label);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


.flow-card.after .flow-label {

  color: var(--color-accent);

}


.flow-list {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

}


.flow-step {

  display: flex;

  align-items: center;

  gap: var(--space-sm);

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}


.flow-arrow {

  color: var(--color-accent);

}


.annotations {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

}


.annotation {

  display: flex;

  align-items: center;

  gap: var(--space-md);

  padding: var(--space-sm) var(--space-md);

  border-left: 3px solid var(--color-accent);

  background: var(--color-bg-secondary);

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}


.annotation-mark {

  color: var(--color-accent);

  font-weight: 700;

}

</style>