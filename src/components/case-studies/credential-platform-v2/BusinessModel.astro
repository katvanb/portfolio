---
import SectionHeading from "../shared/SectionHeading.astro";
import ResponsibilityMap from "./ResponsibilityMap.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  layersTitle: string;
  layers: { title: string; description: string }[];
  layersNote: string;
  roleTitle: string;
  roleIntro: string;
  roleFrom: string[];
  roleParagraphs: string[];
  asset: { id: string; label: string };
  roleMatrix: {
    heading: string;
    roles: { title: string; items: string[] }[];
    hierarchyLabel: string;
    hierarchyRoot: string;
    hierarchyBranches: { name: string; children: string[] }[];
    footer: string;
  };
}

const {
  number, title, paragraphs, layersTitle, layers, layersNote,
  roleTitle, roleIntro, roleFrom, roleParagraphs,
  asset, roleMatrix
} = Astro.props;

const { heading, roles, hierarchyLabel, hierarchyRoot, hierarchyBranches, footer } = roleMatrix;
---

<section class="business-model" id="business-model">

  <SectionHeading number={number} title={title} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <div class="layers-block">

      <div class="layers-head">

        <h3>{layersTitle}</h3>

        <p class="layers-subtitle">{layersNote}</p>

      </div>

      <div class="layers">

        {
          layers.map((layer) => (
            <article class="layer-card">

              <h4>{layer.title}</h4>

              <p class="layer-desc">{layer.description}</p>

              <span class="layer-hint">↳</span>

            </article>
          ))
        }

      </div>

    </div>

    <h3>{roleTitle}</h3>

    <div class="role-box">

      <p class="role-intro">{roleIntro}</p>

      <div class="flow-chips" data-reveal-flow>

        {
          roleFrom.map((step, index) => (
            <span class="flow-chip-wrap">

              <span
                class="flow-chip"
                style={`animation-delay: ${index * 0.45}s`}
              >{step}</span>

              {
                index < roleFrom.length - 1 && (
                  <span
                    class="flow-arrow"
                    style={`animation-delay: ${index * 0.45 + 0.25}s`}
                  >→</span>
                )
              }

            </span>
          ))
        }

      </div>

    </div>

    {
      roleParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

  </div>

  <ResponsibilityMap
    id={asset.id}
    label={asset.label}
    heading={heading}
    roles={roles}
    hierarchyLabel={hierarchyLabel}
    hierarchyRoot={hierarchyRoot}
    hierarchyBranches={hierarchyBranches}
    footer={footer}
  />

</section>


<style>

.business-model {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


h3 {

  margin: 0;

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: 600;

}


/* =========================
   Two layers
========================= */

.layers-block {

  display: grid;

  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);

  align-items: start;

  gap: var(--space-lg);

  margin-top: var(--space-md);

}


.layers-head {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

}


.layers-head h3 {

  margin: 0;

}


.layers-subtitle {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body) !important;

  line-height: var(--line-height-body) !important;

}


.layers {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

}


.layer-card {

  position: relative;

  min-height: 200px;

  padding: var(--space-lg);

  padding-right: var(--space-xl);

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;

}


.layer-card h4 {

  margin: 0;

  font-size: var(--font-size-body);

  font-weight: 600;

  color: var(--color-text-primary);

}


.layer-desc {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body) !important;

  line-height: var(--line-height-body) !important;

  opacity: 0;

  transform: translateY(4px);

  transition: opacity 0.25s ease, transform 0.25s ease;

}


.layer-card:hover .layer-desc {

  opacity: 1;

  transform: none;

}


.layer-hint {

  position: absolute;

  right: var(--space-sm);

  bottom: var(--space-sm);

  width: 30px;

  height: 30px;

  border-radius: 50%;

  border: 1px solid var(--color-accent);

  color: var(--color-accent);

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: var(--font-size-body);

  line-height: 1;

  transition: background 0.2s ease, color 0.2s ease;

}


.layer-card:hover {

  border-color: var(--color-accent);

  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);

  transform: translateY(-2px);

}


.layer-card:hover .layer-hint {

  background: var(--color-accent);

  color: var(--color-bg-primary);

}


/* =========================
   Role model
========================= */

.role-box {

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

  margin-top: var(--space-md);

  padding: var(--space-lg);

  border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);

  border-radius: var(--radius-sm);

  background: var(--color-accent-soft);

}


.role-intro {

  margin: 0 !important;

}


.flow-chips {

  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: var(--space-sm);

}


.flow-chip-wrap {

  display: inline-flex;

  align-items: center;

  gap: var(--space-sm);

}


.flow-chip,
.flow-arrow {

  opacity: 0;

}


.flow-chips.is-visible .flow-chip,
.flow-chips.is-visible .flow-arrow {

  animation: dissolve-in 0.5s ease forwards;

}


@keyframes dissolve-in {

  from {

    opacity: 0;

    transform: translateY(6px);

  }

  to {

    opacity: 1;

    transform: translateY(0);

  }

}


@media (prefers-reduced-motion: reduce) {

  .flow-chip,
  .flow-arrow {

    opacity: 1;

  }

  .flow-chips.is-visible .flow-chip,
  .flow-chips.is-visible .flow-arrow {

    animation: none;

  }

  .layer-desc {

    transition: none;

  }

}


.flow-chip {

  padding: var(--space-xs) var(--space-md);

  border: none;

  border-radius: 999px;

  background: var(--color-bg-secondary);

  font-family: var(--font-family-primary);

  font-size: var(--font-size-small);

  letter-spacing: 0;

  color: var(--color-text-primary);

  white-space: nowrap;

  transition: background 0.2s ease;

}


.flow-chip:hover {

  background: color-mix(in srgb, var(--color-text-primary) 8%, var(--color-bg-secondary));

}


.flow-arrow {

  color: var(--color-accent);

  font-size: var(--font-size-h3);

}


/* =========================
   Responsive
========================= */

@media (max-width: 700px) {

  .layers-block {

    grid-template-columns: 1fr;

    gap: var(--space-md);

  }

}

</style>


<script>

  const flow = document.querySelector("[data-reveal-flow]");

  if (flow) {

    const observer = new IntersectionObserver(

      (entries) => {

        entries.forEach((entry) => {

          if (entry.isIntersecting) {

            flow.classList.add("is-visible");

            observer.disconnect();

          }

        });

      },

      { threshold: 0.3 }

    );

    observer.observe(flow);

  }

</script>