---
interface Side {
  label: string;
  items: string[];
}

interface Props {
  title: string;
  before: Side;
  after: Side;
}

const { title, before, after } = Astro.props;
---

<section class="transformation" id="transformation">

  <div class="section-heading">
    <h2>{title}</h2>
  </div>

  <p class="intro">
    Moving a complex purchasing operation online changed more than the interface.
    It changed the relationship between customer and business.
  </p>

  <div class="transformation-table">

    <div class="trans-row head">
      <div class="trans-cell before-cell">
        <span>{before.label}</span>
      </div>
      <div class="trans-cell arrow-cell"></div>
      <div class="trans-cell after-cell">
        <span>{after.label}</span>
      </div>
    </div>

    <div class="trans-body">

      <div class="trans-col before-col">

        {
          before.items.map((item, index) => (
            <div class="trans-item">
              <span class="trans-index">{String(index + 1).padStart(2, "0")}</span>
              <span>{item}</span>
            </div>
          ))
        }

      </div>

      <div class="trans-mid">
        <span class="trans-arrow">→</span>
      </div>

      <div class="trans-col after-col">

        {
          after.items.map((item, index) => (
            <div class="trans-item">
              <span class="trans-index">{String(index + 1).padStart(2, "0")}</span>
              <span>{item}</span>
            </div>
          ))
        }

      </div>

    </div>

  </div>

  <p class="caption">
    Each capability replaces a step customers previously had to perform through a human channel.
  </p>

</section>


<style>

.transformation {
  width: 100%;
  margin-top: var(--section-spacing);
}

.section-heading {
  margin-bottom: var(--space-lg);
}

.section-heading h2 {
  margin: 0;
  font-size: var(--font-size-h2);
}

.intro {
  max-width: 760px;
  margin: 0 0 var(--space-xl);
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

/* =========================
   Table
========================= */

.transformation-table {
  border: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

.trans-row.head {
  display: grid;
  grid-template-columns: 1fr 56px 1fr;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

.trans-cell {
  padding: var(--space-md) var(--space-lg);
}

.trans-cell span {
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.before-cell span {
  color: var(--color-text-secondary);
}

.after-cell span {
  color: var(--color-accent);
}

.trans-body {
  display: grid;
  grid-template-columns: 1fr 56px 1fr;
  background: var(--color-bg-primary);
}

/* =========================
   Columns
========================= */

.trans-col {
  padding: var(--space-md) var(--space-lg);
  min-width: 0;
}

.before-col {
  border-right: 1px solid var(--color-border);
}

.after-col {
  border-left: 1px solid var(--color-border);
}

.trans-item {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
}

.trans-item:not(:last-child) {
  border-bottom: 1px solid var(--color-border);
}

.after-col .trans-item {
  color: var(--color-text-primary);
}

.trans-index {
  color: var(--color-accent);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.05em;
}

/* =========================
   Middle
========================= */

.trans-mid {
  display: flex;
  align-items: center;
  justify-content: center;
}

.trans-arrow {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--color-accent);
  border-radius: 50%;
  background: var(--color-bg-primary);
  color: var(--color-accent);
  font-size: var(--font-size-h3);
}

/* =========================
   Caption
========================= */

.caption {
  max-width: 760px;
  margin: var(--space-md) 0 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  line-height: 1.7;
}

/* =========================
   Responsive
========================= */

@media (max-width: 800px) {

  .trans-row.head,
  .trans-body {
    grid-template-columns: 1fr;
  }

  .trans-mid {
    padding: var(--space-sm) 0;
    transform: rotate(90deg);
  }

  .before-col {
    border-right: none;
    border-bottom: 1px solid var(--color-border);
  }

  .after-col {
    border-left: none;
    border-top: 1px solid var(--color-border);
  }

}

</style>