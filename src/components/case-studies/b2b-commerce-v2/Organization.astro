---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  questionsIntro: string;
  questions: string[];
  goal: string;
  quote: string;
  ui: {
    label: string;
    orgTab: string;
    orgItems: string[];
    ordersTab: string;
    ordersItems: string[];
    memberName: string;
    memberRole: string;
    memberStatus: string;
    addressLabel: string;
    address: string;
    activityLabel: string;
    activity: string;
    orderRow: { id: string; status: string; date: string }[];
  };
}

const {
  number,
  title,
  paragraphs,
  questionsIntro,
  questions,
  goal,
  quote,
  ui
} = Astro.props;
---

<section class="organization" id="organization">

  <SectionHeading number={number} title={title} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <div class="questions-block">

    <p class="questions-intro">{questionsIntro}</p>

    <div class="questions">
      {
        questions.map((question, index) => (
          <div class="question-row">
            <span class="question-index">{String(index + 1).padStart(2, "0")}</span>
            <span>“{question}”</span>
          </div>
        ))
      }
    </div>

    <p class="goal">{goal}</p>

  </div>

  <!-- =========================
       UI MOCK
  ========================= -->

  <div class="ui-wrap">

    <span class="ui-label">
      {ui.label}
    </span>

    <div class="org-stage">

      <div class="org-browser">

        <div class="org-nav">
          <span class="org-nav-item active">{ui.orgTab}</span>
          <span class="org-nav-item">{ui.ordersTab}</span>
        </div>

        <div class="org-content">

          <!-- Organization column -->
          <div class="org-col">

            <div class="org-group">
              <span class="org-group-title">{ui.orgTab}</span>

              {
                ui.orgItems.map((item, index) => (
                  <div class:list={["org-row", ["c-members", "c-roles", "c-addresses", "c-activity"][index] || ""]}>
                    <span>{item}</span>
                      <i class="org-arrow">→</i>
                  </div>
                ))
              }

            </div>

          </div>

          <!-- Details column -->
          <div class="details-col">

            <div class="member-card">

              <div class="member-avatar">MG</div>

              <div class="member-info">
                <strong>{ui.memberName}</strong>
                <span>{ui.memberRole}</span>
              </div>

              <span class="status-chip">
                <i class="status-dot"></i>
                {ui.memberStatus}
              </span>

            </div>

            <div class="detail-card">
              <span class="detail-label">{ui.addressLabel}</span>
              <p>{ui.address}</p>
            </div>

            <div class="detail-card">
              <span class="detail-label">{ui.activityLabel}</span>
              <p>{ui.activity}</p>
            </div>

          </div>

          <!-- Orders -->
          <div class="orders-col">

            <span class="org-group-title">{ui.ordersTab}</span>

            <div class="order-list">

              {
                ui.orderRow.map((order, index) => (
                  <div class:list={["order-row", index < 2 && "clickable"]}>

                    <span class="order-id">{order.id}</span>

                    <span class:list={["order-status", `status-${index}`]}>
                      {order.status}
                    </span>

                    <span class="order-date">{order.date}</span>

                  </div>
                ))
              }

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

  <blockquote class="org-quote">{quote}</blockquote>

</section>


<style>

.organization {
  width: 100%;
  margin-top: var(--section-spacing);
}

/* =========================
   Body
========================= */

.body {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

/* =========================
   Questions
========================= */

.questions-block {
  margin: var(--space-xl) 0;
  max-width: 760px;
}

.questions-intro {
  color: var(--color-text-primary);
  font-size: var(--font-size-body-lg);
  font-weight: 500;
}

.questions {
  display: flex;
  flex-direction: column;
  margin: var(--space-md) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.question-row {
  display: grid;
  grid-template-columns: 40px 1fr;
  align-items: baseline;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-border);
}

.question-row:last-child {
  border-bottom: none;
}

.question-index {
  color: var(--color-accent);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.05em;
}

.question-row span:last-child {
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
}

.goal {
  margin: var(--space-md) 0 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  line-height: 1.7;
}

/* =========================
   UI MOCK
========================= */

.ui-wrap {
  margin-top: var(--space-xl);
}

.ui-label {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.org-stage {
  border: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
}

/* =========================
   Browser nav
========================= */

.org-nav {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

.org-nav-item {
  padding: var(--space-sm) var(--space-lg);
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  cursor: pointer;
  border-bottom: 2px solid transparent;
}

.org-nav-item.active {
  color: var(--color-accent);
  border-bottom-color: var(--color-accent);
  font-weight: 500;
}

/* =========================
   Content columns
========================= */

.org-content {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0;
  background: var(--color-bg-primary);
}

.org-col,
.details-col,
.orders-col {
  padding: var(--space-lg);
}

.org-col {
  border-right: 1px solid var(--color-border);
}

.details-col {
  border-right: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

.orders-col {
  background: var(--color-bg-secondary);
}

.org-group,
.order-col {
  display: flex;
  flex-direction: column;
}

.org-group-title {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--color-text-secondary);
  font-size: var(--font-size-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* =========================
   Org rows
========================= */

.org-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text-primary);
  font-size: var(--font-size-small);
}

.org-row:first-of-type {
  border-top: 1px solid var(--color-border);
}

.org-arrow {
  color: var(--color-text-secondary);
  font-style: normal;
  font-size: var(--font-size-label);
}

.c-members .org-arrow {
  color: var(--color-accent);
}

/* =========================
   Member card
========================= */

.member-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-border);
}

.member-avatar {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--font-size-small);
  font-weight: 600;
}

.member-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.member-info strong {
  font-size: var(--font-size-small);
  font-weight: 500;
}

.member-info span {
  color: var(--color-text-secondary);
  font-size: var(--font-size-label);
}

.status-chip {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--color-accent-soft);
  color: var(--color-text-primary);
  font-size: var(--font-size-micro);
  font-weight: 500;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-accent);
}

/* =========================
   Detail cards
========================= */

.detail-card {
  margin-top: var(--space-sm);
  padding: var(--space-sm);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-primary);
}

.detail-label {
  display: block;
  margin-bottom: 4px;
  color: var(--color-text-secondary);
  font-size: var(--font-size-micro);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.detail-card p {
  margin: 0;
  color: var(--color-text-primary);
  font-size: var(--font-size-small);
  line-height: 1.5;
}

/* =========================
   Orders
========================= */

.order-list {
  display: flex;
  flex-direction: column;
}

.order-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-border);
}

.order-row:first-of-type {
  border-top: 1px solid var(--color-border);
}

.order-id {
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
}

.order-status {
  padding: 3px 10px;
  border-radius: 999px;
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-size-micro);
}

.status-0 {
  color: #3f8f5f;
  border-color: transparent;
  background: #e0efe6;
}

[data-theme="dark"] .status-0 {
  background: #1e3025;
}

.status-1 {
  color: #b7791f;
  border-color: transparent;
  background: #fdf3dd;
}

[data-theme="dark"] .status-1 {
  background: #332a18;
}

.order-date {
  color: var(--color-text-secondary);
  font-size: var(--font-size-micro);
  text-align: right;
}

.order-row.clickable .order-id {
  color: var(--color-accent);
}

/* =========================
   Quote
========================= */

.org-quote {
  max-width: 760px;
  margin: var(--space-xl) 0 0;
  padding: var(--space-lg);
  border-left: 3px solid var(--color-accent);
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: 500;
}

.org-quote::before {
  content: "“";
  color: var(--color-accent);
}

.org-quote::after {
  content: "”";
  color: var(--color-accent);
}

/* =========================
   Responsive
========================= */

@media (max-width: 900px) {

  .org-content {
    grid-template-columns: 1fr;
  }

  .org-col,
  .details-col,
  .orders-col {
    border-right: none;
    border-bottom: 1px solid var(--color-border);
  }

  .org-col {
    background: var(--color-bg-primary);
  }

}

@media (max-width: 600px) {

  .org-col,
  .details-col,
  .orders-col {
    padding: var(--space-md);
  }

}

</style>