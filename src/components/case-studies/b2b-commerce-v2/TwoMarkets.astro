---
import SectionHeading from "../shared/SectionHeading.astro";

interface Market {
  label: string;
  items: string[];
}

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  closing: string;
  closing2: string;
  platformLabel: string;
  spain: Market;
  portugal: Market;
  sharedNote: string;
}

const {
  number,
  title,
  paragraphs,
  closing,
  closing2,
  platformLabel,
  spain,
  portugal,
  sharedNote
} = Astro.props;
---

<section class="two-markets" id="two-markets">

  <SectionHeading number={number} title={title} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <div class="closing">
    <p>{closing}</p>
    <p class="strong">{closing2}</p>
  </div>

  <!-- =========================
       Diagram
  ========================= -->

  <div class="markets-diagram">

    <div class="platform-node">
      <span class="platform-label">{platformLabel}</span>
    </div>

    <div class="fork">
      <span class="fork-line left"></span>
      <span class="fork-line right"></span>
      <span class="fork-dot top"></span>
      <span class="fork-dot left"></span>
      <span class="fork-dot right"></span>
    </div>

    <div class="markets-row">

      <div class="market-card">
        <div class="market-head">
          <span class="market-label">{spain.label}</span>
        </div>
        <div class="market-items">
          {spain.items.map((item) => (
            <span class="market-item">{item}</span>
          ))}
        </div>
      </div>

      <div class="market-card second">
        <div class="market-head">
          <span class="market-label">{portugal.label}</span>
        </div>
        <div class="market-items">
          {portugal.items.map((item) => (
            <span class="market-item">{item}</span>
          ))}
        </div>
      </div>

    </div>

  </div>

  <p class="shared-note">{sharedNote}</p>

</section>


<style>

.two-markets {
  width: 100%;
  margin-top: var(--section-spacing);
}

/* =========================
   Body
========================= */

.body {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

.closing {
  max-width: 760px;
  margin: var(--space-lg) 0 0;
}

.closing p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
}

.closing p.strong {
  margin-top: var(--space-xs);
  color: var(--color-text-primary);
  font-weight: 500;
}

/* =========================
   Diagram
========================= */

.markets-diagram {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--space-xl);
  padding: var(--space-xl) var(--space-lg);
  border: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

.platform-node {
  padding: var(--space-md) var(--space-xl);
  border: 1px solid var(--color-accent);
  border-radius: var(--radius-sm);
  background: var(--color-bg-primary);
}

.platform-label {
  color: var(--color-accent);
  font-size: var(--font-size-h3);
  font-weight: 600;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

/* =========================
   Fork
========================= */

.fork {
  position: relative;
  width: 100%;
  max-width: 560px;
  height: 64px;
}

.fork-line {
  position: absolute;
  top: 0;
  width: 2px;
  height: 100%;
  background: var(--color-border);
}

.fork-line.left {
  left: 35%;
}

.fork-line.right {
  right: 35%;
}

.fork-dot {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-accent);
}

.fork-dot.top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.fork-dot.left {
  bottom: 0;
  left: 35%;
  transform: translateX(-50%);
}

.fork-dot.right {
  bottom: 0;
  right: 35%;
  transform: translateX(50%);
}

/* =========================
   Markets row
========================= */

.markets-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-xl);
  width: 100%;
  max-width: 760px;
}

.market-card {
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  background: var(--color-bg-primary);
}

.market-card.second {
  border-color: var(--color-accent);
}

.market-head {
  margin-bottom: var(--space-md);
  padding-bottom: var(--space-sm);
  border-bottom: 1px solid var(--color-border);
}

.market-label {
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  font-weight: 600;
  letter-spacing: 0.1em;
}

.market-card.second .market-label {
  color: var(--color-accent);
}

.market-items {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.market-item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
}

.market-item:not(:last-child) {
  padding-bottom: var(--space-sm);
  border-bottom: 1px solid var(--color-border);
}

.market-item::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-text-secondary);
  opacity: 0.6;
}

.market-card.second .market-item::before {
  background: var(--color-accent);
  opacity: 1;
}

/* =========================
   Shared note
========================= */

.shared-note {
  max-width: 760px;
  margin: var(--space-lg) auto 0;
  padding: var(--space-md) var(--space-lg);
  border-left: 3px solid var(--color-accent);
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-weight: 500;
}

/* =========================
   Responsive
========================= */

@media (max-width: 700px) {

  .markets-row {
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .fork-line.left {
    left: 50%;
  }

  .fork-line.right {
    display: none;
  }

  .fork-dot.left {
    left: 50%;
  }

  .fork-dot.right {
    display: none;
  }

  .platform-node {
    padding: var(--space-sm) var(--space-lg);
  }

  .platform-label {
    font-size: var(--font-size-body);
  }

}

</style>