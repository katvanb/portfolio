---
interface FlowSide {
  label: string;
  sublabel: string;
  items: string[];
}

interface Props {
  title: string;
  paragraphs: string[];
  pivotLabel: string;
  pivot: string;
  pivotAfter: string;
  summaryLabel: string;
  before: FlowSide;
  after: FlowSide;
}

const {
  title,
  paragraphs,
  pivotLabel,
  pivot,
  pivotAfter,
  summaryLabel,
  before,
  after
} = Astro.props;
---

<section class="challenge" id="challenge">

  <div class="section-heading">
    <h2>{title}</h2>
  </div>

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <div class="pivot">
    <span class="pivot-label">{pivotLabel}</span>
    <p class="pivot-line">{pivot}</p>
    <p class="pivot-line strong">{pivotAfter}</p>
  </div>

  <div class="comparison-wrap">

    <span class="summary-label">{summaryLabel}</span>

    <div class="comparison">

      <div class="side before">

        <div class="side-head">
          <span class="side-label">{before.label}</span>
          <span class="side-sublabel">{before.sublabel}</span>
        </div>

        <ul>
          {before.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

      </div>

      <div class="flow-connector">
        <span class="flow-arrow">→</span>
      </div>

      <div class="side after">

        <div class="side-head">
          <span class="side-label">{after.label}</span>
          <span class="side-sublabel">{after.sublabel}</span>
        </div>

        <ul>
          {after.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

      </div>

    </div>

  </div>

</section>


<style>

.challenge {
  width: 100%;
  margin-top: var(--section-spacing);
}

.section-heading {
  margin-bottom: var(--space-lg);
}

.section-heading h2 {
  margin: 0;
  font-size: var(--font-size-h2);
}

/* =========================
   Body
========================= */

.body {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

/* =========================
   Pivot
========================= */

.pivot {
  margin: var(--space-xl) 0;
  padding: var(--space-lg);
  border-left: 3px solid var(--color-accent);
  background: var(--color-bg-secondary);
}

.pivot-label {
  display: block;
  margin-bottom: var(--space-sm);
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pivot-line {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
}

.pivot-line.strong {
  margin-top: var(--space-sm);
  color: var(--color-text-primary);
  font-weight: 500;
}

/* =========================
   Comparison
========================= */

.comparison-wrap {
  margin-top: var(--space-xl);
}

.summary-label {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.comparison {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: var(--space-md);
  align-items: stretch;
}

/* =========================
   Side
========================= */

.side {
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
}

.side.before {
  background: var(--color-bg-secondary);
}

.side.after {
  border-color: var(--color-accent);
  background: var(--color-bg-secondary);
}

.side-head {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: var(--space-md);
}

.side-label {
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.1em;
}

.side.after .side-label {
  color: var(--color-accent);
}

.side-sublabel {
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: 500;
}

.side ul {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin: 0;
  padding: 0;
  list-style: none;
}

.side li {
  padding: var(--space-xs) var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: var(--color-bg-primary);
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  line-height: 1.2;
}

.side.before li {
  color: var(--color-text-secondary);
  opacity: 0.75;
}

.side.after li {
  border-color: transparent;
  background: var(--color-accent-soft);
  color: var(--color-text-primary);
  font-weight: 500;
}

/* =========================
   Connector
========================= */

.flow-connector {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 56px;
}

.flow-arrow {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid var(--color-accent);
  border-radius: 50%;
  background: var(--color-bg-primary);
  color: var(--color-accent);
  font-size: var(--font-size-h3);
}

/* =========================
   Responsive
========================= */

@media (max-width: 900px) {

  .comparison {
    grid-template-columns: 1fr;
  }

  .flow-connector {
    min-height: 56px;
  }

  .flow-arrow {
    transform: rotate(90deg);
  }

}

@media (max-width: 600px) {

  .side {
    padding: var(--space-md);
  }

}

</style>