---
interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  wrongTitle: string;
  wrong: string;
  rightTitle: string;
  right: string;
}

const {
  number,
  title,
  paragraphs,
  wrongTitle,
  wrong,
  rightTitle,
  right
} = Astro.props;
---

<section class="adoption" id="adoption">

  <div class="adoption-inner">

    <div class="section-heading">
      <span class="section-number">{number}</span>
      <h2>{title}</h2>
    </div>

    <div class="body">
      {
        paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>

    <div class="reframe">

      <div class="reframe-row">
        <span class="reframe-label">{wrongTitle}</span>
        <span class="reframe-wrong">{wrong}</span>
      </div>

      <div class="reframe-row">
        <span class="reframe-label">{rightTitle}</span>
        <span class="reframe-right">{right}</span>
      </div>

    </div>

  </div>

</section>


<style>

.adoption {
  width: 100%;
  margin-top: var(--section-spacing);
  padding: var(--space-2xl) 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.adoption-inner {
  max-width: 860px;
  margin: 0 auto;
}

.section-heading {
  margin-bottom: var(--space-lg);
}

.section-number {
  display: block;
  margin-bottom: var(--space-xs);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-h3);
  color: var(--color-accent);
  letter-spacing: 0.05em;
  text-align: center;
}

.section-heading h2 {
  margin: 0;
  font-size: var(--font-size-h2);
  text-align: center;
}

/* =========================
   Body
========================= */

.body {
  max-width: 700px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  text-align: center;
}

.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

/* =========================
   Reframe
========================= */

.reframe {
  max-width: 700px;
  margin: var(--space-xl) auto 0;
  display: flex;
  flex-direction: column;
}

.reframe-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-lg) 0;
  text-align: center;
}

.reframe-row:first-child {
  border-bottom: 1px solid var(--color-border);
}

.reframe-label {
  color: var(--color-text-secondary);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.reframe-wrong {
  color: var(--color-text-secondary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  text-decoration: line-through;
  text-decoration-color: var(--color-border);
  text-decoration-thickness: 1px;
}

.reframe-right {
  color: var(--color-accent);
  font-size: var(--font-size-display);
  line-height: var(--line-height-display);
  font-weight: 500;
  letter-spacing: var(--letter-spacing-display);
}

/* =========================
   Responsive
========================= */

@media (max-width: 900px) {

  .reframe-right {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
  }

}

@media (max-width: 600px) {

  .reframe-right {
    font-size: var(--font-size-h2);
    line-height: var(--line-height-h2);
  }

}

</style>