---
import SectionHeading from "../shared/SectionHeading.astro";

interface Department {
  name: string;
  note: string;
}

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  departmentsTitle: string;
  departments: Department[];
  synthesisLabel: string;
  outputsTitle: string;
  outputsNote: string;
  outputs: string[];
}

const {
  number,
  title,
  paragraphs,
  departmentsTitle,
  departments,
  synthesisLabel,
  outputsTitle,
  outputsNote,
  outputs
} = Astro.props;
---

<section class="product-model" id="product-model">

  <SectionHeading number={number} title={title} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <p class="departments-title">{departmentsTitle}</p>

  <div class="model">

    <div class="departments">

      {
        departments.map((department, index) => (
          <div class="department-row">
            <span class="department-index">{String(index + 1).padStart(2, "0")}</span>
            <div class="department-card">
              <span class="department-name">{department.name}</span>
              <span class="department-note">{department.note}</span>
            </div>
          </div>
        ))
      }

    </div>

    <div class="converge">
      <div class="converge-arrow">↓</div>
      <div class="synthesis">
        <span class="synthesis-label">{synthesisLabel}</span>
      </div>
    </div>

    <div class="outputs">

      <span class="outputs-label">{outputsTitle}</span>

      <div class="output-grid">
        {
          outputs.map((output, index) => (
            <div class="output-chip">
              <span class="output-index">{String(index + 1).padStart(2, "0")}</span>
              <span>{output}</span>
            </div>
          ))
        }
      </div>

    </div>

  </div>

  <p class="outputs-note">{outputsNote}</p>

</section>


<style>

.product-model {
  width: 100%;
  margin-top: var(--section-spacing);
}

/* =========================
   Body
========================= */

.body {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

.departments-title {
  margin: var(--space-xl) 0 var(--space-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: 500;
}

/* =========================
   Model
========================= */

.model {
  border: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

/* =========================
   Departments
========================= */

.departments {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--space-sm);
}

.department-row {
  min-width: 0;
  padding: var(--space-md);
  border-right: 1px solid var(--color-border);
}

.department-row:last-child {
  border-right: none;
}

.department-index {
  display: block;
  margin-bottom: var(--space-sm);
  color: var(--color-accent);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.05em;
}

.department-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.department-name {
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  font-weight: 500;
}

.department-note {
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  line-height: 1.4;
}

/* =========================
   Convergence
========================= */

.converge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) 0;
}

.converge-arrow {
  color: var(--color-accent);
  font-size: var(--font-size-h3);
}

.synthesis {
  padding: var(--space-sm) var(--space-lg);
  border: 1px dashed var(--color-accent);
  border-radius: 999px;
  background: var(--color-bg-primary);
}

.synthesis-label {
  color: var(--color-accent);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: var(--font-size-small);
}

/* =========================
   Outputs
========================= */

.outputs {
  padding: var(--space-lg);
  border-top: 1px solid var(--color-border);
}

.outputs-label {
  display: block;
  margin-bottom: var(--space-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: 500;
}

.output-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-sm);
}

.output-chip {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
  font-size: var(--font-size-small);
  font-weight: 500;
}

.output-index {
  color: var(--color-accent);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.05em;
}

.outputs-note {
  max-width: 760px;
  margin: var(--space-md) 0 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
  line-height: 1.7;
}

/* =========================
   Responsive
========================= */

@media (max-width: 1150px) {

  .departments {
    grid-template-columns: repeat(2, 1fr);
  }

  .department-row:nth-child(2) {
    border-right: none;
  }

  .department-row:nth-child(n + 3) {
    border-top: 1px solid var(--color-border);
  }

  .department-row:nth-child(odd) {
    border-right: 1px solid var(--color-border);
  }

  .department-row:nth-child(even) {
    border-right: none;
  }

  .output-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media (max-width: 600px) {

  .departments {
    grid-template-columns: 1fr;
  }

  .department-row,
  .department-row:nth-child(odd),
  .department-row:nth-child(even) {
    border-right: none;
    border-top: 1px solid var(--color-border);
  }

  .department-row:first-child {
    border-top: none;
  }

  .output-grid {
    grid-template-columns: 1fr;
  }

}

</style>