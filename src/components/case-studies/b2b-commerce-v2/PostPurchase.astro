---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  needsTitle: string;
  needs: string[];
  principleTitle: string;
  orderTitle: string;
  orderFlow: string[];
  problemTitle: string;
  problemFlow: string[];
  principleA: string;
  principleB: string;
}

const {
  number,
  title,
  paragraphs,
  needsTitle,
  needs,
  principleTitle,
  orderTitle,
  orderFlow,
  problemTitle,
  problemFlow,
  principleA,
  principleB
} = Astro.props;
---

<section class="post-purchase" id="post-purchase">

  <SectionHeading number={number} title={title} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <p class="needs-title">{needsTitle}</p>

  <div class="needs">
    {needs.map((need) => (
      <span class="need-chip">{need}</span>
    ))}
  </div>

  <p class="principle-title">{principleTitle}</p>

  <!-- =========================
       Flows
  ========================= -->

  <div class="flows">

    <div class="flow-card">

      <span class="flow-label">{orderTitle}</span>

      <div class="flow-list">

        {
          orderFlow.map((step, index) => (
            <div class="flow-step">

              <span class="flow-index">{String(index + 1).padStart(2, "0")}</span>

              <span class="flow-name">{step}</span>

              {
                index < orderFlow.length - 1 && (
                  <span class="flow-connector">
                    <span class="flow-line"></span>
                    <span class="flow-arrow">↓</span>
                    <span class="flow-arrow-end"></span>
                  </span>
                )
              }

            </div>
          ))
        }

      </div>

    </div>

    <div class="flow-card problem">

      <span class="flow-label">{problemTitle}</span>

      <div class="flow-list">

        {
          problemFlow.map((step, index) => (
            <div class="flow-step">

              <span class="flow-index">{String(index + 1).padStart(2, "0")}</span>

              <span class="flow-name">{step}</span>

              {
                index < problemFlow.length - 1 && (
                  <span class="flow-connector">
                    <span class="flow-line"></span>
                    <span class="flow-arrow">↓</span>
                    <span class="flow-arrow-end"></span>
                  </span>
                )
              }

            </div>
          ))
        }

      </div>

    </div>

  </div>

  <div class="principle">
    <p>{principleA}</p>
    <p class="strong">{principleB}</p>
  </div>

</section>


<style>

.post-purchase {
  width: 100%;
  margin-top: var(--section-spacing);
}

/* =========================
   Body
========================= */

.body {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
  line-height: var(--line-height-body-lg);
}

/* =========================
   Needs
========================= */

.needs-title {
  margin: var(--space-xl) 0 var(--space-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: 500;
}

.needs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.need-chip {
  padding: var(--space-xs) var(--space-md);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: var(--font-size-small);
}

/* =========================
   Principle title
========================= */

.principle-title {
  margin: var(--space-xl) 0 var(--space-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  line-height: var(--line-height-h3);
  font-weight: 500;
}

/* =========================
   Flows
========================= */

.flows {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
}

.flow-card {
  padding: var(--space-lg);
  border: 1px solid var(--color-border);
  background: var(--color-bg-secondary);
}

.flow-card.problem {
  border-color: var(--color-accent);
}

.flow-label {
  display: block;
  margin-bottom: var(--space-lg);
  color: var(--color-text-secondary);
  font-size: var(--font-size-label);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.flow-card.problem .flow-label {
  color: var(--color-accent);
}

.flow-list {
  display: flex;
  flex-direction: column;
}

.flow-step {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: var(--space-sm);
}

.flow-index {
  color: var(--color-accent);
  font-family: "Courier New", Courier, monospace;
  font-size: var(--font-size-label);
  letter-spacing: 0.05em;
  padding-top: 4px;
}

.flow-name {
  color: var(--color-text-primary);
  font-size: var(--font-size-body);
  font-weight: 500;
  padding-bottom: 4px;
}

.flow-connector {
  grid-column: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 40px;
  position: relative;
}

.flow-line {
  width: 1px;
  height: 100%;
  background: var(--color-border);
}

.flow-arrow {
  position: absolute;
  color: var(--color-accent);
  font-size: var(--font-size-small);
}

.flow-arrow-end {
  position: absolute;
  bottom: 2px;
  width: 5px;
  height: 5px;
  border-bottom: 1px solid var(--color-accent);
  border-right: 1px solid var(--color-accent);
  transform: rotate(45deg);
}

/* =========================
   Principle
========================= */

.principle {
  max-width: 760px;
  margin: var(--space-xl) 0 0;
  padding: var(--space-lg);
  border-left: 3px solid var(--color-accent);
  background: var(--color-bg-secondary);
}

.principle p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body-lg);
}

.principle p.strong {
  margin-top: var(--space-sm);
  color: var(--color-text-primary);
  font-size: var(--font-size-h3);
  font-weight: 500;
}

/* =========================
   Responsive
========================= */

@media (max-width: 900px) {

  .flows {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 600px) {

  .flow-card {
    padding: var(--space-md);
  }

}

</style>