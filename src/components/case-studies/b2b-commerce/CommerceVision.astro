---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  discoveryTitle: string;
  discoveryStats: { value: string; label: string }[];
  discoveryText: string;
  insightLabel: string;
  insight: string;
  decisionLabel: string;
  decision: string;
  flowTitle: string;
  flow: { step: string; text: string }[];
  enablesTitle: string;
  enables: string[];
  futureTitle: string;
  future: string;
}

const {
  number,
  title,
  paragraphs,
  discoveryTitle,
  discoveryStats,
  discoveryText,
  insightLabel,
  insight,
  decisionLabel,
  decision,
  flowTitle,
  flow,
  enablesTitle,
  enables,
  futureTitle,
  future,
} = Astro.props;
---

<section class="vision" id="vision">

  <SectionHeading number={number} title={title} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <h3 class="sub-title">
    {discoveryTitle}
  </h3>

  <div class="stats">
    {
      discoveryStats.map((stat) => (
        <div class="stat">
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))
    }
  </div>

  <p class="discovery-text">
    {discoveryText}
  </p>

  <div class="insight">

    <span class="insight-label">
      {insightLabel}
    </span>

    <p class="insight-text">
      {insight}
    </p>

  </div>

  <div class="decision">

    <span class="decision-label">
      {decisionLabel}
    </span>

    <p class="decision-text">
      {decision}
    </p>

  </div>

  <h3 class="sub-title">
    {flowTitle}
  </h3>

  <ol class="flow">
    {
      flow.map((step) => (
        <li>
          <span class="flow-step">{step.step}</span>
          <span class="flow-text">{step.text}</span>
        </li>
      ))
    }
  </ol>

  <h3 class="sub-title">
    {enablesTitle}
  </h3>

  <ul class="enables">
    {
      enables.map((item) => (
        <li>{item}</li>
      ))
    }
  </ul>

  <div class="future">

    <span class="future-label">
      {futureTitle}
    </span>

    <p class="future-text">
      {future}
    </p>

  </div>

</section>


<style>

.vision {
  margin-top: var(--section-spacing);
}


.body {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);
}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.stats {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  border-top: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);
}


.stat {

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: var(--space-xs);

  padding: var(--space-md);

  text-align: center;

  border-right: 1px solid var(--color-border);
}


.stat:last-child {
  border-right: none;
}


.stat-value {

  font-size: var(--text-h1);

  line-height: 1;

  font-weight: var(--weight-medium);

  color: var(--color-accent);

  letter-spacing: -0.02em;
}


.stat-label {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}


.discovery-text {

  margin: var(--gap-label) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.insight,
.decision {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.insight-label,
.decision-label,
.future-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);
}


.insight-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.decision-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.flow {

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);
}


.flow li {

  display: flex;

  align-items: baseline;

  gap: var(--gap-elements);

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);
}


.flow-step {

  flex-shrink: 0;

  min-width: 180px;

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  color: var(--color-accent);

  letter-spacing: 0;
}


.flow-text {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.enables {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.enables li {

  padding: var(--padding-table-cell);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.future {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.future-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


@media (max-width: 768px) {

  .stats,
  .enables {

    grid-template-columns: 1fr;

  }


  .stat {

    border-right: none;

    border-bottom: 1px solid var(--color-border);

  }


  .stat:last-child {
    border-bottom: none;
  }


  .flow li {

    flex-direction: column;

    gap: var(--space-xs);

  }

}

</style>
