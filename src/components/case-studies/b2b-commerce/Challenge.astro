---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  objectivesTitle: string;
  objectiveGroups: { version: string; items: string[] }[];
  risksTitle: string;
  risks: { title: string; text: string }[];
  pivotLabel: string;
  pivot: string;
}

const {
  eyebrow,
  title,
  paragraphs,
  objectivesTitle,
  objectiveGroups,
  risksTitle,
  risks,
  pivotLabel,
  pivot,
} = Astro.props;
---

<section class="challenge" id="challenge">

  <SectionHeading number="00" title={title} eyebrow={eyebrow} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <h3 class="sub-title">
    {objectivesTitle}
  </h3>

  <div class="objectives">
    {
      objectiveGroups.map((group) => (
        <div class="objective-group">

          <span class="version">
            {group.version}
          </span>

          <ul>
            {
              group.items.map((item) => (
                <li>{item}</li>
              ))
            }
          </ul>

        </div>
      ))
    }
  </div>

  <h3 class="sub-title">
    {risksTitle}
  </h3>

  <ul class="risks">
    {
      risks.map((risk) => (
        <li>
          <span class="risk-title">{risk.title}</span>
          <span class="risk-text">{risk.text}</span>
        </li>
      ))
    }
  </ul>

  <div class="pivot">

    <span class="pivot-label">
      {pivotLabel}
    </span>

    <p class="pivot-text">
      {pivot}
    </p>

  </div>

</section>


<style>

.challenge {
  margin-top: var(--section-spacing);
}


.body {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);
}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.objectives {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 0;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.objective-group {

  padding: var(--space-sm);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);
}


.version {

  display: block;

  margin-bottom: var(--gap-label);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  color: var(--color-accent);

  letter-spacing: 0;
}


.objective-group ul {

  margin: 0;

  padding: 0;

  list-style: none;
}


.objective-group li {

  position: relative;

  padding-left: var(--space-md);

  margin-bottom: var(--space-xs);

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}


.objective-group li::before {

  position: absolute;

  left: 0;

  content: "·";

  color: var(--color-accent);
}


.risks {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.risks li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-sm);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);
}


.risk-title {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.risk-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}


.pivot {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.pivot-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);
}


.pivot-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


@media (max-width: 900px) {

  .objectives,
  .risks {

    grid-template-columns: 1fr;

  }

}

</style>
