---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  number: string;
  title: string;
  paragraphs: string[];
  feasibilityTitle: string;
  feasibility: string[];
  resistanceTitle: string;
  resistanceIntro: string;
  resistance: { stakeholder: string; resisted: string; action: string }[];
  validationTitle: string;
  validation: { label: string; text: string }[];
  supervisionTitle: string;
  supervision: string;
}

const {
  number,
  title,
  paragraphs,
  feasibilityTitle,
  feasibility,
  resistanceTitle,
  resistanceIntro,
  resistance,
  validationTitle,
  validation,
  supervisionTitle,
  supervision,
} = Astro.props;
---

<section class="execution" id="execution">

  <SectionHeading number={number} title={title} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <h3 class="sub-title">
    {feasibilityTitle}
  </h3>

  <ul class="constraints">
    {
      feasibility.map((item) => (
        <li>{item}</li>
      ))
    }
  </ul>

  <h3 class="sub-title">
    {resistanceTitle}
  </h3>

  <p class="intro">
    {resistanceIntro}
  </p>

  <ul class="stakeholders">
    {
      resistance.map((item) => (
        <li>
          <span class="who">{item.stakeholder}</span>
          <span class="resisted">{item.resisted}</span>
          <span class="action">{item.action}</span>
        </li>
      ))
    }
  </ul>

  <h3 class="sub-title">
    {validationTitle}
  </h3>

  <ul class="validation">
    {
      validation.map((item) => (
        <li>
          <span class="v-label">{item.label}</span>
          <span class="v-text">{item.text}</span>
        </li>
      ))
    }
  </ul>

  <div class="supervision">

    <span class="supervision-label">
      {supervisionTitle}
    </span>

    <p class="supervision-text">
      {supervision}
    </p>

  </div>

</section>


<style>

.execution {
  margin-top: var(--section-spacing);
}


.body {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);
}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  padding-top: var(--space-sm);

  border-top: 1px solid var(--color-border);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.intro {

  margin: 0 0 var(--gap-label);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.constraints {

  display: grid;

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.constraints li {

  position: relative;

  padding: var(--space-sm) var(--space-sm) var(--space-sm) var(--space-xl);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.constraints li::before {

  position: absolute;

  top: var(--space-sm);

  left: var(--space-sm);

  content: "×";

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;
}


.stakeholders {

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);
}


.stakeholders li {

  display: grid;

  grid-template-columns: minmax(120px, 18%) 1fr 1.4fr;

  gap: var(--gap-elements);

  padding: var(--space-sm) 0;

  border-bottom: 1px solid var(--color-border);
}


.who {

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  color: var(--color-accent);

  letter-spacing: 0;
}


.resisted {
  color: var(--color-text-secondary);
  font-size: var(--text-body);
  line-height: var(--line-height-body);
}


.action {
  color: var(--color-text-primary);
  font-size: var(--text-body);
  line-height: var(--line-height-body);
}


.validation {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.validation li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-sm);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);
}


.v-label {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.v-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}


.supervision {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.supervision-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);
}


.supervision-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


@media (max-width: 900px) {

  .stakeholders li {

    grid-template-columns: 1fr;

    gap: var(--space-xs);

  }


  .validation {

    grid-template-columns: 1fr;

  }

}

</style>
