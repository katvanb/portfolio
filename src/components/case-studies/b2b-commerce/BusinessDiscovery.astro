---
interface Props {
  title: string;
  departments: string[];
}

const { title, departments } = Astro.props;
---

<section class="business-discovery">

  <div class="section-heading">
    <h2>{title}</h2>
  </div>

  <div class="discovery-scroll">

    <div class="discovery-sticky">

        <div class="discovery-stage">
      
          <div class="orbit">
      
            <div class="orbit-ring"></div>
      
            {
              departments.map((department, index) => (
                  <div
                  class={`department department-${index}`}
                  style={`--delay: ${index * 180}ms;`}
                  >
                  <span class="department-circle"></span>
      
                  <span class="department-label">
                      {department}
                  </span>
                  </div>
              ))
            }
      
          </div>
      
          <div class="workshop-state">
      
              <div class="workshop-node">
                  Discovery Workshops
              </div>
      
          </div>
      
        </div>

    </div>

  </div>

</section>


<style>


/* =========================
   Stage
========================= */

.discovery-scroll {
  position: relative;

  height: 200vh;
}


.discovery-sticky {
  position: sticky;

  top: 0;

  height: 100vh;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.discovery-stage {
  position: relative;

  width: 100%;
  min-height: 520px;

  display: flex;

  align-items: center;
  justify-content: center;

  overflow: hidden;
}


/* =========================
   Orbit
========================= */

.orbit {
  position: relative;

  width: 420px;
  height: 420px;

  display: flex;

  align-items: center;
  justify-content: center;
}


/* =========================
   Orbit ring
========================= */

.orbit-ring {
  position: absolute;

  width: 300px;
  height: 300px;

  border:
    1px dashed
    var(--color-border);

  border-radius: 50%;

  opacity: 0;

  animation:
    ring-appear
    1000ms
    cubic-bezier(0.25, 0.1, 0.25, 1)
    250ms
    forwards,
    ring-float
    7s
    ease-in-out
    1.25s
    infinite;
}


@keyframes ring-float {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px);
  }

}


@keyframes ring-appear {

  from {
    opacity: 0;
    transform: scale(0.94);
  }

  to {
    opacity: 0.7;
    transform: scale(1);
  }

}


/* =========================
   Department
========================= */

.department {
  position: absolute;

  width: 108px;
  height: 108px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #ffffff;

  font-size: var(--font-size-small);
  font-weight: 500;

  text-align: center;

  opacity: 0;

  /*
   * La posición real durante la convergencia
   * ahora depende solamente de estas variables.
   */
  transform:
    translate(
      calc(var(--converge-x) * var(--convergence)),
      calc(var(--converge-y) * var(--convergence))
    );

  animation:
    department-appear
    1000ms
    cubic-bezier(0.25, 0.1, 0.25, 1)
    var(--delay)
    forwards;
}

/* =========================
   STATE 02
   Gravitational convergence
========================= */


.business-discovery {

  --convergence:
    clamp(
      0,
      (var(--progress) - 0.35) / 0.28,
      1
    );

  --shrink:
    clamp(
      0,
      (var(--progress) - 0.60) / 0.20,
      1
    );
}

.department {

  --converge-x: 0px;
  --converge-y: 0px;

  transform:
    translate(
      calc(
        var(--converge-x) *
        clamp(
          0,
          (var(--progress) - 0.38) * 1.7,
          1
        )
      ),
      calc(
        var(--converge-y) *
        clamp(
          0,
          (var(--progress) - 0.38) * 1.7,
          1
        )
      )
    )
    scale(
      calc(
        1 -
        clamp(
          0,
          (var(--progress) - 0.62) * 3,
          0.9
        )
      )
    );

}


/* =========================
   Convergence directions
========================= */

.department-0 {
  top: 0;
  left: 50%;
  margin-left: -54px;

  --converge-x: 0px;
  --converge-y: 210px;
}


.department-1 {
  top: 24%;
  right: 0;

  --converge-x: -190px;
  --converge-y: 100px;
}


.department-2 {
  bottom: 7%;
  right: 15%;

  --converge-x: -145px;
  --converge-y: -125px;
}


.department-3 {
  bottom: 7%;
  left: 15%;

  --converge-x: 145px;
  --converge-y: -125px;
}


.department-4 {
  top: 24%;
  left: 0;

  --converge-x: 190px;
  --converge-y: 100px;
}


/* =========================
   Department animation
========================= */


.department-circle {
  position: absolute;

  inset: 0;

  border: 1px solid var(--color-border);

  border-radius: 50%;

  background: #171717;

  z-index: 0;

  transform-origin: center;

  transform:
    scale(
      calc(
        1 -
        (
          var(--shrink) * 0.9
        )
      )
    );
}


.department-label {
  position: relative;

  z-index: 1;

  transform-origin: center;

  transform:
    scale(
      calc(
        1 -
        (
          var(--shrink) * 0.9
        )
      )
    );

  opacity:
    calc(
      1 -
      var(--shrink)
    );
}


/* =========================
   Department appearance
========================= */

@keyframes department-appear {

  0% {

    opacity: 0;

    transform:
      scale(0.05);

  }

  55% {

    opacity: 1;

    transform:
      scale(1.08);

  }

  100% {

    opacity: 1;

    transform:
      scale(1);

  }

}


/* =========================
   Department positions
========================= */

.department-0 {

  top: 0;

  left: 50%;

  margin-left: -54px;

}


.department-1 {

  top: 24%;

  right: 0;

}


.department-2 {

  bottom: 7%;

  right: 15%;

}


.department-3 {

  bottom: 7%;

  left: 15%;

}


.department-4 {

  top: 24%;

  left: 0;

}


/* =========================
   Workshop
========================= */


.workshop-state {

  position: absolute;

  inset: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  pointer-events: none;

  opacity:
    clamp(
      0,
      (var(--progress) - 0.68) * 5,
      1
    );

  transform:
    scale(
      calc(
        0.9 +
        clamp(
          0,
          (var(--progress) - 0.68) * 2,
          0.1
        )
      )
    );
}


.workshop-node {

  min-width: 280px;

  padding:
    var(--space-lg)
    var(--space-xl);

  border:
    1px solid
    var(--color-accent);

  border-radius:
    var(--radius-md);

  background:
    var(--color-background);

  color:
    var(--color-text);

  font-size:
    var(--font-size-body);

  font-weight: 600;

  text-align: center;

  box-shadow:
    0 12px 30px
    rgba(0, 0, 0, 0.06);
}


/* =========================
   Accessibility
========================= */

@media (
  prefers-reduced-motion: reduce
) {

  .department,
  .orbit-ring {

    animation: none;

    opacity: 1;

    transform: none;

  }

}


/* =========================
   Mobile
========================= */

@media (max-width: 600px) {

  .discovery-stage {

    min-height: 430px;

  }


  .orbit {

    width: 320px;

    height: 320px;

  }


  .orbit-ring {

    width: 230px;

    height: 230px;

  }


  .department {

    width: 82px;
    height: 82px;

    padding: var(--space-sm);

    font-size:
      var(--font-size-caption);

  }


  .department-0 {

    margin-left: -41px;

  }

}

</style>

<script>

  const section =
    document.querySelector(
      ".business-discovery"
    ) as HTMLElement | null;


  if (section) {

    const scrollContainer =
      section.querySelector(
        ".discovery-scroll"
      ) as HTMLElement | null;


    if (scrollContainer) {

      const updateProgress = () => {

        const rect =
          scrollContainer.getBoundingClientRect();


        const scrollDistance =
          scrollContainer.offsetHeight -
          window.innerHeight;


        if (scrollDistance <= 0) {
          return;
        }


        const progress =
          Math.max(
            0,
            Math.min(
              1,
              -rect.top / scrollDistance
            )
          );


        section.style.setProperty(
          "--progress",
          progress.toString()
        );

      };


      window.addEventListener(
        "scroll",
        updateProgress,
        { passive: true }
      );


      window.addEventListener(
        "resize",
        updateProgress
      );


      updateProgress();

    }

  }

</script>