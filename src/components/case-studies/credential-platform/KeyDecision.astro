---
import SectionHeading from "../shared/SectionHeading.astro";
import Screenshot from "../shared/Screenshot.astro";
import Comparison from "../shared/Comparison.astro";

type Item = string | { lead: string; text: string };

interface ScreenshotData {
  id?: string;
  label: string;
  note?: string;
  src?: string;
  padded?: boolean;
}

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  question: string;
  positiveLabel: string;
  positive: Item[];
  negativeLabel: string;
  negative: Item[];
  screenshots: ScreenshotData[];
}

const {
  id,
  eyebrow,
  title,
  question,
  positiveLabel,
  positive,
  negativeLabel,
  negative,
  screenshots = [],
} = Astro.props;
---

<section class="decision" id={id}>

  <SectionHeading title={title} eyebrow={eyebrow} />

  <p class="question-text">
    {question}
  </p>

  <Comparison
    positiveLabel={positiveLabel}
    positive={positive}
    negativeLabel={negativeLabel}
    negative={negative}
  />

  <div class="screenshot-grid" data-lightbox-group={id}>
    {
      screenshots.map((screenshot) => (
        <Screenshot
          id={screenshot.id}
          label={screenshot.label}
          note={screenshot.note}
          src={screenshot.src}
          padded={screenshot.padded}
        />
      ))
    }
  </div>

</section>


<style>

.decision {
  margin-top: var(--section-spacing);
}


.question-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-table);

  line-height: var(--line-height-body);

  font-weight: var(--weight-medium);
}


.screenshot-grid {

  display: grid;

  grid-template-columns: 1fr 1fr;

  align-items: start;

  gap: var(--gap-grid);

  margin: var(--gap-elements) 0 0;

}


.screenshot-grid > :global(.screenshot) {
  margin: 0;
}


@media (max-width: 768px) {

  .screenshot-grid {

    grid-template-columns: 1fr;

    gap: var(--gap-elements);

  }

}

</style>
