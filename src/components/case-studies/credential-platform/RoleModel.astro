---
import SectionHeading from "../shared/SectionHeading.astro";
import Screenshot from "../shared/Screenshot.astro";
import Comparison from "../shared/Comparison.astro";

type Item = string | { lead: string; text: string };

interface Props {
  eyebrow?: string;
  title: string;
  paragraphs: string[];
  screenshot: { id: string; label: string; note?: string; src?: string; padded?: boolean };
  comparison?: {
    positiveLabel: string;
    positive: Item[];
    negativeLabel: string;
    negative: Item[];
  };
}

const { eyebrow, title, paragraphs, screenshot, comparison } = Astro.props;
---

<section class="role-model" id="vision">

  <SectionHeading title={title} eyebrow={eyebrow} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  {
    comparison && (
      <Comparison
        positiveLabel={comparison.positiveLabel}
        positive={comparison.positive}
        negativeLabel={comparison.negativeLabel}
        negative={comparison.negative}
      />
    )
  }

  <Screenshot
    id={screenshot.id}
    label={screenshot.label}
    note={screenshot.note}
    src={screenshot.src}
    padded={screenshot.padded}
  />

</section>


<style>

.role-model {
  margin-top: var(--section-spacing);
}


.body {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);

}

</style>
