---
import SectionHeading from "../shared/SectionHeading.astro";
import DataTable from "../shared/DataTable.astro";

interface Props {
  eyebrow?: string;
  number?: string;
  title: string;
  intro: string;
  columns: string[];
  rows: string[][];
}

const { eyebrow, number, title, intro, columns, rows } = Astro.props;
---

<section class="tradeoffs" id="tradeoffs">

  <SectionHeading number={number} title={title} eyebrow={eyebrow} />

  <p class="intro">
    {intro}
  </p>

  <DataTable
    columns={columns}
    rows={rows}
    emphasis={[0]}
  />

</section>


<style>

.tradeoffs {
  margin-top: var(--section-spacing);
}


.intro {

  margin: 0 0 var(--gap-elements);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}

</style>
