---
import SectionHeading from "../shared/SectionHeading.astro";
import DataTable from "../shared/DataTable.astro";

interface Props {
  eyebrow?: string;
  number?: string;
  title: string;
  intro: string;
  columns: string[];
  rows: string[][];
  closing: string;
}

const { eyebrow, number, title, intro, columns, rows, closing } = Astro.props;
---

<section class="tradeoffs" id="tradeoffs">

  <SectionHeading number={number} title={title} eyebrow={eyebrow} />

  <p class="intro">
    {intro}
  </p>

  <DataTable
    columns={columns}
    rows={rows}
    emphasis={[0, 1]}
  />

  <p class="closing">
    {closing}
  </p>

</section>


<style>

.tradeoffs {
  margin-top: var(--section-spacing);
}


.intro {

  margin: 0 0 var(--gap-elements);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.closing {

  margin: var(--gap-elements) 0 0;

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}

</style>
