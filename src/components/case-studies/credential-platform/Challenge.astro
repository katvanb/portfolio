---
import SectionHeading from "../shared/SectionHeading.astro";
import Screenshot from "../shared/Screenshot.astro";

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  painsTitle: string;
  pains: { title: string; text: string }[];
  latentTitle: string;
  latent: { title: string; text: string }[];
  contextTitle: string;
  context: { label: string; value: string }[];
  pivotLabel: string;
  pivot: string;
  mandateLabel: string;
  mandate: string;
  screenshot: { id: string; label: string; note?: string; src?: string };
}

const {
  eyebrow,
  title,
  paragraphs,
  painsTitle,
  pains,
  latentTitle,
  latent,
  contextTitle,
  context,
  pivotLabel,
  pivot,
  mandateLabel,
  mandate,
  screenshot,
} = Astro.props;
---

<section class="challenge" id="challenge">

  <SectionHeading number="00" title={title} eyebrow={eyebrow} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

  </div>

  <h3 class="sub-title">
    {painsTitle}
  </h3>

  <ol class="pains">
    {
      pains.map((pain) => (
        <li>
          <span class="pain-title">
            {pain.title}
          </span>
          <span class="pain-text">
            {pain.text}
          </span>
        </li>
      ))
    }
  </ol>

  <h3 class="sub-title">
    {latentTitle}
  </h3>

  <ul class="latent">
    {
      latent.map((item) => (
        <li>
          <span class="latent-title">
            {item.title}
          </span>
          <span class="latent-text">
            {item.text}
          </span>
        </li>
      ))
    }
  </ul>

  <h3 class="sub-title">
    {contextTitle}
  </h3>

  <dl class="context">
    {
      context.map((row) => (
        <div class="context-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="pivot">

    <span class="pivot-label">
      {pivotLabel}
    </span>

    <p class="pivot-text">
      {pivot}
    </p>

  </div>

  <div class="mandate">

    <span class="mandate-label">
      {mandateLabel}
    </span>

    <p class="mandate-text">
      {mandate}
    </p>

  </div>

  <Screenshot
    id={screenshot.id}
    label={screenshot.label}
    note={screenshot.note}
    src={screenshot.src}
  />

</section>


<style>

.challenge {
  margin-top: var(--section-spacing);
}


.body {

  max-width: 800px;

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

}


.sub-title {

  margin: var(--space-xl) 0 var(--space-md);

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: var(--font-weight-h3);

}


.pains {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  counter-reset: pain;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);

}


.pains li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-md);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

  counter-increment: pain;

}


.pains li::before {

  content: "0" counter(pain);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  color: var(--color-accent);

  letter-spacing: 0.05em;

}


.pain-title {

  color: var(--color-text-primary);

  font-size: var(--font-size-body);

  font-weight: 500;

  line-height: 1.4;

}


.pain-text {

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  line-height: 1.5;

}


.latent {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);

}


.latent li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-md);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

}


.latent-title {

  color: var(--color-text-primary);

  font-size: var(--font-size-body);

  font-weight: 500;

}


.latent-text {

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  line-height: 1.5;

}


.context {

  margin: 0;

  border-top: 1px solid var(--color-border);

}


.context-row {

  display: grid;

  grid-template-columns: minmax(140px, 25%) 1fr;

  gap: var(--space-md);

  padding: var(--space-sm) 0;

  border-bottom: 1px solid var(--color-border);

}


.context dt {

  color: var(--color-text-secondary);

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  letter-spacing: 0.05em;

  text-transform: uppercase;

}


.context dd {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--font-size-body);

  line-height: 1.55;

}


.pivot,
.mandate {

  margin-top: var(--space-lg);

  padding: var(--space-md) var(--space-lg);

  border-radius: var(--radius-md);

}


.pivot {

  background: var(--color-accent-soft);

}


.mandate {

  background: var(--color-bg-secondary);

}


.pivot-label,
.mandate-label {

  display: block;

  margin-bottom: var(--space-xs);

  color: var(--color-text-secondary);

  font-size: var(--font-size-label);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


.pivot-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: var(--font-weight-h3);

}


.mandate-text {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: 1.6;

}


@media (max-width: 768px) {

  .pains,
  .latent {

    grid-template-columns: 1fr;

  }


  .context-row {

    grid-template-columns: 1fr;

    gap: var(--space-xs);

  }

}

</style>
