---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  painsTitle: string;
  pains: { title: string; text: string; chip?: string }[];
  latentTitle: string;
  latent: { title: string; text: string }[];
  contextTitle: string;
  contextLead: string;
  context: string[];
  pivotLabel: string;
  pivot: string;
  mandateLabel: string;
  mandate: string;
}

const {
  eyebrow,
  title,
  paragraphs,
  painsTitle,
  pains,
  latentTitle,
  latent,
  contextTitle,
  contextLead,
  context,
  pivotLabel,
  pivot,
  mandateLabel,
  mandate,
} = Astro.props;
---

<section class="challenge" id="challenge">

  <SectionHeading number="00" title={title} eyebrow={eyebrow} />

  <div class="body">

    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

  </div>

  <h3 class="sub-title">
    {painsTitle}
  </h3>

  <ol class="pains">
    {
      pains.map((pain) => (
        <li>
          <span class="pain-title">
            {pain.title}
          </span>
          <span class="pain-text">
            {pain.text}
          </span>
          {
            pain.chip && (
              <span class="chip">
                {pain.chip}
              </span>
            )
          }
        </li>
      ))
    }
  </ol>

  <h3 class="sub-title">
    {latentTitle}
  </h3>

  <ul class="latent">
    {
      latent.map((item) => (
        <li>
          <span class="latent-title">
            {item.title}
          </span>
          <span class="latent-text">
            {item.text}
          </span>
        </li>
      ))
    }
  </ul>

  <h3 class="sub-title">
    {contextTitle}
  </h3>

  <p class="context-lead">
    {contextLead}
  </p>

  <ul class="context-list">
    {
      context.map((item) => (
        <li>{item}</li>
      ))
    }
  </ul>

  <div class="pivot">

    <span class="pivot-label">
      {pivotLabel}
    </span>

    <p class="pivot-text">
      {pivot}
    </p>

  </div>

  <div class="mandate">

    <span class="mandate-label">
      {mandateLabel}
    </span>

    <p class="mandate-text">
      {mandate}
    </p>

  </div>

</section>


<style>

.challenge {
  margin-top: var(--section-spacing);
}


.body {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);

}


.body p {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);

}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);

}


.pains {

  display: grid;

  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  counter-reset: pain;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);

}


.pains li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-sm);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

  counter-increment: pain;

}


.pains li::before {

  content: "0" counter(pain);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  color: var(--color-accent);

  letter-spacing: 0;

}


.pain-title {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);

  line-height: 1.4;

}


.pain-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);

}


.chip {

  align-self: flex-start;

  margin-top: var(--space-xs);

  padding: 4px 8px;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-full);

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  letter-spacing: 0;

  line-height: var(--line-height-label);

}


.latent {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);

}


.latent li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-sm);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

}


.latent-title {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);

}


.latent-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);

}


.context-lead {

  margin: 0 0 var(--gap-label);

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);

  line-height: var(--line-height-body);

}


.context-list {

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

}


.context-list li {

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);

}


.pivot,
.mandate {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);

}


.pivot-label,
.mandate-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);

}


.pivot-text {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);

}


.mandate-text {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);

}


@media (max-width: 768px) {

  .pains,
  .latent {

    grid-template-columns: 1fr;

  }

}

</style>
