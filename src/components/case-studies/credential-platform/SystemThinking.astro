---
import SectionHeading from "../shared/SectionHeading.astro";
import Screenshot from "../shared/Screenshot.astro";

interface ScreenshotData {
  id?: string;
  label: string;
  note?: string;
  src?: string;
  padded?: boolean;
}

interface Props {
  eyebrow?: string;
  title: string;
  quote: string;
  matrixTitle: string;
  matrixColumns: string[];
  matrixRows: string[][];
  matrixCaption?: string;
  uxDecision: { label: string; items: { label: string; text: string }[] };
  stateParagraph: string;
  docsTitle: string;
  docs: { title: string; text: string }[];
  screenshots: ScreenshotData[];
}

const {
  eyebrow,
  title,
  quote,
  matrixTitle,
  matrixColumns,
  matrixRows,
  matrixCaption,
  uxDecision,
  stateParagraph,
  docsTitle,
  docs,
  screenshots = [],
} = Astro.props;
---

<section class="systems" id="systems">

  <SectionHeading title={title} eyebrow={eyebrow} />

  <blockquote class="quote">
    {quote}
  </blockquote>

  <h3 class="sub-title">
    {matrixTitle}
  </h3>

  <div class="table-wrap">

    <table>

      <thead>
        <tr>
          {
            matrixColumns.map((column) => (
              <th>{column}</th>
            ))
          }
        </tr>
      </thead>

      <tbody>
        {
          matrixRows.map((row) => (
            <tr>
              {
                row.map((cell, index) => (
                  <td class={index === 0 ? "role" : undefined}>
                    {cell}
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>

    </table>

  </div>

  {
    matrixCaption && (
      <p class="table-caption">
        {matrixCaption}
      </p>
    )
  }

  {
    uxDecision && (
      <div class="ux-decision">
        <span class="ux-decision-label">
          {uxDecision.label}
        </span>

        <ul class="ux-decision-list">
          {uxDecision.items.map((item) => (
            <li>
              <span class="ux-decision-item-label">{item.label}</span>
              <span class="ux-decision-item-text">{item.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <p class="state-paragraph">
    {stateParagraph}
  </p>

  {
    screenshots[0] && (
      <Screenshot
        id={screenshots[0].id}
        label={screenshots[0].label}
        note={screenshots[0].note}
        src={screenshots[0].src}
        padded={screenshots[0].padded}
      />
    )
  }

  <h3 class="sub-title">
    {docsTitle}
  </h3>

  <div class="labeled-table">
    {
      docs.map((doc) => (
        <div class="labeled-row">
          <span class="row-title">{doc.title}</span>
          <span class="row-text">{doc.text}</span>
        </div>
      ))
    }
  </div>

  {
    screenshots[1] && (
      <Screenshot
        id={screenshots[1].id}
        label={screenshots[1].label}
        note={screenshots[1].note}
        src={screenshots[1].src}
        padded={screenshots[1].padded}
      />
    )
  }

</section>


<style>

.systems {
  margin-top: var(--section-spacing);
}


.quote {

  margin: 0 0 var(--gap-elements);

  padding-left: var(--space-md);

  border-left: var(--border-callout) solid var(--color-accent);

  color: var(--color-text-primary);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.table-wrap {

  width: 100%;

  overflow-x: auto;
}


table {

  width: 100%;

  border-collapse: collapse;

  font-size: var(--text-table);
}


th {

  padding: var(--padding-table-cell);

  text-align: left;

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);

  border-bottom: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

  white-space: nowrap;
}


td {

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);

  vertical-align: top;

  line-height: var(--line-height-small);

  color: var(--color-text-secondary);
}


tr:last-child td {
  border-bottom: none;
}


td.role {

  color: var(--color-text-primary);

  font-weight: var(--weight-medium);

  white-space: nowrap;
}


.table-caption {

  margin: var(--space-sm) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  font-style: italic;

  line-height: var(--line-height-small);
}


.ux-decision {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.ux-decision-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);
}


.ux-decision-list {

  display: grid;

  gap: var(--space-sm);

  margin: 0;

  padding: 0;

  list-style: none;
}


.ux-decision-list li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);
}


.ux-decision-item-label {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.ux-decision-item-text {

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.state-paragraph {

  margin: var(--gap-elements) 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.labeled-table {

  width: 100%;

  border-top: 1px solid var(--color-border);
}


.labeled-row {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);
}


.row-title {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.row-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}

</style>
