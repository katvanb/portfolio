---
import SectionHeading from "../shared/SectionHeading.astro";
import Screenshot from "../shared/Screenshot.astro";

interface Props {
  eyebrow?: string;
  number?: string;
  title: string;
  paragraphs: string[];
  matrixTitle: string;
  matrixColumns: string[];
  matrixRows: string[][];
  matrixCaption?: string;
  uxDecision?: { label: string; items: { label: string; text: string }[] };
  statesTitle: string;
  statesIntro: string;
  states: string[];
  eventsTitle: string;
  events: string[];
  eventsNote: string;
  docsTitle: string;
  docs: { title: string; text: string }[];
  docsClosing: string;
  screenshots: { id: string; label: string; note?: string; src?: string; padded?: boolean }[];
}

const {
  eyebrow,
  number,
  title,
  paragraphs,
  matrixTitle,
  matrixColumns,
  matrixRows,
  matrixCaption,
  uxDecision,
  statesTitle,
  statesIntro,
  states,
  eventsTitle,
  events,
  eventsNote,
  docsTitle,
  docs,
  docsClosing,
  screenshots,
} = Astro.props;
---

<section class="systems" id="systems">

  <SectionHeading number={number} title={title} eyebrow={eyebrow} />

  <div class="body">
    {
      paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>

  <h3 class="sub-title">
    {matrixTitle}
  </h3>

  <div class="table-wrap">

    <table>

      <thead>
        <tr>
          {
            matrixColumns.map((column) => (
              <th>{column}</th>
            ))
          }
        </tr>
      </thead>

      <tbody>
        {
          matrixRows.map((row) => (
            <tr>
              {
                row.map((cell, index) => (
                  <td class={index === 0 ? "role" : undefined}>
                    {cell}
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>

    </table>

  </div>

  {
    matrixCaption && (
      <p class="table-caption">
        {matrixCaption}
      </p>
    )
  }

  {
    uxDecision && (
      <div class="ux-decision">
        <span class="ux-decision-label">
          {uxDecision.label}
        </span>

        <ul class="ux-decision-list">
          {uxDecision.items.map((item) => (
            <li>
              <span class="ux-decision-item-label">{item.label}</span>
              <span class="ux-decision-item-text">{item.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <h3 class="sub-title">
    {statesTitle}
  </h3>

  <p class="states-intro">
    {statesIntro}
  </p>

  <ul class="states">
    {
      states.map((state) => (
        <li>{state}</li>
      ))
    }
  </ul>

  <h3 class="sub-title">
    {eventsTitle}
  </h3>

  <ul class="events">
    {
      events.map((event) => (
        <li>{event}</li>
      ))
    }
  </ul>

  <p class="events-note">
    {eventsNote}
  </p>

  <h3 class="sub-title">
    {docsTitle}
  </h3>

  <ul class="docs">
    {
      docs.map((doc) => (
        <li>
          <span class="doc-title">{doc.title}</span>
          <span class="doc-text">{doc.text}</span>
        </li>
      ))
    }
  </ul>

  <p class="docs-closing">
    {docsClosing}
  </p>

  <div class="screenshots-stack">
    {
      screenshots.map((screenshot) => (
        <Screenshot
          id={screenshot.id}
          label={screenshot.label}
          note={screenshot.note}
          src={screenshot.src}
          padded={screenshot.padded}
        />
      ))
    }
  </div>

</section>


<style>

.systems {
  margin-top: var(--section-spacing);
}


.body {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);

}


.body p {
  margin: 0;
  color: var(--color-text-secondary);
  font-size: var(--text-body);
  line-height: var(--line-height-body);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.table-wrap {

  width: 100%;

  overflow-x: auto;

  border: 1px solid var(--color-border);
}


table {

  width: 100%;

  border-collapse: collapse;

  font-size: var(--text-table);
}


th {

  padding: var(--padding-table-cell);

  text-align: left;

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);

  border-bottom: 1px solid var(--color-border);

  background: var(--color-bg-secondary);

  white-space: nowrap;
}


td {

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);

  vertical-align: top;

  line-height: var(--line-height-small);

  color: var(--color-text-secondary);
}


tr:last-child td {
  border-bottom: none;
}


.table-caption {

  margin: var(--space-sm) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  font-style: italic;

  line-height: var(--line-height-small);
}


.ux-decision {

  margin-top: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.ux-decision-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);
}


.ux-decision-list {

  display: grid;

  gap: var(--space-sm);

  margin: 0;

  padding: 0;

  list-style: none;
}


.ux-decision-list li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);
}


.ux-decision-item-label {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.ux-decision-item-text {

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


td.role {

  color: var(--color-text-primary);

  font-weight: var(--weight-medium);

  white-space: nowrap;
}


.states-intro {

  margin: 0 0 var(--gap-elements);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.states {

  display: flex;

  flex-wrap: wrap;

  gap: var(--space-xs);

  margin: 0;

  padding: 0;

  list-style: none;
}


.states li {

  padding: var(--space-xs) var(--space-sm);

  border: 1px solid var(--color-border);

  border-radius: var(--radius-full);

  color: var(--color-text-primary);

  font-size: var(--text-table);
}


.events,
.docs {

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);
}


.events li {

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.events-note {

  margin: var(--space-sm) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  font-style: italic;

  line-height: var(--line-height-small);
}


.docs li {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--space-sm);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.doc-title {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.doc-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}


.docs-closing {

  margin: var(--gap-elements) 0 0;

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.screenshots-stack {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);

  margin: var(--gap-elements) 0;
}


.screenshots-stack > :global(.screenshot) {
  margin: 0;
}

</style>
