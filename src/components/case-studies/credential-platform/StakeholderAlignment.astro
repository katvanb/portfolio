---
import SectionHeading from "../shared/SectionHeading.astro";
import Comparison from "../shared/Comparison.astro";

interface Props {
  eyebrow?: string;
  title: string;
  paragraph: string;
  quote: string;
  resistanceTitle: string;
  resistance: { title: string; text: string }[];
  managedTitle: string;
  managed: { title: string; text: string }[];
  validationTitle: string;
  validation: string;
  debtTitle: string;
  debt: string;
  closing: string;
}

const {
  eyebrow,
  title,
  paragraph,
  quote,
  resistanceTitle,
  resistance,
  managedTitle,
  managed,
  validationTitle,
  validation,
  debtTitle,
  debt,
  closing,
} = Astro.props;
---

<section class="alignment" id="leadership">

  <SectionHeading title={title} eyebrow={eyebrow} />

  <p class="paragraph">
    {paragraph}
  </p>

  <blockquote class="quote">
    {quote}
  </blockquote>

  <h3 class="sub-title">
    {resistanceTitle}
  </h3>

  <div class="labeled-table">
    {
      resistance.map((item) => (
        <div class="labeled-row">
          <span class="row-title">{item.title}</span>
          <span class="row-text">{item.text}</span>
        </div>
      ))
    }
  </div>

  <h3 class="sub-title">
    {managedTitle}
  </h3>

  <div class="labeled-table">
    {
      managed.map((item) => (
        <div class="labeled-row">
          <span class="row-title">{item.title}</span>
          <span class="row-text">{item.text}</span>
        </div>
      ))
    }
  </div>

  <Comparison
    positiveLabel={validationTitle}
    positive={[validation]}
    negativeLabel={debtTitle}
    negative={[debt]}
    showMarkers={false}
  />

  <p class="closing">
    {closing}
  </p>

</section>


<style>

.alignment {
  margin-top: var(--section-spacing);
}


.paragraph {

  margin: 0 0 var(--gap-elements);

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}


.quote {

  margin: 0;

  padding-left: var(--space-md);

  border-left: var(--border-callout) solid var(--color-accent);

  color: var(--color-text-primary);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--text-subheading);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.labeled-table {

  width: 100%;

  border-top: 1px solid var(--color-border);
}


.labeled-row {

  display: flex;

  flex-direction: column;

  gap: var(--space-xs);

  padding: var(--padding-table-cell);

  border-bottom: 1px solid var(--color-border);
}


.row-title {

  color: var(--color-text-primary);

  font-size: var(--text-body);

  font-weight: var(--weight-medium);
}


.row-text {

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  line-height: var(--line-height-small);
}


.closing {

  margin: var(--gap-elements) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);
}

</style>
