---
interface Props {
  columns: string[];
  rows: string[][];
  emphasis?: number[];
  note?: string;
}

const { columns, rows, emphasis = [0], note } = Astro.props;
---

<div class="data-table">

  <div class="table-wrap">

    <table>

      <thead>
        <tr>
          {
            columns.map((column) => (
              <th>{column}</th>
            ))
          }
        </tr>
      </thead>

      <tbody>
        {
          rows.map((row) => (
            <tr>
              {
                row.map((cell, index) => (
                  <td class={emphasis.includes(index) ? "strong" : undefined}>
                    {cell}
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>

    </table>

  </div>

  {
    note && (
      <p class="note">
        {note}
      </p>
    )
  }

</div>


<style>

.table-wrap {

  width: 100%;

  overflow-x: auto;

  border: 1px solid var(--color-border);
}


table {

  width: 100%;

  border-collapse: collapse;

  font-size: var(--font-size-body);
}


th {

  padding: var(--space-md);

  text-align: left;

  color: var(--color-text-secondary);

  font-size: var(--font-size-label);

  letter-spacing: 0.08em;

  text-transform: uppercase;

  white-space: nowrap;

  border-bottom: 1px solid var(--color-border);

  background: var(--color-bg-secondary);
}


td {

  padding: var(--space-sm) var(--space-md);

  border-bottom: 1px solid var(--color-border);

  vertical-align: top;

  line-height: 1.5;

  color: var(--color-text-secondary);
}


tr:last-child td {
  border-bottom: none;
}


td.strong {

  color: var(--color-text-primary);

  font-weight: 500;
}


.note {

  margin: var(--space-sm) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  font-style: italic;

  line-height: 1.6;
}

</style>
