---
type Item = string | { lead: string; text: string };

interface Props {
  positiveLabel: string;
  positive: Item[];
  negativeLabel: string;
  negative: Item[];
  showMarkers?: boolean;
}

const {
  positiveLabel,
  positive,
  negativeLabel,
  negative,
  showMarkers = true,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<div class="comparison">

  <div class="side positive">

    {
      showMarkers && (
        <img
          class="marker"
          src={`${base}images/shared/check-mark.png`}
          alt=""
          width={40}
          height={40}
          aria-hidden="true"
        />
      )
    }

    <div class="side-content">

      <div class="side-head">

        <span class="side-label">
          {positiveLabel}
        </span>

      </div>

      <ul class="items">
        {
          positive.map((item) => (
            <li>
              {typeof item === "string" ? item : <><strong>{item.lead}</strong> {item.text}</>}
            </li>
          ))
        }
      </ul>

    </div>

  </div>


  <div class="side negative">

    {
      showMarkers && (
        <img
          class="marker"
          src={`${base}images/shared/cross-mark.png`}
          alt=""
          width={40}
          height={40}
          aria-hidden="true"
        />
      )
    }

    <div class="side-content">

      <div class="side-head">

        <span class="side-label">
          {negativeLabel}
        </span>

      </div>

      <ul class="items">
        {
          negative.map((item) => (
            <li>
              {typeof item === "string" ? item : <><strong>{item.lead}</strong> {item.text}</>}
            </li>
          ))
        }
      </ul>

    </div>

  </div>

</div>


<style>

  .comparison {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: var(--gap-cards);

    margin-top: var(--gap-elements);

  }


  .side {

    display: flex;

    align-items: flex-start;

    gap: var(--space-xs);

    min-width: 0;

  }


  .side-content {

    min-width: 0;

  }


  .marker {

    flex-shrink: 0;

    width: 40px;

    height: 40px;

    object-fit: contain;

  }


  .side-label {

    color: var(--color-text-secondary);

    font-family: var(--font-mono);

    font-size: 1rem;

    text-transform: uppercase;

    font-weight: var(--weight-medium);

    line-height: 1.2;

  }


  .items {

    margin: var(--gap-card-label) 0 0;

    padding-left: 1.25rem;

    list-style: disc;

  }


  .items li + li {

    margin-top: var(--space-xs);

  }


  .items li {

    padding-left: 2px;

    color: var(--color-text-secondary);

    font-size: var(--text-table);

    line-height: var(--line-height-small);

  }


  .items li::marker {

    color: var(--color-accent);

  }


  .items strong {

    color: var(--color-text-primary);

  }

</style>
