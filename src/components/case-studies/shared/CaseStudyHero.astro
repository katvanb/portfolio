---
interface Props {
  content: {
    tag: string;
    title: string;
    description: string;
    role: string;
    timeline: string;
    team: string;
    ndaText?: string;
  };

  readingTime?: string;
  nda?: boolean;
  ndaText?: string;
}

const { content, readingTime, nda = false, ndaText } = Astro.props;
---

<section class="case-study-hero">

  <div class="hero-content">

    <span class="eyebrow">
        {content.tag}
    </span>

    <h1>
        {content.title}
    </h1>

    <p class="description">
      {content.description}
    </p>

    {
      nda && content.ndaText && (
        <p class="nda-disclaimer">
          {content.ndaText}
        </p>
      )
    }

    {
      readingTime && (
        <span class="reading-time">
          {readingTime}
        </span>
      )
    }

  </div>


  <div class="divider"></div>


  <div class="metadata">

    <div class="metadata-row">

      <div class="metadata-item">

        <span class="label">
          ROLE
        </span>

        <p>
            {content.role}
        </p>

      </div>


      <div class="metadata-item">

        <span class="label">
          TIMELINE
        </span>

        <p>
            {content.timeline}
        </p>

      </div>

    </div>


    <div class="metadata-item team">

      <span class="label">
        TEAM
      </span>

      <p>
        {content.team}
      </p>

    </div>

  </div>

</section>


<style>

.case-study-hero {

  display: flex;

  flex-direction: column;

  gap: var(--space-xl);

  margin-top: var(--space-xl);

}


.hero-content {

  max-width: 900px;

}


.eyebrow {

  display: block;

  margin-bottom: var(--space-md);

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


h1 {

  margin: 0;

  max-width: 900px;

  font-size: var(--font-size-h1);

  line-height: 1.05;

  letter-spacing: -0.035em;

}


.description {

  max-width: 700px;

  margin: var(--space-lg) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-large);

  line-height: 1.7;

}


.nda-disclaimer {
  max-width: 700px;

  margin: var(--space-lg) 0 0;

  padding:
    var(--space-md)
    var(--space-lg);

  border-radius:
    var(--radius-md);

  background:
    var(--color-bg-secondary);

  color:
    var(--color-text-secondary);

  font-size:
    var(--font-size-small);

  font-style:
    italic;

  line-height:
    1.6;
}


.reading-time {
  display: block;

  margin-top: var(--space-md);

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);
}


.divider {

  width: 100%;

  height: 1px;

  background: var(--color-border);

}


.metadata {

  width: 100%;

}


.metadata-row {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: var(--space-xl);

}


.metadata-item {

  display: flex;

  flex-direction: column;

  gap: 4px;

}


.label {

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  letter-spacing: 0.08em;

  text-transform: uppercase;

}


.metadata-item p {

  margin: 0;

  line-height: 1.6;

  white-space: normal;

}


.team {

  margin-top: var(--space-xl);

}


@media (max-width: 768px) {

  h1 {

    font-size: var(--font-size-h2);

  }


  .metadata-row {

    grid-template-columns: 1fr;

    gap: var(--space-lg);

  }


  .team {

    margin-top: var(--space-lg);

  }

}

</style>