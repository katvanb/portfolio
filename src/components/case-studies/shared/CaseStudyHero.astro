---
interface Props {
  content: {
    tag: string;
    title: string;
    summary?: string;
    description: string | string[];
    role: string;
    timeline: string;
    team: string;
    ndaText?: string;
    focus?: string;
    heroImage?: string;
  };

  readingTime?: string;
  nda?: boolean;
  ndaText?: string;
  labels?: {
    role: string;
    timeline: string;
    team: string;
    focus: string;
    summaryLabel?: string;
    longVersionLabel?: string;
    descriptionModeLabel?: string;
  };
}

const {
  content,
  readingTime,
  nda = false,
  ndaText,
  labels = {
    role: "Role",
    timeline: "Timeline",
    team: "Team",
    focus: "Focus",
    summaryLabel: "Summary",
    longVersionLabel: "Long version",
    descriptionModeLabel: "Choose case study length",
  },
} = Astro.props;

const descriptionParagraphs = Array.isArray(content.description)
  ? content.description
  : [content.description];

const summaryLabel = labels.summaryLabel ?? "Summary";
const longVersionLabel = labels.longVersionLabel ?? "Long version";
const descriptionModeLabel = labels.descriptionModeLabel ?? "Choose case study length";
---

<section class="case-study-hero">

  {
    content.heroImage && (
      <figure class="hero-media">
        <img
          src={content.heroImage}
          alt={content.title}
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  <div class="hero-content">

    <span class="eyebrow">
        {content.tag}
    </span>

    <h1>
        {content.title}
    </h1>

    {
      content.summary ? (
        <>
          <div
            class="description-modes"
            role="group"
            aria-label={descriptionModeLabel}
            data-description-modes
          >
            <button
              type="button"
              class="description-mode"
              data-description-target="summary"
              aria-pressed="true"
            >
              {summaryLabel}
            </button>

            <button
              type="button"
              class="description-mode"
              data-description-target="long"
              aria-pressed="false"
            >
              {longVersionLabel}
            </button>
          </div>

          <div class="description-panel" data-description-panel="summary">
            <p class="description">
              {content.summary}
            </p>
          </div>

          <div class="description-panel" data-description-panel="long" hidden>
            {
              descriptionParagraphs.map((paragraph) => (
                <p class="description">{paragraph}</p>
              ))
            }
          </div>
        </>
      ) : (
        descriptionParagraphs.map((paragraph) => (
          <p class="description">{paragraph}</p>
        ))
      )
    }

    {
      nda && content.ndaText && (
        <p class="nda-disclaimer">
          {content.ndaText}
        </p>
      )
    }

    {
      readingTime && (
        <span class="reading-time">
          {readingTime}
        </span>
      )
    }

  </div>


  <div class="divider"></div>


  <div class="metadata">

    <div class="metadata-row">

      <div class="metadata-item">

        <span class="label">
          {labels.role}
        </span>

        <p>
            {content.role}
        </p>

      </div>


      <div class="metadata-item">

        <span class="label">
          {labels.timeline}
        </span>

        <p>
            {content.timeline}
        </p>

      </div>

    </div>


    <div class="metadata-row team">

      <div class="metadata-item">

        <span class="label">
          {labels.team}
        </span>

        <p>
          {content.team}
        </p>

      </div>

      {
        content.focus && (

          <div class="metadata-item">

            <span class="label">
              {labels.focus}
            </span>

            <p>
              {content.focus}
            </p>

          </div>

        )
      }

    </div>

  </div>

</section>


<style>

.case-study-hero {

  display: flex;

  flex-direction: column;

  gap: var(--gap-blocks);

  margin-top: var(--space-xl);

}


.hero-content {

  max-width: var(--content-width);

}


.hero-media {

  width: 100%;

  margin: 0;

  overflow: hidden;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-md);

  background: var(--color-bg-secondary);

}


.hero-media img {

  display: block;

  width: 100%;

  aspect-ratio: 16 / 9;

  object-fit: cover;

}


.eyebrow {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);

}


h1 {

  margin: 0;

  max-width: var(--content-width);

  font-size: var(--text-h1);

  line-height: var(--line-height-h1);

  font-weight: var(--weight-medium);

  letter-spacing: var(--letter-spacing-h1);

}


.description {

  max-width: var(--content-width);

  margin: var(--gap-elements) 0 0;

  color: var(--color-text-secondary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);

}


.description + .description {

  margin-top: var(--gap-label);

}


.description-modes {

  display: inline-flex;

  gap: 2px;

  margin-top: var(--space-lg);

  padding: 2px;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-full);

  background: var(--color-bg-secondary);

}


.description-mode {

  padding: 6px 14px;

  border: 0;

  border-radius: var(--radius-full);

  background: transparent;

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 1rem;

  line-height: 1.2;

  letter-spacing: 0.04em;

  text-transform: uppercase;

  cursor: pointer;

  transition:
    background-color .2s ease,
    color .2s ease;

}


.description-mode:hover {

  color: var(--color-text-primary);

}


.description-mode[aria-pressed="true"] {

  background: var(--color-accent-soft);

  color: var(--color-text-primary);

}


.description-mode:focus-visible {

  outline: 2px solid var(--color-accent);

  outline-offset: 2px;

}


.description-panel {

  margin-top: var(--space-md);

}


.description-panel[hidden] {

  display: none;

}


.description-panel .description {

  margin-top: 0;

}


.description-panel .description + .description {

  margin-top: var(--space-sm);

}


.nda-disclaimer {
  max-width: var(--content-width);

  margin: var(--gap-elements) 0 0;

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  border-radius: var(--radius-callout);

  background: var(--color-bg-callout);

  color: var(--color-text-secondary);

  font-size: var(--text-table);

  font-style: italic;

  line-height: var(--line-height-small);
}


.reading-time {
  display: block;

  margin-top: var(--gap-label);

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;
}


.divider {

  width: 100%;

  height: 1px;

  background: var(--color-border);

}


.metadata {

  width: 100%;

}


.metadata-row {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: var(--gap-elements);

}


.metadata-item {

  display: flex;

  flex-direction: column;

  gap: 4px;

}


.label {

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);

}


.metadata-item p {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--text-body);

  line-height: var(--line-height-body);

  white-space: normal;

}


.team {

  margin-top: var(--gap-elements);

}


@media (max-width: 768px) {

  h1 {

    font-size: 2rem;

  }


  .metadata-row {

    grid-template-columns: 1fr;

    gap: var(--gap-elements);

  }


  .team {

    margin-top: var(--gap-elements);

  }

}

</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-description-modes]").forEach((group) => {
    const hero = group.closest(".case-study-hero");

    if (!hero) {
      return;
    }

    const buttons = Array.from(
      group.querySelectorAll<HTMLButtonElement>("[data-description-target]")
    );

    const panels = Array.from(
      hero.querySelectorAll<HTMLElement>("[data-description-panel]")
    );

    const setMode = (mode: string) => {
      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.descriptionTarget === mode)
        );
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.descriptionPanel !== mode;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        setMode(button.dataset.descriptionTarget ?? "summary");
      });
    });
  });
</script>
