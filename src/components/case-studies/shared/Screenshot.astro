---
interface Props {
  id: string;
  label: string;
  note?: string;
  ratio?: string;
  src?: string;
}

const {
  id,
  label,
  note,
  ratio = "16 / 10",
  src,
} = Astro.props;

const hasImage = Boolean(src);
---

<figure class="screenshot">

  <div
    class:list={["frame", { "has-image": hasImage }]}
    style={hasImage ? undefined : `aspect-ratio: ${ratio};`}
  >

    {
      src ? (
        <button
          type="button"
          class="image-trigger"
          data-lightbox
        >
          <img
            class="image"
            src={src}
            alt={label}
            loading="lazy"
            decoding="async"
          />
        </button>
      ) : (
        <>
          <div class="chrome" aria-hidden="true">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>

          <div class="marker">

            <span class="asset-id">
              {id}
            </span>

            <span class="asset-label">
              {label}
            </span>

          </div>
        </>
      )
    }

  </div>

  <figcaption>

    <span class="caption-id">
      {id}
    </span>

    <span class="caption-label">
      {label}
    </span>

    {
      note && (
        <span class="caption-note">
          {note}
        </span>
      )
    }

  </figcaption>

</figure>


<style>

.screenshot {
  margin: var(--space-lg) 0;
}


.frame {

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  width: 100%;

  border: 1px dashed var(--color-border);

  border-radius: var(--radius-md);

  background:

    repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      var(--color-bg-secondary) 10px,
      var(--color-bg-secondary) 20px
    );

}


.frame.has-image {

  border-style: solid;

  background: var(--color-bg-secondary);

  overflow: hidden;

}


.image-trigger {

  display: block;

  width: 100%;

  padding: 0;

  border: 0;

  background: none;

  cursor: zoom-in;

  overflow: hidden;

}


.image-trigger:focus-visible {

  outline: 2px solid var(--color-accent);

  outline-offset: -2px;

}


.image {

  display: block;

  width: 100%;

  height: auto;

  transition: transform .45s cubic-bezier(.2, .7, .3, 1);

}


.image-trigger:hover .image,
.image-trigger:focus-visible .image {

  transform: scale(1.04);

}


@media (prefers-reduced-motion: reduce) {

  .image {

    transition: none;

  }


  .image-trigger:hover .image,
  .image-trigger:focus-visible .image {

    transform: none;

  }

}


.chrome {

  position: absolute;

  top: var(--space-sm);

  left: var(--space-sm);

  display: flex;

  gap: 6px;

}


.dot {

  width: 8px;

  height: 8px;

  border-radius: 50%;

  background: var(--color-border);

}


.marker {

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: var(--space-xs);

  padding: 0 var(--space-md);

  text-align: center;

}


.asset-id {

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  color: var(--color-accent);

  letter-spacing: 0.05em;

}


.asset-label {

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: var(--line-height-body);

}


figcaption {

  display: flex;

  align-items: baseline;

  flex-wrap: wrap;

  gap: var(--space-sm);

  margin-top: var(--space-sm);

}


.caption-id {

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  color: var(--color-accent);

  letter-spacing: 0.05em;

}


.caption-label {

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

}


.caption-note {

  flex-basis: 100%;

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  font-style: italic;

  opacity: 0.8;

}

</style>
