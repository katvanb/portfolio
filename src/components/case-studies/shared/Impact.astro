---
import SectionHeading from "../shared/SectionHeading.astro";
import DataTable from "../shared/DataTable.astro";

interface Props {
  eyebrow?: string;
  number?: string;
  title: string;
  limitationTitle: string;
  limitation: string;
  columns: string[];
  rows: string[][];
  tableNote: string;
  evolutionTitle: string;
  evolution: string[];
  pendingTitle: string;
  pending: string[];
  quoteLabel: string;
  quote: string;
}

const {
  eyebrow,
  number,
  title,
  limitationTitle,
  limitation,
  columns,
  rows,
  tableNote,
  evolutionTitle,
  evolution,
  pendingTitle,
  pending,
  quoteLabel,
  quote,
} = Astro.props;
---

<section class="impact" id="impact">

  <SectionHeading number={number} title={title} eyebrow={eyebrow} />

  <div class="limitation">

    <span class="limitation-label">
      {limitationTitle}
    </span>

    <p class="limitation-text">
      {limitation}
    </p>

  </div>

  <DataTable
    columns={columns}
    rows={rows}
    emphasis={[0]}
    note={tableNote}
  />

  <h3 class="sub-title">
    {evolutionTitle}
  </h3>

  <ul class="evolution">
    {
      evolution.map((item) => (
        <li>{item}</li>
      ))
    }
  </ul>

  <h3 class="sub-title">
    {pendingTitle}
  </h3>

  <ul class="pending">
    {
      pending.map((item) => (
        <li>{item}</li>
      ))
    }
  </ul>

  <figure class="quote">

    <blockquote>
      {quote}
    </blockquote>

    <figcaption>
      {quoteLabel}
    </figcaption>

  </figure>

</section>


<style>

.impact {
  margin-top: var(--section-spacing);
}


.limitation {

  margin-bottom: var(--gap-elements);

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  background: var(--color-bg-callout);

  border-radius: var(--radius-callout);
}


.limitation-label {

  display: block;

  margin-bottom: var(--gap-label);

  color: var(--color-accent);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  line-height: var(--line-height-label);
}


.limitation-text {

  max-width: 800px;

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--font-size-body);

  line-height: var(--line-height-body);
}


.sub-title {

  margin: var(--gap-blocks) 0 var(--gap-elements);

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);
}


.evolution,
.pending {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 0;

  margin: 0;

  padding: 0;

  list-style: none;

  border-top: 1px solid var(--color-border);

  border-left: 1px solid var(--color-border);
}


.evolution li,
.pending li {

  padding: var(--padding-table-cell);

  border-right: 1px solid var(--color-border);

  border-bottom: 1px solid var(--color-border);

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  line-height: var(--line-height-small);
}


.quote {

  margin: var(--gap-blocks) 0 0;

  padding: var(--padding-callout);

  border-left: var(--border-callout) solid var(--color-accent);

  border-radius: var(--radius-callout);

  background: var(--color-bg-callout);
}


.quote blockquote {

  margin: 0;

  color: var(--color-text-primary);

  font-family: var(--font-display);

  font-size: var(--font-size-h2);

  line-height: var(--line-height-h2);

  font-weight: var(--weight-bold);
}


.quote figcaption {

  margin-top: var(--gap-label);

  color: var(--color-text-secondary);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  letter-spacing: 0;
}

@media (max-width: 768px) {

  .evolution,
  .pending {

    grid-template-columns: 1fr;

  }

}

</style>
