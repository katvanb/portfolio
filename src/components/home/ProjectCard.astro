---
interface Props {
  title: string;
  tags: string[];
  link: string;
  image: string;
  action: string;
}

const { title, tags, link, image, action } = Astro.props;
---

<a href={link} class="card" data-cursor-text={action}>

  <div class="thumb">
    <p class="tags">
      {tags.join(" • ")}
    </p>

    <img
      src={image}
      alt={title}
      loading="lazy"
    />
  </div>

  <h3 class="title">
    {title}
  </h3>

</a>


<style>

.card {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);
}


.thumb {

  position: relative;

  border: 1px solid var(--color-border);

  background: var(--color-bg-secondary);
}


.tags {

  position: absolute;

  top: 0;

  left: 0;

  right: 0;

  padding: var(--space-sm);

  margin: 0;

  font-family: "Courier New", Courier, monospace;

  font-size: var(--font-size-small);

  letter-spacing: 0.05em;

  color: #fff;

  text-transform: uppercase;

  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.55),
    transparent
  );

}


.thumb img {

  display: block;

  width: 100%;

  aspect-ratio: 4 / 3;

  object-fit: cover;
}


.title {

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  margin-bottom: 0;
}

</style>