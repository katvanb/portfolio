---
interface Props {
  title: string;
  tags: string[];
  link: string;
  image: string;
  action: string;
}

const { title, tags, link, image, action } = Astro.props;
---

<a href={link} class="card" data-cursor-text={action}>

  <div class="media">

    <img
      src={image}
      alt={title}
      loading="lazy"
    />


    <div class="tags">

      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}

    </div>


    <div class="shade" aria-hidden="true"></div>


    <h3 class="title">
      {title}
    </h3>

  </div>

</a>


<style>

.card {

  display: block;

  min-width: 0;

}


.media {

  position: relative;

  aspect-ratio: 366 / 250;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-image-lg);

  overflow: hidden;

  background: var(--color-bg-secondary);

}


.media img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform .5s ease;

}


.card:hover .media img {

  transform: scale(1.03);

}


.tags {

  position: absolute;

  top: var(--gap-grid);
  left: var(--gap-grid);
  right: var(--gap-grid);

  display: flex;

  flex-wrap: wrap;

  gap: var(--gap-grid);

  z-index: 2;

}


.tag {

  padding: 4px 8px;

  border-radius: var(--radius-full);

  background: rgba(255, 255, 255, .92);

  color: var(--color-text-secondary);

  font-family: var(--font-body);

  font-size: var(--font-size-small);

  font-weight: var(--weight-medium);

  line-height: 1.2;

  white-space: nowrap;

}


.shade {

  position: absolute;

  inset: 0;

  background: linear-gradient(
    to top,
    rgba(0, 0, 0, .62),
    rgba(0, 0, 0, 0) 55%
  );

  z-index: 1;

}


.title {

  position: absolute;

  left: var(--space-sm);
  right: var(--space-sm);
  bottom: 14px;

  margin: 0;

  color: #F9F9FB;

  font-family: var(--font-display);

  font-size: var(--font-size-h3);

  line-height: 1.2;

  font-weight: var(--weight-medium);

  letter-spacing: 0;

  z-index: 2;

}

</style>
