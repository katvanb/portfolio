---
interface Props {
  title: string;
  link: string;
  image: string;
  action: string;
}

const { title, link, image, action } = Astro.props;
---

<a href={link} class="card" data-cursor-text={action}>

  <div class="thumb">
    <img
      src={image}
      alt={title}
      loading="lazy"
    />
  </div>

  <h3 class="title">
    {title}
  </h3>

</a>


<style>

.card {

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

  transition: transform .2s ease;
}

.card:hover {
  transform: translateY(-4px);
}


.thumb {

  border: 1px solid var(--color-border);

  border-radius: var(--radius-md);

  overflow: hidden;

  background: var(--color-bg-secondary);
}


.thumb img {

  display: block;

  width: 100%;

  aspect-ratio: 4 / 3;

  object-fit: cover;
}


.title {

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);
}

</style>