---
interface Props {
  title: string;
  tags: string[];
  link: string;
  image: string;
  action: string;
}

const { title, tags, link, image, action } = Astro.props;
---

<a href={link} class="card" data-cursor-text={action}>

  <div class="media">

    <img
      src={image}
      alt={title}
      loading="lazy"
    />


    <div class="tags">

      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}

    </div>


    <div class="shade" aria-hidden="true"></div>


    <h3 class="title">
      {title}
    </h3>

  </div>

</a>


<style>

.card {

  display: block;

  min-width: 0;

}


.media {

  position: relative;

  aspect-ratio: 366 / 250;

  border-radius: 8px;

  overflow: hidden;

  background: var(--color-bg-secondary);

}


.media img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform .5s ease;

}


.card:hover .media img {

  transform: scale(1.03);

}


.tags {

  position: absolute;

  top: 8px;
  left: 16px;
  right: 16px;

  display: flex;

  flex-wrap: wrap;

  gap: 6px;

  z-index: 2;

}


.tag {

  padding: 2px 5px;

  border-radius: 999px;

  background: rgba(249, 249, 251, .92);

  color: #64748B;

  font-family: var(--font-family-ui);

  font-size: 9px;

  line-height: 1.2;

  white-space: nowrap;

}


.shade {

  position: absolute;

  inset: 0;

  background: linear-gradient(
    to top,
    rgba(0, 0, 0, .62),
    rgba(0, 0, 0, 0) 55%
  );

  z-index: 1;

}


.title {

  position: absolute;

  left: 16px;
  right: 16px;
  bottom: 14px;

  margin: 0;

  color: #F9F9FB;

  font-size: 19px;

  line-height: 21px;

  font-weight: 500;

  letter-spacing: -0.01em;

  z-index: 2;

}

</style>
