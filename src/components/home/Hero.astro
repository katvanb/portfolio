---

interface Props {

  content: {

    title: string;

    paragraphs: string[];

  };

}


const { content } = Astro.props;

---


<section class="hero">

  <div class="hero-text">

    <h2>

      {content.title}

    </h2>

    {content.paragraphs.map((paragraph) => (
      <p class="description" set:html={paragraph} />
    ))}

  </div>


  <div class="hero-visual no-image" aria-hidden="true">

    <span class="visual-initials">KG</span>

  </div>

</section>


<style>

.hero {

  display: grid;

  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);

  gap: var(--space-2xl);

  align-items: center;

  padding: var(--space-2xl) 0;

  max-width: 1100px;
}


/* =========================
   Text column
========================= */

.hero-text {
  min-width: 0;
}
h2 {

  font-size: var(--font-size-h2);

  line-height: var(--line-height-h2);

  font-weight: var(--font-weight-h2);

  letter-spacing: var(--letter-spacing-h2);

  margin-bottom: var(--space-lg);

}


.description {

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: var(--line-height-body-lg);

  max-width: 650px;

}


.description + .description {

  margin-top: var(--space-sm);

}
/* =========================
   Visual column (placeholder)
========================= */

.hero-visual {

  aspect-ratio: 4 / 5;

  border-radius: var(--radius-md);

  border: 1px solid var(--color-border);

  background:
    radial-gradient(
      circle at 30% 20%,
      var(--color-accent-soft),
      transparent 60%
    ),
    var(--color-bg-secondary);

  display: grid;

  place-items: center;
}


.visual-initials {

  font-size: var(--font-size-display);

  font-weight: 600;

  letter-spacing: -0.03em;

  color: var(--color-accent);

  opacity: .5;
}


/* =========================
   Typewriter
========================= */

/* Estilos globales en src/styles/global.css */


/* =========================
   Responsive
========================= */
@media (max-width: 768px) {

  .hero {

    grid-template-columns: 1fr;

    gap: var(--space-xl);

    padding: var(--space-2xl) 0;

  }


  .hero-visual {
    display: none;
  }

}

</style>


<script>

const typewriter =
  document.querySelector(".hero-typewriter");


if (typewriter) {

  const textEl = typewriter.querySelector(".tw-text");

  const raw =
    typewriter.getAttribute("data-words") || "";

  const words =
    raw.split("|").map((w) => w.trim()).filter(Boolean);


  const TYPE_DELAY = 90;
  const DELETE_DELAY = 45;
  const HOLD_TYPED = 2000;
  const HOLD_EMPTY = 400;


  let index = 0;
  let deleting = false;


  const tick = () => {

    const word = words[index];
    const current = textEl ? textEl.textContent || "" : "";


    if (deleting) {

      if (current.length === 0) {

        deleting = false;

        index = (index + 1) % words.length;

        window.setTimeout(tick, HOLD_EMPTY);

        return;

      }


      if (textEl) {
        textEl.textContent = current.slice(0, -1);
      }

      window.setTimeout(tick, DELETE_DELAY);

      return;

    }


    if (current.length === word.length) {

      deleting = true;

      window.setTimeout(tick, HOLD_TYPED);

      return;

    }


    if (textEl) {
      textEl.textContent = word.slice(0, current.length + 1);
    }

    window.setTimeout(tick, TYPE_DELAY);

  };


  if (words.length > 0) {
    window.setTimeout(tick, 800);
  }

}

</script>