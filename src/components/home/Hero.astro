---
interface Props {
  content: {
    eyebrow: string;
    name: string;
    paragraphs: string[];
  };
}

const { content } = Astro.props;
---


<section class="hero">

  <div class="hero-visual">
    <img
      src={`${import.meta.env.BASE_URL}images/home/profile.jpg`}
      alt={content.name}
      width={140}
      height={140}
      loading="eager"
      decoding="async"
    />
  </div>


  <div class="hero-text">

    <p class="eyebrow">
      {content.eyebrow}
    </p>

    <h1 class="name">
      {content.name}
    </h1>

  </div>


  <div class="paragraphs">
    {content.paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </div>

</section>


<style>

.hero {

  display: grid;

  grid-template-columns: 140px minmax(0, 1fr);

  column-gap: 16px;
  row-gap: 2px;

  align-items: start;

  padding: 0 0 72px;

}


.hero-visual {

  width: 140px;

  aspect-ratio: 1;

  border-radius: 12px;

  overflow: hidden;

  background: var(--color-bg-secondary);

}


.hero-visual img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

}


.hero-text {

  min-width: 0;

}


.name {

  margin: 8px 0 0;

  font-size: 47px;

  line-height: 1.05;

  font-weight: 500;

  letter-spacing: -0.03em;

  color: var(--color-accent);

}


.paragraphs {

  grid-column: 1 / -1;

}


.paragraphs p {

  color: var(--color-text-secondary);

  font-size: 21px;

  line-height: 23px;

  overflow-wrap: break-word;

}


.paragraphs p + p {

  margin-top: 23px;

}


@media (max-width: 768px) {

  .hero {

    grid-template-columns: 1fr;

    row-gap: 16px;

    padding: 0 0 64px;

  }


  .hero-visual {

    width: 120px;

  }


  .name {

    margin-top: 6px;

    font-size: clamp(36px, 11vw, 47px);

  }


  .paragraphs p {

    font-size: 18px;

    line-height: 26px;

  }


  .paragraphs p + p {

    margin-top: 18px;

  }

}

</style>
