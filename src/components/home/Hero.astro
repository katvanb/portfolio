---
interface Props {
  content: {
    eyebrow: string;
    name: string;
    paragraphs: string[];
  };
}

const { content } = Astro.props;
---


<section class="hero">

  <div class="hero-visual">
    <img
      src={`${import.meta.env.BASE_URL}images/home/profile.jpg`}
      alt={content.name}
      width={140}
      height={140}
      loading="eager"
      decoding="async"
    />
  </div>


  <div class="hero-text">

    <p class="eyebrow">
      {content.eyebrow}
    </p>

    <h1 class="name">
      {content.name}
    </h1>

  </div>


  <div class="paragraphs">
    {content.paragraphs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </div>

</section>


<style>

.hero {

  display: grid;

  grid-template-columns: 140px minmax(0, 1fr);

  column-gap: 16px;
  row-gap: 2px;

  align-items: start;

  padding: 0 0 var(--gap-blocks);

}


.hero-visual {

  width: 140px;

  aspect-ratio: 1;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-avatar);

  overflow: hidden;

  background: var(--color-bg-secondary);

}


.hero-visual img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

}


.hero-text {

  min-width: 0;

}


.name {

  margin: var(--gap-label) 0 0;

  font-size: var(--font-size-h1);

  line-height: var(--line-height-h1);

  font-weight: var(--weight-medium);

  letter-spacing: var(--letter-spacing-h1);

  color: var(--color-highlight);

}


.paragraphs {

  grid-column: 1 / -1;

}


.paragraphs p {

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

  line-height: var(--line-height-body);

  overflow-wrap: break-word;

}


.paragraphs p + p {

  margin-top: var(--space-md);

}


@media (max-width: 768px) {

  .hero {

    grid-template-columns: 1fr;

    row-gap: 16px;

    padding: 0 0 var(--gap-blocks);

  }


  .hero-visual {

    width: 120px;

  }


  .name {

    margin-top: var(--gap-label);

    font-size: clamp(32px, 10vw, 40px);

  }


  .paragraphs p {

    font-size: var(--font-size-body);

    line-height: var(--line-height-body);

  }


  .paragraphs p + p {

    margin-top: var(--space-md);

  }

}

</style>
