---
import ProjectCard from "./ProjectCard.astro";

interface Project {
  title: string;
  tags: string[];
  link: string;
  image: string;
}

interface Props {
  content: {
    eyebrow: string;
    projects: Project[];
    action: string;
  };
}

const { content } = Astro.props;
---


<section id="work" class="work">

  <p class="eyebrow">
    {content.eyebrow}
  </p>


  <div class="projects">

    {
      content.projects.map((project) => (

        <ProjectCard
          title={project.title}
          tags={project.tags}
          link={project.link}
          image={project.image}
          action={content.action}
        />

      ))
    }

  </div>

</section>


<style>

.work {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);

  padding: 0 0 var(--gap-blocks);

  container-type: inline-size;

}


.projects {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: var(--gap-cards);

}


/* Between the desktop and mobile layouts the sidebar narrows the content
   enough that two cards per row would crush the tags and titles. */

@container (max-width: 640px) {

  .projects {

    grid-template-columns: 1fr;

  }

}

</style>
