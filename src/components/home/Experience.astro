---
interface Entry {
  role: string;
  company: string;
  period: string;
  summary?: string;
}

interface Props {
  content: {
    eyebrow: string;
    entries: Entry[];
  };
}

const { content } = Astro.props;
---


<section class="experience">

  <p class="eyebrow">
    {content.eyebrow}
  </p>


  <ol class="entries">

    {
      content.entries.map((entry) => (

        <li class="entry">

          <span class="period">
            {entry.period}
          </span>


          <div class="detail">

            <h3 class="role">
              {entry.role}
            </h3>

            <p class="company">
              {entry.company}
            </p>

            {
              entry.summary && (
                <p class="summary">
                  {entry.summary}
                </p>
              )
            }

          </div>

        </li>

      ))
    }

  </ol>

</section>


<style>

.experience {

  display: flex;

  flex-direction: column;

  gap: var(--gap-elements);

  padding: 0 0 var(--gap-blocks);

}


.entries {

  list-style: none;

  margin: 0;
  padding: 0;

}


.entry {

  display: grid;

  grid-template-columns: max-content minmax(0, 1fr);

  column-gap: 24px;

  padding: 22px 0;

  border-top: 1px solid var(--color-border);

  border-top-color: color-mix(
    in srgb,
    var(--color-border) 55%,
    transparent
  );

}


.entry:first-child {

  padding-top: 0;

  border-top: 0;

}


.period {

  padding-top: 3px;

  color: var(--color-text-muted);

  font-family: var(--font-mono);

  font-size: 1rem;

  text-transform: uppercase;

  font-weight: var(--weight-medium);

  line-height: 1.3;

  letter-spacing: 0;

  font-variant-numeric: tabular-nums;

}


.role {

  margin: 0;

  color: var(--color-text-primary);

  font-size: var(--font-size-h3);

  line-height: var(--line-height-h3);

  font-weight: var(--weight-medium);

  letter-spacing: 0;

}


.company {

  margin-top: 4px;

  color: var(--color-text-secondary);

  font-family: var(--font-body);

  font-size: var(--font-size-small);

  line-height: 1.4;

}


.summary {

  max-width: 560px;

  margin-top: var(--space-xs);

  color: var(--color-text-secondary);

  font-size: var(--font-size-small);

  line-height: var(--line-height-small);

}


@media (max-width: 640px) {

  .experience {

    padding: 0 0 64px;

  }


  .entry {

    grid-template-columns: 1fr;

    row-gap: 6px;

    padding: 20px 0;

  }


  .period {

    order: -1;

    padding-top: 0;

  }


  .role {

    font-size: var(--font-size-h3);

  }


  .summary {

    font-size: var(--font-size-small);

    line-height: var(--line-height-small);

  }

}

</style>
