---
interface Props {

  content: {

    eyebrow: string;

    title: string;

    description: string;

    link: string;

    action: string;

  };

}

const { content } = Astro.props;
---


<section class="about">

  <div class="content">

    <p class="eyebrow">
      {content.eyebrow}
    </p>


    <h2>
      {content.title}
    </h2>


    <p class="description">
      {content.description}
    </p>


    <a href={content.link} class="link">
      {content.action} →
    </a>

  </div>

</section>


<style>

.about {

  padding: var(--space-2xl) 0;

  border-top: 1px solid var(--color-border);

}


.content {

  max-width: 750px;

}


.eyebrow {

  color: var(--color-accent);

  font-size: var(--font-size-small);

  letter-spacing: .1em;

  margin-bottom: var(--space-md);

}


h2 {

  font-size: var(--font-size-h2);

  line-height: 1.2;

  margin-bottom: var(--space-lg);

}


.description {

  color: var(--color-text-secondary);

  font-size: var(--font-size-body-lg);

  line-height: 1.6;

  margin-bottom: var(--space-lg);

}


.link {

  font-weight: 500;

}

</style>