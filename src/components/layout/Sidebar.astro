---
import {
  FileCode2,
  FileText,
  FolderOpen,
  Folder,
  ChevronDown,
  ChevronRight,
} from "lucide-astro";

interface Props {
  content: {
    files: string;
  };
}

const { content } = Astro.props;

const pathname = Astro.url.pathname;

const base = import.meta.env.BASE_URL;

// BASE_URL ya viene con barra final ("/portfolio/"). La quitamos para poder
// componer prefijos sin generar una barra doble.
const baseRoot = base.replace(/\/+$/, "");

const esPrefix = `${baseRoot}/es/`;
const frPrefix = `${baseRoot}/fr/`;

// Comparacion por segmento, no por subcadena.
const isSpanish =
  pathname === `${baseRoot}/es` || pathname.startsWith(esPrefix);
const isFrench =
  pathname === `${baseRoot}/fr` || pathname.startsWith(frPrefix);

const prefix = isFrench ? frPrefix : isSpanish ? esPrefix : base;

const isHome = pathname === base || pathname === baseRoot;

const activeFile = pathname.includes("/work/b2b-commerce")
  ? "b2b-commerce"
  : pathname.includes("/work/credential-platform")
    ? "credential-platform"
    : isHome
      ? "home"
      : null;
---

<aside class="sidebar" id="sidebar">

  <nav class="tree" aria-label={content.files}>

    <a
      href={prefix}
      class:list={{ row: true, file: true, active: activeFile === "home" }}
    >
      <FileCode2 size={16} />

      <span>index.html</span>
    </a>


    <button
      class="row folder"
      id="folder-toggle"
      aria-expanded="true"
      aria-controls="folder-children"
    >
      <ChevronDown class="chevron chevron-open" size={12} />
      <ChevronRight class="chevron chevron-closed" size={12} />

      <FolderOpen class="folder-open-icon" size={16} />
      <Folder class="folder-closed-icon" size={16} />

      <span>work/</span>
    </button>


    <div class="folder-children" id="folder-children">

      <a href={`${prefix}#work`} class="row file child">
        <FileText size={16} />

        <span>selected-work</span>
      </a>

      <a
        href={`${prefix}work/b2b-commerce/`}
        class:list={{
          row: true,
          file: true,
          child: true,
          active: activeFile === "b2b-commerce",
        }}
      >
        <FileText size={16} />

        <span>b2b-commerce.md</span>
      </a>

      <a
        href={`${prefix}work/credential-platform/`}
        class:list={{
          row: true,
          file: true,
          child: true,
          active: activeFile === "credential-platform",
        }}
      >
        <FileText size={16} />

        <span>credential-platform.md</span>
      </a>

    </div>

  </nav>

</aside>


<style>

.sidebar {

  position: fixed;

  top: var(--topbar-height);
  left: 0;

  height: calc(100vh - var(--topbar-height) - var(--footer-height));

  width: var(--current-sidebar, var(--sidebar-width));

  box-sizing: border-box;

  background: var(--color-chrome);

  border-right: 1px solid var(--color-border);

  padding: 56px 24px 24px;

  overflow-y: auto;

  transition:
    width .3s ease,
    padding .3s ease;

  z-index: 200;

}


.tree {

  display: flex;

  flex-direction: column;

  gap: 16px;

}


.row {

  display: flex;

  align-items: center;

  gap: 8px;

  width: 100%;
  height: 40px;

  padding: 0 16px;

  background: transparent;

  border: none;

  border-radius: 8px;

  font-family: var(--font-family-ui);

  font-size: 15px;

  font-weight: 400;

  line-height: 1.2;

  text-align: left;

  color: var(--color-text-secondary);

  cursor: pointer;

  white-space: nowrap;

  transition:
    background .15s ease,
    color .15s ease;

}


.row svg {

  flex-shrink: 0;

  opacity: .72;

}


.row:hover {

  background: var(--color-bg-primary);

  color: var(--color-text-primary);

}


.row.active {

  background: #D4DDE6;

  color: var(--color-text-primary);

}


:global([data-theme="dark"]) .row.active {

  background: #26303B;

}


.row.active svg {

  color: inherit;

  opacity: 1;

}


.folder {

  color: var(--color-text-secondary);

}


.folder .chevron {

  margin-right: 4px;

  opacity: .55;

}


.folder-children {

  display: flex;

  flex-direction: column;

  gap: 16px;

  padding-left: 0;

}


.folder-children .row.child {

  padding-left: 40px;

}


.folder-children[hidden] {

  display: none;

}


.folder-closed-icon,
.chevron-closed {

  display: none;

}


.folder.collapsed .folder-open-icon,
.folder.collapsed .chevron-open {

  display: none;

}


.folder.collapsed .folder-closed-icon,
.folder.collapsed .chevron-closed {

  display: block;

}


/* Collapsed state: empty strip, as in the design */

.sidebar.collapsed {

  width: 0;

  padding: 0;

  overflow: hidden;

  border-right: 1px solid var(--color-border);

}


.sidebar.collapsed .tree {

  display: none;

}


.sidebar.no-transition {

  transition: none;

}


/* ========================================
   Mobile
======================================== */

@media (max-width: 768px) {

  .sidebar {

    top: var(--topbar-height);

    width: 100%;

    height: calc(100dvh - var(--topbar-height) - var(--footer-height));

    padding: 24px;

    border-right: none;

    border-bottom: 1px solid var(--color-border);

    display: none;

    z-index: 250;

  }


  .sidebar.mobile-open {

    display: block;

  }


  .sidebar.collapsed {

    width: 100%;

    padding: 24px;

    overflow-y: auto;

  }


  .sidebar.collapsed .tree {

    display: flex;

  }

}

</style>


<script>

const sidebar = document.getElementById("sidebar");
const toggle = document.getElementById("sidebar-toggle");
const layout = document.querySelector(".layout");

const isMobile =
  window.matchMedia("(max-width: 768px)").matches;


// =========================
// Sidebar initial state
// =========================

const sidebarHasBeenUsed =
  localStorage.getItem("sidebar-used") === "true";


if (!isMobile && sidebarHasBeenUsed) {

  sidebar?.classList.add("collapsed");

  layout?.classList.add("collapsed");

  toggle?.setAttribute("aria-expanded", "false");

}


// =========================
// Toggle
// =========================

toggle?.addEventListener("click", () => {

  if (!sidebar) return;


  // Mobile

  if (isMobile) {

    const isOpen =
      sidebar.classList.toggle("mobile-open");

    toggle.setAttribute(
      "aria-expanded",
      String(isOpen)
    );

    return;

  }


  // Desktop

  const isCollapsed =
    sidebar.classList.toggle("collapsed");

  layout?.classList.toggle(
    "collapsed",
    isCollapsed
  );

  toggle.setAttribute(
    "aria-expanded",
    String(!isCollapsed)
  );

});


// =========================
// Auto-collapse on scroll
// =========================

window.addEventListener(
  "scroll",
  () => {

    if (!sidebar) return;

    // Mobile no usa auto-collapse
    if (isMobile) return;

    if (window.scrollY <= 20) return;

    if (!sidebar.classList.contains("collapsed")) {

      sidebar.classList.add("collapsed");

      layout?.classList.add("collapsed");

      toggle?.setAttribute("aria-expanded", "false");

    }

    localStorage.setItem(
      "sidebar-used",
      "true"
    );

  },
  { passive: true }
);


// =========================
// Folder
// =========================

const folderToggle = document.getElementById("folder-toggle");
const folderChildren = document.getElementById("folder-children");


const setFolderOpen = (open: boolean) => {

  folderChildren?.toggleAttribute("hidden", !open);

  folderToggle?.classList.toggle("collapsed", !open);

  folderToggle?.setAttribute(
    "aria-expanded",
    String(open)
  );

  localStorage.setItem(
    "work-folder-open",
    String(open)
  );

};


if (folderToggle && folderChildren) {

  const savedFolder =
    localStorage.getItem("work-folder-open");

  setFolderOpen(savedFolder !== "false");


  folderToggle.addEventListener("click", () => {

    setFolderOpen(
      folderChildren.hasAttribute("hidden")
    );

  });

}


// =========================
// Smooth scroll to #work
// =========================

const workLinks = document.querySelectorAll('a[href$="#work"]');

workLinks.forEach((workLink) => {

  workLink.addEventListener("click", (event) => {

    const target = document.getElementById("work");

    // Estamos en Home

    if (target) {

      event.preventDefault();

      const start = window.scrollY;
      const offset = 80;

      const end =
        target.getBoundingClientRect().top +
        window.scrollY -
        offset;

      const distance = end - start;
      const duration = 1100;

      let startTime: number | null = null;

      const easeInOut = (t: number) => {

        return t < 0.5
          ? 2 * t * t
          : 1 - Math.pow(-2 * t + 2, 2) / 2;

      };

      const animateScroll = (currentTime: number) => {

        if (startTime === null) {
          startTime = currentTime;
        }

        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);

        window.scrollTo(
          0,
          start + distance * easeInOut(progress)
        );

        if (progress < 1) {
          requestAnimationFrame(animateScroll);
        }

      };

      requestAnimationFrame(animateScroll);

      return;

    }


    // Estamos en otra página

    event.preventDefault();

    sessionStorage.setItem(
      "scroll-to-work",
      "true"
    );

    const href = workLink.getAttribute("href");

    if (!href) return;

    // Quitamos #work para evitar que el navegador
    // salte directamente a la sección.

    const homeUrl = href.split("#")[0];

    window.location.href = homeUrl || "/";

  });

});


// Si venimos de otra página hacia Work

window.addEventListener("load", () => {

  const shouldScroll =
    sessionStorage.getItem("scroll-to-work");


  if (!shouldScroll) return;


  const target =
    document.getElementById("work");


  if (!target) return;


  sessionStorage.removeItem("scroll-to-work");


  setTimeout(() => {

    const start = window.scrollY;
    const offset = 80;

    const end =
      target.getBoundingClientRect().top +
      window.scrollY -
      offset;

    const distance = end - start;
    const duration = 1100;

    let startTime: number | null = null;


    const easeInOut = (t: number) => {
      return t < 0.5
        ? 2 * t * t
        : 1 - Math.pow(-2 * t + 2, 2) / 2;
    };


    const animateScroll = (currentTime: number) => {

      if (startTime === null) {
        startTime = currentTime;
      }

      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);


      window.scrollTo(
        0,
        start + distance * easeInOut(progress)
      );


      if (progress < 1) {
        requestAnimationFrame(animateScroll);
      }

    };


    requestAnimationFrame(animateScroll);

  }, 100);

});

</script>
