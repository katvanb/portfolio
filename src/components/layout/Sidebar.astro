---
import { Sun, Moon, Mail, Linkedin, Download, ArrowLeft, ArrowRight, Menu, X, Check } from "lucide-astro";
import LanguageSelector from "../navigation/LanguageSelector.astro";
import AccentPicker from "../navigation/AccentPicker.astro";
import en from "../../i18n/en";
import es from "../../i18n/es";

const pathname = Astro.url.pathname;

const isSpanish = pathname.includes("/es");

const t = isSpanish ? es : en;

const base = import.meta.env.BASE_URL;

const prefix = isSpanish
  ? `${base}/es/`
  : `${base}/`;
---


<aside class="sidebar" id="sidebar">

  <div class="top">

    <button
      class="toggle"
      id="sidebar-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <ArrowLeft class="arrow-open" size={18} />
      <ArrowRight class="arrow-close" size={18} />

      <Menu class="mobile-menu-icon" size={22} />
      <X class="mobile-close-icon" size={22} />
    </button>


    <a href={`${prefix}/`} class="profile">

      <div class="avatar">
        KG
      </div>


      <div class="info">
        <h1>
          Katherine Gaspare
        </h1>

        <p>
          Product Designer + Systems Engineer
        </p>
      </div>

    </a>

  </div>


  <nav class="navigation">

    <nav class="navigation">

      <a href={`${prefix}#work`}>
        {t.sidebar.navigation.work}
      </a>

      <a href={`${prefix}about`}>
        {t.sidebar.navigation.about}
      </a>

      <a href={`${prefix}experiments`}>
        {t.sidebar.navigation.experiments}
      </a>

      <a href={`${prefix}writing`}>
        {t.sidebar.navigation.writing}
      </a>

    </nav>

  </nav>


  <div class="bottom">

    <div class="actions">

      <div class="preferences">

        <button
          class="icon-button"
          id="theme-toggle"
          aria-label="Toggle theme"
        >
          <Moon id="theme-moon" size={18} />
          <Sun id="theme-sun" size={18} />
        </button>

        <AccentPicker />

        <LanguageSelector />

      </div>


      <a
        href={`${import.meta.env.BASE_URL}Katherine-Gaspare-CV.pdf`}
        class="cv-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Download size={16} />

        <span>
          {t.sidebar.actions.downloadCV}
        </span>
      </a>

    </div>


    <div class="contact">

      <a 
        href="https://www.linkedin.com/in/katherine-gaspare/"
        target="_blank"
        rel="noopener noreferrer"
        class="linkedin"
        aria-label={t.sidebar.actions.linkedin}
      >
        <Linkedin size={18} />

        <span>
          {t.sidebar.actions.linkedin}
        </span>
      </a>


      <span class="separator">
        |
      </span>


      <button 
        class="email"
        id="email-button"
        aria-label={t.sidebar.actions.email}
      >

        <Mail class="email-icon" size={18} />
        <Check class="email-check" size={18} />

        <span>
          {t.sidebar.actions.email}
        </span>
      </button>

    </div>

  </div>


</aside>


<style>

.sidebar {

  position: fixed;

  top: 0;

  left: 0;

  height: 100vh;

  width: var(--sidebar-width);

  background: var(--color-bg-secondary);

  box-sizing: border-box;

  border-right: 1px solid var(--color-border);

  padding: var(--space-lg);

  display: flex;

  flex-direction: column;

  gap: var(--space-xl);

  transition: width .3s ease,
              padding .3s ease;

  z-index: 100;

}


.toggle {

  background: transparent;

  border: none;

  color: var(--color-text-secondary);

  cursor: pointer;

  margin-bottom: var(--space-md);

}


.profile {

  display: flex;

  align-items: center;

  gap: 10px;

}


.info {

  min-width: 0;

  max-width: 150px;

}


.info h1 {

  font-size: 15px;

  line-height: 1.2;

  letter-spacing: -0.01em;

  font-weight: 600;

}


.info p {

  color: var(--color-text-secondary);

  font-size: 12px;

  line-height: 1.3;

}


.avatar {

  width: 40px;

  height: 40px;

  flex-shrink: 0;

  border-radius: 50%;

  background: var(--color-accent);

  display: grid;

  place-items: center;

  font-weight: 600;

}


/* Navigation */

.navigation {

  display: flex;

  flex-direction: column;

  gap: var(--space-sm);

}


.navigation a {

  color: var(--color-text-secondary);

}


.navigation a:hover {

  color: var(--color-text-primary);

}


/* Bottom section */

.bottom {

  margin-top: auto;

  display: flex;

  flex-direction: column;

  gap: var(--space-lg);

}


/* Theme + Language + CV */

.actions {

  display: flex;

  flex-direction: column;

  gap: var(--space-md);

}


.preferences {

  display: flex;

  align-items: center;

  justify-content: flex-start;

  gap: var(--space-md);

}


.icon-button {

  width: 36px;

  height: 36px;

  display: grid;

  place-items: center;

  background: transparent;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-sm);

  cursor: pointer;

  color: var(--color-text-primary);

  transition: background .2s ease;

}


.icon-button:hover {

  background: var(--color-accent-soft);

}


#theme-moon {
  display: none;
}


/* Contact */

.contact {

  display: flex;

  flex-direction: row;

  align-items: center;

  gap: var(--space-sm);

  white-space: nowrap;

}


.contact a,
.contact button {

  background: none;

  border: none;

  padding: 0;

  margin: 0;

  color: var(--color-text-secondary);

  cursor: pointer;

  font-size: var(--font-size-body);

  font-family: inherit;

}


.contact a:hover,
.contact button:hover {

  color: var(--color-text-primary);

}


.actions a {

  color: var(--color-text-secondary);

}


.actions a:hover {

  color: var(--color-text-primary);

}


/* Collapsed state */

.sidebar.collapsed {

  width: var(--sidebar-collapsed);

  padding: var(--space-md);

  align-items: center;

}


/* Hide text content */

.sidebar.collapsed .info,
.sidebar.collapsed .navigation a,
.sidebar.collapsed .actions a {

  display: none;

}



/* Center avatar */

.sidebar.collapsed .profile {

  justify-content: center;

}


/* Center theme */

.sidebar.collapsed .preferences {

  justify-content: center;

  flex-direction: column;

  gap: var(--space-md);

}


/* Collapsed contact */

.sidebar.collapsed .bottom {

  gap: var(--space-md);

}


.sidebar.collapsed .contact {

  display: flex !important;

  flex-direction: column;

  gap: var(--space-md);

  align-items: center;

}


.sidebar.collapsed .separator {

  display: none;

}


.sidebar.collapsed .contact span {

  display: none;

}


.sidebar.collapsed .contact a,
.sidebar.collapsed .contact button {

  width: 36px;

  height: 36px;

  display: grid;

  place-items: center;

  border: 1px solid var(--color-border);

  border-radius: var(--radius-sm);

  color: var(--color-text-primary);

}


.sidebar.collapsed .contact a span,
.sidebar.collapsed .contact button span {

  display: none;

}


.cv-link,
.linkedin,
.email {

  display: flex;

  align-items: center;

  gap: var(--space-sm);

}


.arrow-close {
  display:none;
}


.sidebar.collapsed .arrow-open {
  display:none;
}


.sidebar.collapsed .arrow-close {
  display:block;
}


.sidebar.no-transition {
  transition: none;
}


/* ========================================
   Mobile navbar
======================================== */

.mobile-menu-icon,
.mobile-close-icon {
  display: none;
}

@media (max-width: 768px) {

  .sidebar {
    width: 100%;
    height: auto;

    top: 0;
    left: 0;

    padding: var(--space-md);

    display: block;

    border-right: none;
    border-bottom: 1px solid var(--color-border);

    background: var(--color-bg-secondary);

    z-index: 1000;

    transition:
      max-height .3s ease,
      padding .3s ease;
  }


  .sidebar .top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: var(--space-md);
  }


  .sidebar .profile {
    flex: 1;
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 10px;
  }


  .sidebar .avatar {
    width: 40px;
    height: 40px;
  }


  .sidebar .info {
    max-width: none;
  }


  .sidebar .info h1 {
    font-size: 15px;
  }


  .sidebar .info p {
    font-size: 11px;
  }


  /* Menu button */

  .sidebar .toggle {
    order: 2;

    width: 40px;
    height: 40px;

    margin: 0;
    padding: 0;

    display: grid;
    place-items: center;

    flex-shrink: 0;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    color: var(--color-text-primary);
  }


  /* Closed by default */

  .sidebar .navigation,
  .sidebar .bottom {
    display: none;
  }


  /* Open */

  .sidebar.mobile-open {
    height: 100vh;

    display: flex;
    flex-direction: column;

    padding: var(--space-md);
  }


  .sidebar.mobile-open .navigation {
    display: flex;

    flex-direction: column;

    gap: var(--space-md);

    margin-top: var(--space-xl);
  }


  .sidebar.mobile-open .navigation a {
    display: block;

    padding: var(--space-sm) 0;

    color: var(--color-text-primary);

    font-size: var(--font-size-body-lg);
  }


  .sidebar.mobile-open .bottom {
    display: none;
  }


/* Mobile icon */

.sidebar .arrow-open,
.sidebar .arrow-close {
  display: none;
}


.sidebar .mobile-menu-icon {
  display: block;
}


.sidebar .mobile-close-icon {
  display: none;
}


.sidebar.mobile-open .mobile-menu-icon {
  display: none;
}


.sidebar.mobile-open .mobile-close-icon {
  display: block;
}


  /* Important:
     mobile does not affect desktop layout */

  .sidebar.collapsed {
    width: 100%;
    padding: var(--space-md);

    align-items: initial;
  }


  .sidebar.collapsed .info,
  .sidebar.collapsed .navigation a,
  .sidebar.collapsed .actions a {
    display: block;
  }


  .sidebar.collapsed .profile {
    justify-content: initial;
  }

}

/* Email */

.email-check {
  display: none;
}

.email.copied {
  color: #3A8F6B !important;
}

.email.copied .email-check {
  display: block;
  color: #3A8F6B !important;
}

.email.copied .email-icon {
  display: none;
}

.email.copied span {
  color: #3A8F6B !important;
}

</style>


<script>

const sidebar = document.getElementById("sidebar");
const toggle = document.getElementById("sidebar-toggle");
const layout = document.querySelector(".layout");
const isMobile =
  window.matchMedia("(max-width: 768px)").matches;

// =========================
// Theme
// =========================

const themeToggle = document.getElementById("theme-toggle");
const themeMoon = document.getElementById("theme-moon");
const themeSun = document.getElementById("theme-sun");

const root = document.documentElement;

type Theme = "light" | "dark";

const savedTheme = localStorage.getItem("theme");

const systemTheme: Theme =
  window.matchMedia("(prefers-color-scheme: light)").matches
    ? "light"
    : "dark";

const initialTheme: Theme =
  savedTheme === "light" || savedTheme === "dark"
    ? savedTheme
    : systemTheme;

root.setAttribute("data-theme", initialTheme);


const updateThemeIcon = (theme: Theme) => {

  if (!themeMoon || !themeSun) return;

  if (theme === "light") {

    themeMoon.style.display = "block";
    themeSun.style.display = "none";

  } else {

    themeMoon.style.display = "none";
    themeSun.style.display = "block";

  }

};


updateThemeIcon(initialTheme);


themeToggle?.addEventListener("click", () => {

  const currentTheme: Theme =
    root.getAttribute("data-theme") === "light"
      ? "light"
      : "dark";

  const newTheme: Theme =
    currentTheme === "dark"
      ? "light"
      : "dark";

  root.setAttribute("data-theme", newTheme);

  localStorage.setItem("theme", newTheme);

  updateThemeIcon(newTheme);

});


// =========================
// Sidebar initial state
// =========================

const sidebarHasBeenUsed =
  localStorage.getItem("sidebar-used") === "true";


if (!isMobile && sidebarHasBeenUsed) {

  sidebar?.classList.add("collapsed");

  layout?.classList.add("collapsed");

}


// =========================
// Auto-collapse on scroll
// =========================

toggle?.addEventListener("click", () => {

  if (!sidebar) return;


  // =========================
  // Mobile
  // =========================

  if (isMobile) {

    const isOpen =
      sidebar.classList.toggle("mobile-open");


    toggle.setAttribute(
      "aria-expanded",
      String(isOpen)
    );


    return;

  }


  // =========================
  // Desktop
  // =========================

  const isCollapsed =
    sidebar.classList.toggle("collapsed");


  layout?.classList.toggle(
    "collapsed",
    isCollapsed
  );

});


// =========================
// Auto-collapse on scroll
// =========================

window.addEventListener(
  "scroll",
  () => {

    if (!sidebar) return;


    // Mobile no usa auto-collapse
    if (isMobile) return;


    if (window.scrollY <= 20) return;


    if (!sidebar.classList.contains("collapsed")) {

      sidebar.classList.add("collapsed");

      layout?.classList.add("collapsed");

    }


    localStorage.setItem(
      "sidebar-used",
      "true"
    );

  },
  { passive: true }
);


const workLink = document.querySelector('a[href$="#work"]');


const workLinks = document.querySelectorAll('a[href$="#work"]');

workLinks.forEach((workLink) => {

  workLink.addEventListener("click", (event) => {

    const target = document.getElementById("work");

    // Estamos en Home

    if (target) {

      event.preventDefault();

      const start = window.scrollY;
      const offset = 80;

      const end =
        target.getBoundingClientRect().top +
        window.scrollY -
        offset;

      const distance = end - start;
      const duration = 1100;

      let startTime: number | null = null;

      const easeInOut = (t: number) => {

        return t < 0.5
          ? 2 * t * t
          : 1 - Math.pow(-2 * t + 2, 2) / 2;

      };

      const animateScroll = (currentTime: number) => {

        if (startTime === null) {
          startTime = currentTime;
        }

        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);

        window.scrollTo(
          0,
          start + distance * easeInOut(progress)
        );

        if (progress < 1) {
          requestAnimationFrame(animateScroll);
        }

      };

      requestAnimationFrame(animateScroll);

      return;

    }


    // Estamos en otra página

    event.preventDefault();

    sessionStorage.setItem(
      "scroll-to-work",
      "true"
    );

    const href = workLink.getAttribute("href");

    if (!href) return;

    // Quitamos #work para evitar que el navegador
    // salte directamente a la sección.

    const homeUrl = href.split("#")[0];

    window.location.href = homeUrl || "/";

  });

});



// Si venimos de otra página hacia Work

window.addEventListener("load", () => {

  const shouldScroll =
    sessionStorage.getItem("scroll-to-work");


  if (!shouldScroll) return;


  const target =
    document.getElementById("work");


  if (!target) return;


  sessionStorage.removeItem("scroll-to-work");


  setTimeout(() => {

    const start = window.scrollY;
    const offset = 80;

    const end =
      target.getBoundingClientRect().top +
      window.scrollY -
      offset;

    const distance = end - start;
    const duration = 1100;

    let startTime: number | null = null;


    const easeInOut = (t: number) => {
      return t < 0.5
        ? 2 * t * t
        : 1 - Math.pow(-2 * t + 2, 2) / 2;
    };


    const animateScroll = (currentTime: number) => {

      if (startTime === null) {
        startTime = currentTime;
      }

      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);


      window.scrollTo(
        0,
        start + distance * easeInOut(progress)
      );


      if (progress < 1) {
        requestAnimationFrame(animateScroll);
      }

    };


    requestAnimationFrame(animateScroll);

  }, 100);

});

const emailButton =
  document.getElementById("email-button");

emailButton?.addEventListener("click", async () => {

  try {

    await navigator.clipboard.writeText(
      "katherine.gaspare@gmail.com"
    );

    emailButton.classList.add("copied");

    const emailText =
      emailButton.querySelector("span");

    if (!emailText) return;

    const originalText =
      emailText.textContent;

    emailText.textContent = "Copied";

    setTimeout(() => {

      emailButton.classList.remove("copied");

      emailText.textContent =
        originalText;

    }, 1500);

  } catch (error) {

    console.error(
      "Could not copy email:",
      error
    );

  }

});

</script>