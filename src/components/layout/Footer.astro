---
interface Props {
  content: {
    email: string;
    linkedin: string;
    resume: string;
    credit: string;
  };
}

const { content } = Astro.props;
---


<footer class="footer">

  <div class="footer-content">

    <p class="credit">
      {content.credit}
    </p>


    <div class="actions">

      <button
        class="email"
        id="footer-email-button"
        aria-label={content.email}
      >
        <span>
          {content.email}
        </span>
      </button>


      <a
        href="https://www.linkedin.com/in/katherine-gaspare/"
        target="_blank"
        rel="noopener noreferrer"
        class="linkedin"
        aria-label={content.linkedin}
      >
        <span>
          {content.linkedin}
        </span>
      </a>


      <a
        href={`${import.meta.env.BASE_URL}Katherine-Gaspare-CV.pdf`}
        class="resume"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>
          {content.resume}
        </span>
      </a>

    </div>

  </div>

</footer>


<style>

.footer {

  position: fixed;

  left: 0;
  right: 0;
  bottom: 0;

  height: var(--footer-height);

  display: flex;

  align-items: center;

  padding: 0 40px;

  background: var(--color-chrome);

  border-top: 1px solid var(--color-border);

  z-index: 250;

}


.footer-content {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: var(--space-lg);

  width: 100%;

}


.credit {

  margin: 0;

  color: var(--color-text-muted);

  font-size: 14px;

  white-space: nowrap;

}


.actions {

  display: flex;

  align-items: center;

  gap: 34px;

}


.actions a,
.actions button {

  display: inline-flex;

  align-items: center;

  background: none;

  border: none;

  padding: 0;

  margin: 0;

  color: var(--color-text-muted);

  cursor: pointer;

  font-size: 14px;

  font-family: inherit;

  white-space: nowrap;

}


.actions a:hover,
.actions button:hover {

  color: var(--color-text-primary);

}


/* Email copy state */

.email.copied {
  color: var(--color-success) !important;
}

.email.copied span {
  color: var(--color-success) !important;
}


@media (max-width: 768px) {

  .footer {

    padding: 0 24px;

  }


  .footer-content {

    gap: var(--space-sm);

  }


  .credit {

    font-size: 12px;

  }


  .actions {

    gap: 16px;

  }


  .actions a,
  .actions button {

    font-size: 12px;

  }

}


@media (max-width: 560px) {

  .footer-content {

    justify-content: center;

  }


  .credit {

    display: none;

  }

}

</style>


<script>

const emailButton =
  document.getElementById("footer-email-button");

emailButton?.addEventListener("click", async () => {

  try {

    await navigator.clipboard.writeText(
      "katherine.gaspare@gmail.com"
    );

    emailButton.classList.add("copied");

    const emailText =
      emailButton.querySelector("span");

    if (!emailText) return;

    const originalText =
      emailText.textContent;

    emailText.textContent = "Copied";

    setTimeout(() => {

      emailButton.classList.remove("copied");

      emailText.textContent =
        originalText;

    }, 1500);

  } catch (error) {

    console.error(
      "Could not copy email:",
      error
    );

  }

});

</script>