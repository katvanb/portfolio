---
interface Props {
  content: {
    email: string;
    linkedin: string;
  };
}

const { content } = Astro.props;
---


<footer class="footer">

  <div class="footer-content">

    <p class="credit">
      Designed + Coded by Katherine
    </p>


    <div class="actions">

      <button
        class="email"
        id="footer-email-button"
        aria-label={content.email}
      >
        <span>
          {content.email}
        </span>
      </button>


      <a
        href="https://www.linkedin.com/in/katherine-gaspare/"
        target="_blank"
        rel="noopener noreferrer"
        class="linkedin"
        aria-label={content.linkedin}
      >
        <span>
          {content.linkedin}
        </span>
      </a>


      <a
        href={`${import.meta.env.BASE_URL}Katherine-Gaspare-CV.pdf`}
        class="resume"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>
          Resume
        </span>
      </a>

    </div>

  </div>

</footer>


<style>

.footer {

  margin-top: 160px;

  padding: var(--space-xl) 0 var(--space-lg);

  border-top: 1px solid var(--color-border);

}


.footer-content {

  display: flex;

  justify-content: space-between;

  align-items: center;

  flex-wrap: wrap;

  gap: var(--space-lg);

}


.credit {

  margin: 0;

  color: var(--color-text-secondary);

  font-size: var(--font-size-body);

}


.actions {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: var(--space-lg);

}


.actions a,
.actions button {

  display: inline-flex;

  align-items: center;

  background: none;

  border: none;

  padding: 0;

  margin: 0;

  color: var(--color-text-secondary);

  cursor: pointer;

  font-size: var(--font-size-body);

  font-family: inherit;

  white-space: nowrap;

}


.actions a:hover,
.actions button:hover {

  color: var(--color-text-primary);

}


/* Email copy state */

.email.copied {
  color: #3A8F6B !important;
}

.email.copied span {
  color: #3A8F6B !important;
}


@media (max-width: 768px) {

  .footer-content {

    flex-direction: column;

    align-items: flex-start;

    gap: var(--space-md);

  }


  .actions {

    gap: var(--space-md);

  }

}

</style>


<script>

const emailButton =
  document.getElementById("footer-email-button");

emailButton?.addEventListener("click", async () => {

  try {

    await navigator.clipboard.writeText(
      "katherine.gaspare@gmail.com"
    );

    emailButton.classList.add("copied");

    const emailText =
      emailButton.querySelector("span");

    if (!emailText) return;

    const originalText =
      emailText.textContent;

    emailText.textContent = "Copied";

    setTimeout(() => {

      emailButton.classList.remove("copied");

      emailText.textContent =
        originalText;

    }, 1500);

  } catch (error) {

    console.error(
      "Could not copy email:",
      error
    );

  }

});

</script>